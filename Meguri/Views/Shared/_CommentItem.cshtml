@model (Meguri.Models.Comment Comment, string TargetType, long TargetId, int Depth)
@using System.Security.Claims

@{
	var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
	var isAuthor = Model.Comment.UserId == currentUserId || User.IsInRole("Admin");
	var depthClass = Model.Depth == 1 ? "comment-reply-level-1" : (Model.Depth >= 2 ? "comment-reply-level-2" : "");
}

<div id="comment-@Model.Comment.Id">
	<div>
		<div>
			<div>
				<span>>>@Model.Comment.Number</span>
				@if (Model.Comment.User == null) {
					<text>@SharedLocalizer["Common_UnknownUser"]</text>
				} else {

					<text>@if (!Model.Comment.User.IsProfilePublic && User.Identity?.IsAuthenticated != true) {
						@Model.Comment.User.UserName
					} else {

						<a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.Comment.User.UserName">@Model.Comment.User.UserName</a>
					}
				</text>
			}
			@Model.Comment.CreatedAt.ToLocalTime()
		</div>

		<div class="inline-actions">
			@if (!Model.Comment.IsDeleted && Model.Depth >= 3) {
				<span>@SharedLocalizer["Comment_ReplyLimit"]</span>
			} else if (!Model.Comment.IsDeleted) {
				<button type="button" class="btn-sm" data-reply-comment-id="@Model.Comment.Id" data-reply-comment-number="@Model.Comment.Number" data-reply-user="@(Model.Comment.User?.UserName ?? SharedLocalizer["Common_UnknownUser"].Value)">
					<img src="~/icons/reply.svg" class="icon" />@SharedLocalizer["Comment_ReplyTo", Model.Comment.Number]
				</button>
			}

			@if (isAuthor && !Model.Comment.IsDeleted) {
				<form asp-controller="Comment" asp-action="Delete" asp-route-id="@Model.Comment.Id" method="post" data-confirm="@SharedLocalizer["Common_ConfirmDelete"]">
					@Html.AntiForgeryToken()
					<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
					<button type="submit" class="btn-sm">
						<img src="~/icons/trash.svg" class="icon" />
					</button>
				</form>
			}
		</div>
	</div>

	@if (Model.Comment.IsDeleted) {
		<p>@SharedLocalizer["Comment_DeletedText"]</p>
	} else {
		<div>@Model.Comment.Text</div>

		<!-- 添付画像 -->
		@if (Model.Comment.CommentImages.Any()) {
			<div>
				@foreach (var ci in Model.Comment.CommentImages) {
					<a href="/Image/File/@ci.ImageId" target="_blank">
						<img src="/Image/File/@ci.ImageId" class="comment-attachment-img" alt="@SharedLocalizer["Message_AttachmentAlt"]" />
					</a>
				}
			</div>
		}

		<!-- リアクションバー -->
		<button type="button" class="btn-sm" data-toggle-panel="reaction-buttons-comment-@Model.Comment.Id" aria-expanded="false" aria-controls="reaction-buttons-comment-@Model.Comment.Id">@SharedLocalizer["Reaction_React"]</button>
		<div id="reaction-buttons-comment-@Model.Comment.Id" hidden>
			@await Html.PartialAsync("_ReactionButtons", ("Comment", Model.Comment.Id, Model.Comment.Reactions.AsEnumerable()))
		</div>
	}
</div>
</div>

<!-- 子返信（Replies）の再帰表示 -->
@if (Model.Comment.Replies != null && Model.Comment.Replies.Any()) {
	<div class="comment-replies">
		@foreach (var reply in Model.Comment.Replies.OrderBy(r => r.CreatedAt)) {
			@await Html.PartialAsync("_CommentItem", (reply, Model.TargetType, Model.TargetId, Model.Depth + 1))
		}
	</div>
}
