@model (Meguri.Models.Comment Comment, string TargetType, long TargetId, int Depth)
@using System.Security.Claims

@{
		var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
		var isAuthor = Model.Comment.UserId == currentUserId || User.IsInRole("Admin");
		var depthClass = Model.Depth == 1 ? "comment-reply-level-1" : (Model.Depth >= 2 ? "comment-reply-level-2" : "");
}

<div class="card border-0 bg-white shadow-sm @depthClass" id="comment-@Model.Comment.Id">
		<div class="card-body p-3">
				<div class="d-flex justify-content-between align-items-center mb-1">
						<div>
								<span class="fw-bold text-primary small">>>@Model.Comment.Number</span>
								<span class="fw-semibold small ms-1">👤 @(Model.Comment.User?.UserName ?? "User")</span>
								<span class="text-body-secondary small ms-2">@Model.Comment.Created.ToString("yyyy/MM/dd HH:mm")</span>
						</div>

						<div class="d-flex align-items-center gap-1">
								@if (!Model.Comment.IsDeleted)
								{
										<button type="button" class="btn btn-sm btn-link text-decoration-none py-0 small" onclick="replyToComment(@Model.Comment.Id, @Model.Comment.Number, '@(Model.Comment.User?.UserName ?? "User")')">
												↩️ @SharedLocalizer["Comment_Reply"]
										</button>
								}

								@if (isAuthor && !Model.Comment.IsDeleted)
								{
										<form asp-controller="Comment" asp-action="Delete" asp-route-id="@Model.Comment.Id" method="post" class="d-inline" onsubmit="return confirm('@SharedLocalizer["Common_ConfirmDelete"]');">
												@Html.AntiForgeryToken()
												<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
												<button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none py-0 small">
														🗑️
												</button>
										</form>
								}
						</div>
				</div>

				@if (Model.Comment.IsDeleted)
				{
						<p class="text-body-secondary fst-italic small mb-1">@SharedLocalizer["Comment_DeletedText"]</p>
				}
				else
				{
						<div class="comment-text mb-2" style="white-space: pre-line;">@Model.Comment.Text</div>

						<!-- 添付画像 -->
						@if (Model.Comment.CommentImages.Any())
						{
								<div class="d-flex gap-2 overflow-auto mb-2">
										@foreach (var ci in Model.Comment.CommentImages)
										{
												<a asp-controller="Image" asp-action="Details" asp-route-id="@ci.ImageId">
														<img src="/Image/File/@ci.ImageId" style="max-height: 120px; object-fit: cover;" class="rounded" alt="Attached" />
												</a>
										}
								</div>
						}

						<!-- リアクションバー -->
						@await Html.PartialAsync("_ReactionButtons", ("Comment", Model.Comment.Id, Model.Comment.Reactions.AsEnumerable()))
				}
		</div>
</div>

<!-- 子返信（Replies）の再帰表示 -->
@if (Model.Comment.Replies != null && Model.Comment.Replies.Any())
{
		<div class="d-flex flex-column gap-2 mt-2">
				@foreach (var reply in Model.Comment.Replies.OrderBy(r => r.Created))
				{
						@await Html.PartialAsync("_CommentItem", (reply, Model.TargetType, Model.TargetId, Model.Depth + 1))
				}
		</div>
}
