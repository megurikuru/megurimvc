<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	@if (ViewData["IsHomePage"] as bool? == true) {
		<title>@SharedLocalizer["Head_HomeTitle"]</title>
	} else if (!string.IsNullOrEmpty(ViewData["Title"] as string)) {
		<title>@ViewData["Title"] - meguri</title>
	} else {
		<title>meguri</title>
	}
	<link rel="stylesheet" href="~/css/style.css" />
</head>