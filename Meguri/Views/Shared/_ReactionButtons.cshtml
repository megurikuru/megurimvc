@using Meguri.Extensions
@using Meguri.Models
@using System.Security.Claims

@model (string TargetType, long TargetId, IEnumerable<Reaction> Reactions)

@{
	var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
	var mainTypes = new[] {
				ReactionType.Like,
				ReactionType.Emotional,
				ReactionType.Bravo,
				ReactionType.Insight,
				ReactionType.Impressed,
				ReactionType.Seen,
				ReactionType.Thinking,
				ReactionType.Lol
		};
}

<div class="reaction-list">
	@Html.AntiForgeryToken()
	@foreach (var type in mainTypes) {
		var count = Model.Reactions.Count(r => r.Type == type);
		var hasReacted = currentUserId != null && Model.Reactions.Any(r => r.Type == type && r.UserId == currentUserId);

		<button type="button"
						class="btn-sm @(hasReacted ? "reacted" : "")"
						title="@type.GetDescription()"
						onclick="toggleReaction('@Model.TargetType', @Model.TargetId, @((int)type), this)">
			<span>@type.GetEmoji()</span>
			<span class="reaction-count">@count</span>
		</button>
	}
</div>
