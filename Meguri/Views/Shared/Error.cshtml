@model ErrorViewModel
@{
    ViewData["Title"] = SharedLocalizer["Error_Title"];
}

<h1 >@SharedLocalizer["Error_Heading"]</h1>
<h2 >@SharedLocalizer["Error_SubHeading"]</h2>

@if (Model.ShowRequestId) {
    <p>
        <strong>@SharedLocalizer["Error_RequestIdLabel"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@SharedLocalizer["Error_DevModeHeading"]</h3>
<p>
    @Html.Raw(SharedLocalizer["Error_DevModeP1"].Value)
</p>
<p>
    @Html.Raw(SharedLocalizer["Error_DevModeP2"].Value)
</p>
