@model (List<Meguri.Models.Comment> Comments, string TargetType, long TargetId, bool IsLocked)
@using System.Security.Claims
@using Meguri.Extensions

@{
	var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
	var commentsById = Model.Comments.ToDictionary(c => c.Id);

	// 親コメントの下に返信が続くようスレッド順に整列する
	var childrenMap = Model.Comments
		.Where(c => c.ParentId.HasValue && commentsById.ContainsKey(c.ParentId.Value))
		.GroupBy(c => c.ParentId!.Value)
		.ToDictionary(g => g.Key, g => g.OrderBy(c => c.CreatedAt).ToList());

	var orderedComments = new List<Meguri.Models.Comment>(Model.Comments.Count);
	void AddWithReplies(Meguri.Models.Comment c) {
		orderedComments.Add(c);
		if (childrenMap.TryGetValue(c.Id, out var replies)) {
			foreach (var r in replies) {
				AddWithReplies(r);
			}
		}
	}
	foreach (var root in Model.Comments.Where(c => !c.ParentId.HasValue || !commentsById.ContainsKey(c.ParentId.Value)).OrderBy(c => c.CreatedAt)) {
		AddWithReplies(root);
	}

	string SenderName(Meguri.Models.Comment comment) => comment.User == null
		? SharedLocalizer["Common_UnknownUser"].Value
		: comment.User.UserName + (comment.User.IsWithdrawn ? "(" + SharedLocalizer["Common_WithdrawnUser"].Value + ")" : "");

	string Preview(Meguri.Models.Comment comment) => comment.IsDeleted ? SharedLocalizer["Comment_DeletedText"].Value
		: !string.IsNullOrWhiteSpace(comment.Text) ? new string(comment.Text.Take(80).ToArray())
		: SharedLocalizer["Message_ImageAttachLabel"].Value;

	var commentThreads = new List<List<Meguri.Models.Comment>>();
	foreach (var c in orderedComments) {
		var isRoot = !c.ParentId.HasValue || !commentsById.ContainsKey(c.ParentId.Value);
		if (isRoot || commentThreads.Count == 0) {
			commentThreads.Add(new List<Meguri.Models.Comment>());
		}
		commentThreads[^1].Add(c);
	}
}

<div>
	@if (!Model.IsLocked && User.Identity?.IsAuthenticated == true) {
		<!-- コメント投稿フォーム -->
		<div id="commentForm" class="message-composer">
			@if (TempData["CommentError"] is string commentError && !string.IsNullOrEmpty(commentError)) {
				<div class="validation-summary-errors" role="alert">
					<ul><li>@commentError</li></ul>
				</div>
			}

			<form asp-controller="Comment" asp-action="Create" method="post" enctype="multipart/form-data" autocomplete="off">
				@Html.AntiForgeryToken()
				<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
				<input type="hidden" id="replyParentId" name="parentId" value="" autocomplete="off" />

				@if (Model.TargetType == "Post") {
					<input type="hidden" name="docId" value="@Model.TargetId" />
				} else if (Model.TargetType == "Image") {
					<input type="hidden" name="imageId" value="@Model.TargetId" />
				}

				<div id="replyNotice" class="message-reply-notice" hidden role="status">
					<div><strong id="commentReplyLabel"></strong><span id="commentReplyPreview" class="message-preview-text"></span></div>
					<button type="button" class="btn-sm" data-cancel-reply aria-label="@SharedLocalizer["Message_CancelReply"]" title="@SharedLocalizer["Message_CancelReply"]">×</button>
				</div>

				<div class="attribute-wrap">
					<textarea name="text" id="commentTextInput" rows="3" placeholder="@SharedLocalizer["Comment_WritePlaceholder"]" aria-label="@SharedLocalizer["Comment_WritePlaceholder"]" required></textarea>
				</div>

				@{
					var commentImageUpload = new FileUploadViewModel {
						InputId = "commentImageInput",
						InputName = "commentImage",
						LabelText = SharedLocalizer["Message_ImageAttachLabel"].Value,
						MaxImages = 1,
						ShowCount = true,
						PreviewContainerId = "commentImagePreviewContainer",
						CountDisplayId = "commentImageCountDisplay",
						UseDisclosure = true
					};
				}
				<partial name="_FileUpload" model="commentImageUpload" />

				<div class="button-wrap">
					<button type="submit" class="btn-block">@SharedLocalizer["Comment_Submit"]</button>
				</div>
			</form>
		</div>
	}

	<div id="messageContainer">
		@if (!orderedComments.Any()) {
			<p>@SharedLocalizer["Comment_NoCommentsYet"]</p>
		} else {
			@foreach (var thread in commentThreads) {
				<div class="message-thread">
					@foreach (var comment in thread) {
						var isMine = comment.UserId == currentUserId;
						var isAuthor = isMine || User.IsInRole("Admin");
						var replyParent = comment.ParentId.HasValue ? commentsById.GetValueOrDefault(comment.ParentId.Value) : null;
						var replyLabel = $">>{comment.Number} " + string.Format(SharedLocalizer["Message_ReplyToFormat"].Value, SenderName(comment));

						var depth = 0;
						var parentId = comment.ParentId;
						while (parentId.HasValue && depth < 3) {
							var parent = commentsById.GetValueOrDefault(parentId.Value);
							if (parent == null) { break; }
							depth++;
							parentId = parent.ParentId;
						}
						var indentClass = depth > 0 ? $"message-indent-{depth}" : null;

						<div id="comment-@comment.Id" class="message-item @indentClass @(comment.ParentId.HasValue ? "message-reply" : "message-root")">
							<div class="message-box @(isMine ? "is-mine" : "")">
								<div class="message-header">
									@if (!isMine) {
										<div class="message-sender">
											<span>>>@comment.Number</span>
											@if (comment.User?.ActiveAvatarImageId != null) {
												<img src="/Image/File/@comment.User.ActiveAvatarImageId" class="user-avatar-sm" alt="" />
											} else {
												<img src="~/icons/user.svg" class="icon" alt="" />
											}
											@if (comment.User == null) {
												@SharedLocalizer["Common_UnknownUser"].Value
											} else if (comment.User.IsWithdrawn) {
												@(comment.User.UserName + "(" + SharedLocalizer["Common_WithdrawnUser"].Value + ")")
											} else if (!comment.User.IsProfilePublic && User.Identity?.IsAuthenticated != true) {
												@comment.User.UserName
											} else {
												<a asp-controller="Profile" asp-action="Details" asp-route-id="@comment.User.UserName">@comment.User.UserName</a>
											}
										</div>
									} else {
										<div class="message-sender">
											<span>>>@comment.Number</span>
										</div>
									}
									<time class="local-time message-time" datetime="@comment.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")" data-format="datetime">@comment.CreatedAt.ToString("yyyy/MM/dd HH:mm") UTC</time>
								</div>
								@if (replyParent != null) {
									<a href="#comment-@replyParent.Id" class="message-reply-preview">
										<span class="message-reply-target">>>@replyParent.Number @string.Format(SharedLocalizer["Message_ReplyToFormat"].Value, SenderName(replyParent))</span>
										<span class="message-preview-text">@Preview(replyParent)</span>
									</a>
								}
								@if (comment.IsDeleted) {
									<div><em>@SharedLocalizer["Comment_DeletedText"]</em></div>
								} else {
									@if (!string.IsNullOrEmpty(comment.Text)) {
										<div class="chat-message-body">@comment.Text</div>
									}
									@if (comment.CommentImages.Any()) {
										<div class="message-images">
											@foreach (var ci in comment.CommentImages.OrderBy(x => x.DisplayOrder)) {
												<a href="/Image/File/@ci.ImageId" target="_blank">
													<img src="/Image/File/@ci.ImageId" class="message-image" alt="@SharedLocalizer["Message_AttachmentAlt"]" loading="lazy" />
												</a>
											}
										</div>
									}
								}
								<div class="message-actions">
									@if (!Model.IsLocked && User.Identity?.IsAuthenticated == true && !comment.IsDeleted) {
										if (depth >= 3) {
											<span>@SharedLocalizer["Comment_ReplyLimit"]</span>
										} else {
											<button type="button" class="btn-sm"
													data-reply-comment-id="@comment.Id"
													data-reply-label="@replyLabel"
													data-reply-preview="@Preview(comment)">
												<img src="~/icons/reply.svg" class="icon" alt="" />@SharedLocalizer["Message_ReplyBtn"]
											</button>
										}
									}
									@if (!comment.IsDeleted) {
										<details class="chat-more-actions">
											<summary aria-label="@SharedLocalizer["Message_MoreActions"]" title="@SharedLocalizer["Message_MoreActions"]">…</summary>
											<div class="chat-actions-panel">
												@if (isAuthor) {
													<div class="inline-actions">
														<form asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" method="post" data-confirm="@SharedLocalizer["Common_ConfirmDelete"]">
															@Html.AntiForgeryToken()
															<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
															<button type="submit" class="btn-sm">@SharedLocalizer["Common_Delete"]</button>
														</form>
													</div>
												}
												<div>@SharedLocalizer["Message_ReactionBtn"]</div>
												<partial name="_ReactionButtons" model='("Comment", comment.Id, comment.Reactions.AsEnumerable())' />
											</div>
										</details>
									}
								</div>
							</div>
						</div>
					}
				</div>
			}
		}
	</div>
</div>
