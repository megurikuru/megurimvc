@model (List<Meguri.Models.Comment> Comments, string TargetType, long TargetId)
@using System.Security.Claims

@{
		var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div>
		@if (!Model.Comments.Any()) {
				<p >@SharedLocalizer["Comment_NoCommentsYet"]</p>
		}
		else {
				<div>
						@foreach (var comment in Model.Comments) {
								@await Html.PartialAsync("_CommentItem", (comment, Model.TargetType, Model.TargetId, 0))
						}
				</div>
		}

		<!-- コメント投稿フォーム -->
		<div id="commentForm">
				<h6 ><img src="~/icons/message-circle.svg" class="icon" />@SharedLocalizer["Comment_WriteTitle"]</h6>

				<!-- 返信先インジケーター -->
				<div id="replyNotice" class="inline-actions"></div>

				<form asp-controller="Comment" asp-action="Create" method="post" enctype="multipart/form-data">
						@Html.AntiForgeryToken()
						<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
						<input type="hidden" id="replyParentId" name="parentId" value="" />

						@if (Model.TargetType == "Post") {
								<input type="hidden" name="docId" value="@Model.TargetId" />
						}
						else if (Model.TargetType == "Image") {
								<input type="hidden" name="imageId" value="@Model.TargetId" />
						}

						<div class="attribute-wrap">
								<textarea name="text" id="commentTextInput" rows="3" placeholder="@SharedLocalizer["Comment_WritePlaceholder"]" required></textarea>
						</div>

						<div class="attribute-wrap">
								<input type="file" name="commentImage" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
						</div>

						<div class="button-wrap">
								<button type="submit" class="btn-block">
										@SharedLocalizer["Comment_Submit"]
								</button>
						</div>
				</form>
		</div>
</div>
