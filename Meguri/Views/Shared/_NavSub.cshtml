@model Meguri.ViewModels.Home.HomeIndexViewModel
@using Meguri.Extensions
@{
	ViewData["IsHomePage"] = true;
	var topFandoms = Model?.TopFandoms ?? new List<Meguri.Models.Fandom>();
	var rootFandom = topFandoms.FirstOrDefault(f => f.Id == 1);
}

<!-- サイドバー：界隈（Fandom）一覧 -->
<nav class="nav-sub">
	<h1>@SharedLocalizer["Nav_Fandom"]</h1>
	<partial name="_Finder" model="new FinderViewModel { ChildFandoms = rootFandom?.ChildFandoms.OrderBy(f => f.Id).ToList() ?? [] }" />
</nav>