@using Meguri.Extensions
@{
	ViewData["IsHomePage"] = true;
	var topFandoms = ViewBag.TopFandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
}

<!-- サイドバー：界隈（Fandom）一覧 -->
<nav class="nav-sub">
	<a asp-controller="Fandom" asp-action="Index">最上位界隈</a>
	@foreach (var f in topFandoms) {
		<div class="space-between-wrap">
			<a asp-controller="Fandom" asp-action="Details" asp-route-id="@f.Id">
				<span>@f.Name</span>
			</a>
			@if (f.ChildFandoms.Any()) {
				<small>（@string.Join(", ", f.ChildFandoms.Select(c => c.Name))）</small>
			}
		</div>
	}
</nav>