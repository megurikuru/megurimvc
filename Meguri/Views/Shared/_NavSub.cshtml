@using Meguri.Extensions
@{
	ViewData["IsHomePage"] = true;
	var topFandoms = ViewBag.TopFandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
	var rootFandom = topFandoms.FirstOrDefault(f => f.Id == 1);
}

<!-- サイドバー：界隈（Fandom）一覧 -->
<nav class="nav-sub">
	<h2>界隈</h2>
	<partial name="_Finder" model="new Meguri.ViewModels.FinderViewModel { ChildFandoms = rootFandom?.ChildFandoms ?? [] }" />
</nav>