@model Meguri.ViewModels.Shared.FinderViewModel

<!-- ファインダー：子界隈（フォルダ）＋投稿（ファイル） -->
<div class="finder">
	<!-- 上の階層へ -->
	@if (Model.ParentFandomId.HasValue) {
		<a asp-controller="Fandom" asp-action="Details" asp-route-id="@Model.ParentFandomId" class="finder-item-wrap">
			<img src="~/icons/folder-up.svg" class="icon" />
			<span>..</span>
		</a>
	}
	<!-- フォルダー  -->
	@foreach (var child in Model.ChildFandoms) {
		<a asp-controller="Fandom" asp-action="Details" asp-route-id="@child.Id" class="finder-item-wrap">
			<img src="~/icons/folder.svg" class="icon" />
			<span>@child.Name</span>
		</a>
	}
	<!-- 投稿  -->
	@foreach (var post in Model.Posts) {
		<partial name="_FinderPostItem" model="post" />
	}
</div>
