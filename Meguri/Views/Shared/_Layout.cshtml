<!DOCTYPE html>
@{
	var themeCookie = Context.Request.Cookies["meguri_theme"] ?? "auto";
}
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-bs-theme="@themeCookie">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<script>
			(function() {
					var theme = '@themeCookie';
					if (theme === 'auto') {
							theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					}
					document.documentElement.setAttribute('data-bs-theme', theme);
			})();
	</script>
	@if (ViewData["IsHomePage"] as bool? == true) {
		<title>meguri - 『好き』がめぐるSNS</title>
	} else if (!string.IsNullOrEmpty(ViewData["Title"] as string)) {
		<title>@ViewData["Title"] - meguri</title>
	} else {
		<title>meguri</title>
	}

	<environment include="Development">
		<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
		<link rel="stylesheet" href="~/css/site.css" />
	</environment>
	<environment exclude="Development">
		<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
		<link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
	</environment>
</head>
<body class="bg-body">
	<nav class="navbar navbar-expand-lg bg-body-tertiary shadow-sm site-navbar">
		<div class="container">
			<a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand fw-bold mx-auto ms-lg-0 me-lg-3">meguri</a>
			<div class="site-navbar-collapse" id="mainNavbar">
				<ul class="navbar-nav tile-nav mx-auto mb-2 mb-lg-0">
					@* ホーム *@
					<li class="nav-item">
						<a class="nav-link px-lg-4" asp-area="" asp-controller="Home" asp-action="Index">@SharedLocalizer["Nav_Home"]</a>
					</li>
					@* 界隈一覧 *@
					<li class="nav-item">
						<a class="nav-link px-lg-4" asp-area="" asp-controller="Fandom" asp-action="Index">@SharedLocalizer["Nav_Fandom"]</a>
					</li>
					@* イラスト界隈 *@
					<li class="nav-item">
						<a class="nav-link px-lg-4" asp-area="" asp-controller="Fandom" asp-action="Details" asp-route-id="4">@SharedLocalizer["Nav_Illustrations"]</a>
					</li>
					@* つぶやき *@
					<li class="nav-item">
						<a class="nav-link px-lg-4" asp-area="" asp-controller="Fandom" asp-action="Details" asp-route-id="2">@SharedLocalizer["Nav_Murmurs"]</a>
					</li>
					@* タグ一覧 *@
					<li class="nav-item">
						<a class="nav-link px-lg-4" asp-area="" asp-controller="Tag" asp-action="Index">@SharedLocalizer["Nav_Tags"]</a>
					</li>
					@* メッセージ *@
					<li class="nav-item">
						<a class="nav-link px-lg-4" asp-area="" asp-controller="Message" asp-action="Index">@SharedLocalizer["Nav_Messages"]</a>
					</li>
					@* ログイン *@
					@await Html.PartialAsync("_LoginPartial")
				</ul>
			</div>
		</div>
	</nav>
	<main class="container body-content my-2">
		@RenderBody()
	</main>
	<footer class="footer mt-auto py-3 bg-body-tertiary border-top text-center text-body-secondary">
		<div class="container">
			<p class="mb-0">@SharedLocalizer["Footer_Copyright"]</p>
		</div>
	</footer>

	<environment include="Development">
		<script src="~/lib/jquery/dist/jquery.js"></script>
		<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
		<script src="~/js/site.js" asp-append-version="true"></script>
	</environment>
	<environment exclude="Development">
		<script src="~/lib/jquery/dist/jquery.min.js"></script>
		<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
		<script src="~/js/site.min.js" asp-append-version="true"></script>
	</environment>

	@RenderSection("Scripts", required: false)
</body>
</html>
