<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - meguri</title>

    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
        <link rel="stylesheet" href="~/css/site.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand">meguri</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="@SharedLocalizer["Nav_ToggleNavigation"]">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@SharedLocalizer["Nav_Home"]</a></li>
                    @* <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">@SharedLocalizer["Nav_About"]</a></li> *@
                    @* <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Home" asp-action="Contact">@SharedLocalizer["Nav_Contact"]</a></li> *@
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Community" asp-action="Index">@SharedLocalizer["Nav_Community"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Murmur" asp-action="Index">@SharedLocalizer["Nav_Murmurs"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Illustration" asp-action="Index">@SharedLocalizer["Nav_Illustrations"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Manga" asp-action="Index">@SharedLocalizer["Nav_Manga"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Novels" asp-action="Index">@SharedLocalizer["Nav_Novels"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Cosplay" asp-action="Index">@SharedLocalizer["Nav_Cosplay"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Message" asp-action="Index">@SharedLocalizer["Nav_Messages"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Other" asp-action="Index">@SharedLocalizer["Nav_Others"]</a></li>
                </ul>
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>@SharedLocalizer["Footer_Copyright"]</p>
        </footer>
    </div>

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.min.js" asp-append-version="true"></script>
    </environment>

    @RenderSection("Scripts", required: false)
</body>
</html>
