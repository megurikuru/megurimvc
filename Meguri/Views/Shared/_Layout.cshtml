@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
<!DOCTYPE html>
@{
	var themeCookie = Context.Request.Cookies["meguri_theme"] ?? "auto";
	var isHomePage = string.Equals(ViewContext.RouteData.Values["controller"] as string, "Home", StringComparison.OrdinalIgnoreCase)
		&& string.Equals(ViewContext.RouteData.Values["action"] as string, "Index", StringComparison.OrdinalIgnoreCase);
}
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-bs-theme="@themeCookie">
@await Html.PartialAsync("_Head")
<body data-controller="@ViewContext.RouteData.Values["controller"]" data-action="@ViewContext.RouteData.Values["action"]">
	@await Html.PartialAsync("_Header")
	@if (isHomePage) {
		@await Html.PartialAsync("_NavMain")
	}
	<main>
		<div class="in-develop">現在開発中です。お試しいただけますが、たぶんデータは何度か消します。</div>
		@RenderBody()
	</main>
	@if (isHomePage) {
		@await Html.PartialAsync("_NavSub")
	} else {
		@await Html.PartialAsync("_NavMain")
	}
	@await Html.PartialAsync("_Footer")

	<script>
		window.MeguriI18n = {
			maxTagsAlertFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Js_MaxTagsAlertFormat"].Value)),
			maxImagesAlertFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Js_MaxImagesAlertFormat"].Value)),
			maxImageSizeErrorFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Image_Error_MaxSizeExceeded"].Value)),
			replyNoticeFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Js_ReplyNoticeFormat"].Value)),
			removeLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Common_Remove"].Value)),
			cancelLabel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Common_Cancel"].Value))
		};
	</script>
	<script type="module" src="~/js/meguri.js" asp-append-version="true"></script>
	@RenderSection("Scripts", required: false)
</body>
</html>
