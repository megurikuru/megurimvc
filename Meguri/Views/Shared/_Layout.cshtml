<!DOCTYPE html>
@{
	var themeCookie = Context.Request.Cookies["meguri_theme"] ?? "auto";
	var isManagePage = User.Identity?.IsAuthenticated == true
		&& string.Equals(ViewContext.RouteData.Values["controller"] as string, "Manage", StringComparison.OrdinalIgnoreCase);
}
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-bs-theme="@themeCookie">
@await Html.PartialAsync("_Head")
<body>
	<a asp-area="" asp-controller="Home" asp-action="Index" class="top-link">meguri</a>
	@if (!isManagePage) {
		@await Html.PartialAsync("_NavMain")
	}
	<main>
		@RenderBody()
	</main>
	@await Html.PartialAsync("_NavSub")
	@await Html.PartialAsync("_Footer")

	<environment include="Development">
		<script src="~/lib/jquery/dist/jquery.js"></script>
		<script src="~/js/meguri.js" asp-append-version="true"></script>
	</environment>
	<environment exclude="Development">
		<script src="~/lib/jquery/dist/jquery.min.js"></script>
		<script src="~/js/meguri.min.js" asp-append-version="true"></script>
	</environment>

	@RenderSection("Scripts", required: false)
</body>
</html>
