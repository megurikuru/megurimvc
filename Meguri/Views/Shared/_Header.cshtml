<header>
	<span class="user-icon"></span>
	<span class="top-link">
		<a asp-area="" asp-controller="Home" asp-action="Index">meguri</a>
	</span>	
	<span class="user-name">
			@if (User.Identity?.IsAuthenticated == true)
			{
				<a asp-area="" asp-controller="Profile" asp-action="Details" asp-route-id="@User.Identity.Name" title="@SharedLocalizer["Header_MyPageTitle"]">@User.Identity.Name</a>
			}
		</span>
</header>
