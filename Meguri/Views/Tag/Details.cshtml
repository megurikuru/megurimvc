@model Meguri.Models.TagConcept
@{
		var primaryTag = Model.Tags.FirstOrDefault(t => t.IsCanonical)?.TagText
				?? Model.Tags.FirstOrDefault()?.TagText ?? $"Tag#{Model.Id}";
		ViewData["Title"] = $"#{primaryTag}";
		bool canEdit = ViewBag.CanEdit is true;
		var postTags = ViewBag.PostTags as List<Meguri.Models.PostTag> ?? new List<Meguri.Models.PostTag>();
		var imageTags = ViewBag.ImageTags as List<Meguri.Models.ImageTag> ?? new List<Meguri.Models.ImageTag>();
		var postTagsTotalCount = ViewBag.PostTagsTotalCount as int? ?? 0;
		var imageTagsTotalCount = ViewBag.ImageTagsTotalCount as int? ?? 0;
}

<div class="card shadow-sm border-0 mb-4 bg-body-tertiary">
		<div class="card-body p-4">
				<div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
						<div>
								<h2 class="fw-bold mb-1">🏷️ #@primaryTag</h2>
								<div class="text-body-secondary small">
										@string.Format(SharedLocalizer["Tag_CreatorInfoFormat"].Value, Model.User?.UserName ?? SharedLocalizer["Common_SystemLabel"].Value, postTagsTotalCount, imageTagsTotalCount)
								</div>
						</div>

						<div class="d-flex gap-2">
								<a asp-action="Disambiguation" asp-route-id="@Model.Id" class="btn btn-warning">
										⚖️ @SharedLocalizer["Tag_DisambiguationBtn"]
								</a>
								<a asp-controller="Post" asp-action="Index" asp-route-tag="@primaryTag" class="btn btn-outline-primary">
										@SharedLocalizer["Post_ListTitle"]
								</a>
								<a asp-controller="Image" asp-action="Index" asp-route-tag="@primaryTag" class="btn btn-outline-secondary">
										@SharedLocalizer["Image_ListTitle"]
								</a>
						</div>
				</div>

				<!-- シソーラス情報（上位語・下位語・関連語・同義語） -->
				<div class="row g-3 mt-3 pt-3 border-top">
						<!-- 同義語 -->
						@if (Model.Tags.Count > 1) {
								<div class="col-md-6">
										<h6 class="fw-bold small text-body-secondary">🔄 @SharedLocalizer["Tag_SynonymTerms"]</h6>
										<div class="d-flex flex-wrap gap-1">
												@foreach (var t in Model.Tags.Where(t => t.TagText != primaryTag)) {
														<span class="badge bg-body-secondary border">#@t.TagText</span>
												}
										</div>
								</div>
						}

						<!-- 上位語 -->
						@if (Model.SubjectRelationships.Any(r => r.Predicate == "broader")) {
								<div class="col-md-6">
										<h6 class="fw-bold small text-body-secondary">⬆️ @SharedLocalizer["Tag_BroaderTerms"]</h6>
										<div class="d-flex flex-wrap gap-1">
												@foreach (var r in Model.SubjectRelationships.Where(r => r.Predicate == "broader")) {
														var text = r.ObjectConcept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{r.ObjectConceptId}";
														<a asp-action="Details" asp-route-conceptId="@r.ObjectConceptId" class="badge bg-secondary text-decoration-none">
																#@text
														</a>
												}
										</div>
								</div>
						}

						<!-- 下位語 -->
						@if (Model.ObjectRelationships.Any(r => r.Predicate == "broader")) {
								<div class="col-md-6">
										<h6 class="fw-bold small text-body-secondary">⬇️ @SharedLocalizer["Tag_NarrowerTerms"]</h6>
										<div class="d-flex flex-wrap gap-1">
												@foreach (var r in Model.ObjectRelationships.Where(r => r.Predicate == "broader")) {
														var text = r.SubjectConcept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{r.SubjectConceptId}";
														<a asp-action="Details" asp-route-conceptId="@r.SubjectConceptId" class="badge bg-secondary text-decoration-none">
																#@text
														</a>
												}
										</div>
								</div>
						}

						<!-- 関連語 -->
						@if (Model.SubjectRelationships.Any(r => r.Predicate == "related") || Model.ObjectRelationships.Any(r => r.Predicate == "related")) {
								<div class="col-md-6">
										<h6 class="fw-bold small text-body-secondary">🔗 @SharedLocalizer["Tag_RelatedTerms"]</h6>
										<div class="d-flex flex-wrap gap-1">
												@foreach (var r in Model.SubjectRelationships.Where(r => r.Predicate == "related")) {
														var text = r.ObjectConcept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{r.ObjectConceptId}";
														<a asp-action="Details" asp-route-conceptId="@r.ObjectConceptId" class="badge bg-info text-dark text-decoration-none">
																#@text
														</a>
												}
												@foreach (var r in Model.ObjectRelationships.Where(r => r.Predicate == "related")) {
														var text = r.SubjectConcept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{r.SubjectConceptId}";
														<a asp-action="Details" asp-route-conceptId="@r.SubjectConceptId" class="badge bg-info text-dark text-decoration-none">
																#@text
														</a>
												}
										</div>
								</div>
						}
				</div>
		</div>
</div>

<!-- 投稿 & 画像一覧 -->
<div class="row g-4">
		<div class="col-lg-6">
				<h4 class="fw-bold mb-3">@string.Format(SharedLocalizer["Tag_RelatedPostsTitleFormat"].Value, postTagsTotalCount)</h4>
				@if (!postTags.Any()) {
						<p class="text-body-secondary">@SharedLocalizer["Post_NoPostsFound"]</p>
				}
				else {
						<div class="d-flex flex-column gap-2">
								@foreach (var pt in postTags) {
										<div class="card border-0 shadow-sm p-3">
												<h6 class="fw-bold mb-1">
														<a asp-controller="Post" asp-action="Details" asp-route-id="@pt.PostId" class="text-decoration-none text-body">
																@pt.Post.Name
														</a>
												</h6>
												<small class="text-body-secondary">👤 @(pt.Post.User?.UserName ?? SharedLocalizer["Common_UnknownUser"].Value) | @pt.Post.CreatedAt.ToString("yyyy/MM/dd")</small>
										</div>
								}
						</div>
				}

				@{
					var ptHasPrevious = ViewBag.PostTagsHasPrevious as bool? ?? false;
					var ptHasNext = ViewBag.PostTagsHasNext as bool? ?? false;
					var ptSkip = ViewBag.PostTagsSkip as int? ?? 0;
					var ptPreviousSkip = ViewBag.PostTagsPreviousSkip as int? ?? 0;
					var ptNextSkip = ViewBag.PostTagsNextSkip as int? ?? 0;
				}
				@if (postTagsTotalCount > 0) {
					<nav class="d-flex justify-content-between align-items-center py-2 mt-3 border-top px-1">
						@if (ptHasPrevious) {
							<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-conceptId="@Model.Id" asp-route-postSkip="@ptPreviousSkip">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
						} else {
							<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
						}
						<span class="small text-body-secondary">@(ptSkip + 1) - @(ptSkip + postTags.Count) / @postTagsTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>
						@if (ptHasNext) {
							<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-conceptId="@Model.Id" asp-route-postSkip="@ptNextSkip">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
						} else {
							<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
						}
					</nav>
				}
		</div>

		<div class="col-lg-6">
				<h4 class="fw-bold mb-3">@string.Format(SharedLocalizer["Tag_RelatedImagesTitleFormat"].Value, imageTagsTotalCount)</h4>
				@if (!imageTags.Any()) {
						<p class="text-body-secondary">@SharedLocalizer["Image_NoImagesFound"]</p>
				}
				else {
						<div class="image-grid">
								@foreach (var it in imageTags) {
										<div class="card border-0 shadow-sm image-card">
												<a asp-controller="Image" asp-action="Details" asp-route-id="@it.ImageId">
														<img src="/Image/File/@it.ImageId" alt="@it.Image.Name" />
												</a>
										</div>
								}
						</div>
				}

				@{
					var itHasPrevious = ViewBag.ImageTagsHasPrevious as bool? ?? false;
					var itHasNext = ViewBag.ImageTagsHasNext as bool? ?? false;
					var itSkip = ViewBag.ImageTagsSkip as int? ?? 0;
					var itPreviousSkip = ViewBag.ImageTagsPreviousSkip as int? ?? 0;
					var itNextSkip = ViewBag.ImageTagsNextSkip as int? ?? 0;
				}
				@if (imageTagsTotalCount > 0) {
					<nav class="d-flex justify-content-between align-items-center py-2 mt-3 border-top px-1">
						@if (itHasPrevious) {
							<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-conceptId="@Model.Id" asp-route-imageSkip="@itPreviousSkip">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
						} else {
							<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
						}
						<span class="small text-body-secondary">@(itSkip + 1) - @(itSkip + imageTags.Count) / @imageTagsTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>
						@if (itHasNext) {
							<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-conceptId="@Model.Id" asp-route-imageSkip="@itNextSkip">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
						} else {
							<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
						}
					</nav>
				}

		</div>
</div>
