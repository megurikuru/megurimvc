@model Meguri.ViewModels.Tag.TagDetailsViewModel
@{
	// ページタイトルの設定
	ViewData["Title"] = $"{Model.PrimaryTag}";

	// パンくずリストの構築（タグ一覧 > タグ詳細）
	var breadcrumbs = new List<BreadcrumbItemViewModel> {
		new(SharedLocalizer["Tag_Title"].Value, Url.Action("Index", "Tag")),
		new($"{Model.PrimaryTag}")
	};
}

@* タグ基本情報 & シソーラスエリア *@
<div>
	@* パンくずリスト *@
	<partial name="_Breadcrumb" model="breadcrumbs" />
	@* 代表タグ名見出し *@
	<h1>@Model.PrimaryTag</h1>

	@* ナビゲーション（曖昧さ回避ページへのリンク：編集権限がある場合のみ表示） *@
	@if (Model.CanEdit) {
		<nav class="nav-grid">
			<ul>
				<li>
					<a asp-action="Disambiguation" asp-route-id="@Model.Concept.Id" class="button-like">
						@SharedLocalizer["Tag_DisambiguationBtn"]
					</a>
				</li>
			</ul>
		</nav>
	}

	@* シソーラス情報（上位語・下位語・関連語・同義語） *@
	<div>
		@* 同義語（代表タグ以外の別名タグ一覧） *@
		@if (Model.Concept.Tags.Count > 1) {
			<article>
				<h2>@SharedLocalizer["Tag_SynonymTerms"]</h2>
				<p>
					@foreach (var t in Model.Concept.Tags.Where(t => t.TagText != Model.PrimaryTag)) {
						<span class="icon-wrap">#@t.TagText</span>
					}
				</p>
			</article>
		}

		@* 上位語（このタグがSubjectでPredicate=="broader"のObjectConcept） *@
		@if (Model.Concept.SubjectRelationships.Any(r => r.Predicate == "broader")) {
			<article>
				<h2><img src="~/icons/arrow-up.svg" class="icon" />@SharedLocalizer["Tag_BroaderTerms"]</h2>
				<p>
					@foreach (var r in Model.Concept.SubjectRelationships.Where(r => r.Predicate == "broader")) {
						// 上位概念の代表タグ名を取得（未設定時はConcept IDでフォールバック）
						var text = r.ObjectConcept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{r.ObjectConceptId}";
						<a class="icon-wrap" asp-action="Details" asp-route-conceptId="@r.ObjectConceptId">
							#@text
						</a>
					}
				</p>
			</article>
		}

		@* 下位語（このタグがObjectでPredicate=="broader"のSubjectConcept） *@
		@if (Model.Concept.ObjectRelationships.Any(r => r.Predicate == "broader")) {
			<article>
				<h2><img src="~/icons/arrow-down.svg" class="icon" />@SharedLocalizer["Tag_NarrowerTerms"]</h2>
				<p>
					@foreach (var r in Model.Concept.ObjectRelationships.Where(r => r.Predicate == "broader")) {
						// 下位概念の代表タグ名を取得（未設定時はConcept IDでフォールバック）
						var text = r.SubjectConcept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{r.SubjectConceptId}";
						<a class="icon-wrap" asp-action="Details" asp-route-conceptId="@r.SubjectConceptId">
							#@text
						</a>
					}
				</p>
			</article>
		}

		@* 関連語（双方向のPredicate=="related"の関連概念） *@
		@if (Model.Concept.SubjectRelationships.Any(r => r.Predicate == "related") || Model.Concept.ObjectRelationships.Any(r => r.Predicate == "related")) {
			<article>
				<h2><img src="~/icons/link.svg" class="icon" />@SharedLocalizer["Tag_RelatedTerms"]</h2>
				@* このタグがSubject側の関連概念 *@
				@foreach (var r in Model.Concept.SubjectRelationships.Where(r => r.Predicate == "related")) {
					var text = r.ObjectConcept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{r.ObjectConceptId}";
					<a class="icon-wrap" asp-action="Details" asp-route-conceptId="@r.ObjectConceptId">
						#@text
					</a>
				}
				@* このタグがObject側の関連概念 *@
				@foreach (var r in Model.Concept.ObjectRelationships.Where(r => r.Predicate == "related")) {
					var text = r.SubjectConcept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{r.SubjectConceptId}";
					<a class="icon-wrap" asp-action="Details" asp-route-conceptId="@r.SubjectConceptId">
						#@text
					</a>
				}
			</article>
		}
	</div>
</div>

@* 関連投稿一覧エリア *@
<div id="post-list">
	@* 関連投稿の総件数付き見出し *@
	<h1>@string.Format(SharedLocalizer["Tag_RelatedPostsTitleFormat"].Value, Model.PostTagsTotalCount)</h1>
	@if (!Model.PostTags.Any()) {
		@* 関連投稿が存在しない場合のメッセージ *@
		<p>@SharedLocalizer["Post_NoPostsFound"]</p>
	} else {
		@* 関連投稿リストの描画（タイトル・投稿者・日付のみ表示し、本文・画像は非表示） *@
		@foreach (var pt in Model.PostTags) {
			<partial name="_PostItem" model="new PostItemViewModel {
				Post = pt.Post, 
				BodyMaxLength = 50, 
				MaxImages = 1, 
				ShowFandom = false, 
				ShowStats = false, 
				DateOnly = true 
			}" />
		}
	}
</div>

@* 投稿用ページネーション *@
@if (Model.PostTagsTotalCount > 0) {
	<nav class="pagination">
		@* 前のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (Model.PostTagsHasPrevious) {
			<a asp-action="Details" asp-route-conceptId="@Model.Concept.Id" asp-route-postSkip="@Model.PostTagsPreviousSkip">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, Model.PostTagsPageSize)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, Model.PostTagsPageSize)</button>
		}
		@* 現在の表示範囲と総件数 *@
		<span>@(Model.PostTagsSkip + 1) - @(Model.PostTagsSkip + Model.PostTags.Count) / @Model.PostTagsTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>
		@* 次のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (Model.PostTagsHasNext) {
			<a asp-action="Details" asp-route-conceptId="@Model.Concept.Id" asp-route-postSkip="@Model.PostTagsNextSkip">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, Model.PostTagsPageSize)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, Model.PostTagsPageSize)</button>
		}
	</nav>
}
