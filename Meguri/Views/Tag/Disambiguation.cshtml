@model Meguri.Models.TagViewModels.DisambiguationViewModel
@{
		ViewData["Title"] = string.Format(SharedLocalizer["Tag_DisambiguationTitle"].Value, Model.PrimaryTagText);
}

<div>
		<div>
				<div>
						<div>
								<h4 >⚖️ @string.Format(SharedLocalizer["Tag_DisambiguationTitle"].Value, Model.PrimaryTagText)</h4>
								<a asp-action="Details" asp-route-conceptId="@Model.TagConceptId" >@SharedLocalizer["Common_Back"]</a>
						</div>
						<div>
								@if (!Model.CanEdit) {
										<div>
												@SharedLocalizer["Tag_OnlyOwnerCanEdit"]
										</div>
								}

								<p>
										@string.Format(SharedLocalizer["Tag_DisambiguationIntroFormat"].Value, Model.PrimaryTagText)
								</p>

								<div>
										<!-- 同義語 (Synonyms) -->
										<div>
												<div>
														<h5 >🔄 @SharedLocalizer["Tag_SynonymTerms"]</h5>
														<p >@SharedLocalizer["Tag_SynonymHelp"]</p>

														<div>
																<span >#@Model.PrimaryTagText @SharedLocalizer["Tag_StandardBadge"]</span>
																@foreach (var syn in Model.Synonyms) {
																		<span >#@syn</span>
																}
														</div>

														@if (Model.CanEdit) {
																<form asp-action="AddSynonym" method="post">
																		@Html.AntiForgeryToken()
																		<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
																		<div>
																				<input type="text" name="synonymText"  placeholder="@SharedLocalizer["Tag_SynonymPlaceholder"]" required />
																				<button type="submit" >@SharedLocalizer["Common_Add"]</button>
																		</div>
																</form>
														}
												</div>
										</div>

										<!-- 上位語 (Broader) -->
										<div>
												<div>
														<h5 >⬆️ @SharedLocalizer["Tag_BroaderTerms"]</h5>
														<p >@SharedLocalizer["Tag_BroaderHelp"]</p>

														<div>
																@if (!Model.BroaderConcepts.Any()) {
																		<span >@SharedLocalizer["Common_NotSet"]</span>
																}
																@foreach (var b in Model.BroaderConcepts) {
																		<div>
																				<a asp-action="Details" asp-route-conceptId="@b.ConceptId" >#@b.Text</a>
																				@if (Model.CanEdit) {
																						<form asp-action="RemoveRelationship" method="post">
																								@Html.AntiForgeryToken()
																								<input type="hidden" name="relationshipId" value="@b.RelationshipId" />
																								<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
																								<button type="submit" >✕</button>
																						</form>
																				}
																		</div>
																}
														</div>

														@if (Model.CanEdit) {
																<form asp-action="AddRelationship" method="post">
																		@Html.AntiForgeryToken()
																		<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
																		<input type="hidden" name="predicate" value="broader" />
																		<div>
																				<input type="text" name="targetTagText"  placeholder="@SharedLocalizer["Tag_BroaderPlaceholder"]" required />
																				<button type="submit" >@SharedLocalizer["Common_Add"]</button>
																		</div>
																</form>
														}
												</div>
										</div>

										<!-- 下位語 (Narrower) -->
										<div>
												<div>
														<h5 >⬇️ @SharedLocalizer["Tag_NarrowerTerms"]</h5>
														<p >@SharedLocalizer["Tag_NarrowerHelp"]</p>

														<div>
																@if (!Model.NarrowerConcepts.Any()) {
																		<span >@SharedLocalizer["Common_NotSet"]</span>
																}
																@foreach (var n in Model.NarrowerConcepts) {
																		<div>
																				<a asp-action="Details" asp-route-conceptId="@n.ConceptId" >#@n.Text</a>
																				@if (Model.CanEdit) {
																						<form asp-action="RemoveRelationship" method="post">
																								@Html.AntiForgeryToken()
																								<input type="hidden" name="relationshipId" value="@n.RelationshipId" />
																								<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
																								<button type="submit" >✕</button>
																						</form>
																				}
																		</div>
																}
														</div>

														@if (Model.CanEdit) {
																<form asp-action="AddRelationship" method="post">
																		@Html.AntiForgeryToken()
																		<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
																		<input type="hidden" name="predicate" value="narrower" />
																		<div>
																				<input type="text" name="targetTagText"  placeholder="@SharedLocalizer["Tag_NarrowerPlaceholder"]" required />
																				<button type="submit" >@SharedLocalizer["Common_Add"]</button>
																		</div>
																</form>
														}
												</div>
										</div>

										<!-- 関連語 (Related) -->
										<div>
												<div>
														<h5 >🔗 @SharedLocalizer["Tag_RelatedTerms"]</h5>
														<p >@SharedLocalizer["Tag_RelatedHelp"]</p>

														<div>
																@if (!Model.RelatedConcepts.Any()) {
																		<span >@SharedLocalizer["Common_NotSet"]</span>
																}
																@foreach (var r in Model.RelatedConcepts) {
																		<div>
																				<a asp-action="Details" asp-route-conceptId="@r.ConceptId" >#@r.Text</a>
																				@if (Model.CanEdit) {
																						<form asp-action="RemoveRelationship" method="post">
																								@Html.AntiForgeryToken()
																								<input type="hidden" name="relationshipId" value="@r.RelationshipId" />
																								<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
																								<button type="submit" >✕</button>
																						</form>
																				}
																		</div>
																}
														</div>

														@if (Model.CanEdit) {
																<form asp-action="AddRelationship" method="post">
																		@Html.AntiForgeryToken()
																		<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
																		<input type="hidden" name="predicate" value="related" />
																		<div>
																				<input type="text" name="targetTagText"  placeholder="@SharedLocalizer["Tag_RelatedPlaceholder"]" required />
																				<button type="submit" >@SharedLocalizer["Common_Add"]</button>
																		</div>
																</form>
														}
												</div>
										</div>
								</div>
						</div>
				</div>
		</div>
</div>
