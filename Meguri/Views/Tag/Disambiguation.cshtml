@model Meguri.ViewModels.Tag.DisambiguationViewModel
@{
	// ページタイトルの設定（代表タグ名を含める）
	ViewData["Title"] = string.Format(SharedLocalizer["Tag_DisambiguationTitle"].Value, Model.PrimaryTagText);

	// パンくずリストの構築（タグ一覧 > タグ詳細 > 曖昧さ回避）
	var breadcrumbs = new List<BreadcrumbItemViewModel> {
		new(SharedLocalizer["Tag_Title"].Value, Url.Action("Index", "Tag")),
		new($"{Model.PrimaryTagText}", Url.Action("Details", "Tag", new { conceptId = Model.TagConceptId })),
		new(SharedLocalizer["Tag_DisambiguationBtn"].Value)
	};
}

@* ヘッダーエリア（パンくずリスト・見出し・戻るボタン） *@
<div>
	@* パンくずリスト *@
	<partial name="_Breadcrumb" model="breadcrumbs" />
	@* 曖昧さ回避ページの見出し *@
	<h1>@string.Format(SharedLocalizer["Tag_DisambiguationTitle"].Value, Model.PrimaryTagText)</h1>

	@* ナビゲーション（タグ詳細ページへ戻る） *@
	<nav class="nav-grid">
		<ul>
			<li>
				<a asp-action="Details" asp-route-conceptId="@Model.TagConceptId" class="button-like">
					@SharedLocalizer["Common_Back"]
				</a>
			</li>
		</ul>
	</nav>
</div>

@* 編集権限がない場合（作成者以外）の注意メッセージ *@
@if (!Model.CanEdit) {
	<p>@SharedLocalizer["Tag_OnlyOwnerCanEdit"]</p>
}

@* 曖昧さ回避・シソーラス設定の説明文 *@
<article>
	<p>
		@string.Format(SharedLocalizer["Tag_DisambiguationIntroFormat"].Value, Model.PrimaryTagText)
	</p>
</article>

@* 同義語・別名・表記揺れ (Synonyms) セクション *@
<article>
	<h2>@SharedLocalizer["Tag_SynonymTerms"]</h2>
	<p class="description">@SharedLocalizer["Tag_SynonymHelp"]</p>
	<div>
		@* 登録済みの同義語一覧と削除フォーム *@
		@foreach (var syn in Model.Synonyms) {
			<div class="inline-actions">
				<p>@syn.Text</p>
				@if (Model.CanEdit) {
					<form asp-action="RemoveSynonym" method="post">
						@Html.AntiForgeryToken()
						<input type="hidden" name="tagId" value="@syn.TagId" />
						<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
						<button type="submit" class="btn-sm"><img src="~/icons/x.svg" class="icon" /></button>
					</form>
				}
			</div>
		}

		@* 同義語の追加フォーム（編集権限がある場合のみ表示） *@
		@if (Model.CanEdit) {
			<div>
				<form asp-action="AddSynonym" method="post" class="input-group">
					@Html.AntiForgeryToken()
					<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
					<input type="text" name="synonymText" placeholder="@SharedLocalizer["Tag_SynonymPlaceholder"]" required />
					<button type="submit">@SharedLocalizer["Common_Add"]</button>
				</form>
			</div>
		}
	</div>
</article>

@* 上位語 (Broader) セクション *@
<article>
	<h2>@SharedLocalizer["Tag_BroaderTerms"]</h2>
	<p class="description">@SharedLocalizer["Tag_BroaderHelp"]</p>

	@* 上位語が未設定の場合のメッセージ *@
	@if (!Model.BroaderConcepts.Any()) {
		<span>@SharedLocalizer["Common_NotSet"]</span>
	}
	@* 登録済みの上位語一覧と削除フォーム *@
	@foreach (var b in Model.BroaderConcepts) {
		<div class="inline-actions">
			<a asp-action="Details" asp-route-conceptId="@b.ConceptId">@b.Text</a>
			@if (Model.CanEdit) {
				<form asp-action="RemoveRelationship" method="post">
					@Html.AntiForgeryToken()
					<input type="hidden" name="relationshipId" value="@b.RelationshipId" />
					<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
					<button type="submit" class="btn-sm"><img src="~/icons/x.svg" class="icon" /></button>
				</form>
			}
		</div>
	}

	@* 上位語の追加フォーム（編集権限がある場合のみ表示） *@
	@if (Model.CanEdit) {
		<form asp-action="AddRelationship" method="post" class="input-group">
			@Html.AntiForgeryToken()
			<input type="hidden" name="tagConceptId" value="@Model.TagConceptId" />
			<input type="hidden" name="predicate" value="broader" />
			<input type="text" name="targetTagText" placeholder="@SharedLocalizer["Tag_BroaderPlaceholder"]" required />
			<button type="submit">@SharedLocalizer["Common_Add"]</button>
		</form>
	}
</article>

