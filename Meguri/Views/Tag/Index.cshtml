@model Meguri.ViewModels.Tag.TagIndexViewModel
@{
	// ページタイトルの設定
	ViewData["Title"] = SharedLocalizer["Tag_Title"];
}

<div>
	<h1>@SharedLocalizer["Tag_Title"]</h1>

	@* タグ検索フォームエリア	*@
	@{
		var searchForm = new SearchFormViewModel {
			Controller = "Tag",
			Action = "Index",
			ParameterName = "q",
			Value = Model.SearchQuery,
			PlaceholderKey = "Tag_SearchPlaceholder"
		};
	}
	<partial name="_SearchForm" model="searchForm" />
</div>

@* タグ一覧表示エリア *@
<div class="tag-wrap">
	<div class="tag-list">
		@* タグ概念（TagConcept）一覧のループ表示 *@
		@foreach (var concept in Model.Concepts) {
			// 代表タグ名の取得（存在しない場合はConcept IDでフォールバック）
			var tagText = concept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{concept.Id}";
			// 紐づく投稿数と画像数の合計カウント
			var count = concept.PostTags.Count + concept.ImageTags.Count;
			<a asp-action="Details" asp-route-conceptId="@concept.Id">
				@* タグ詳細ページへのリンク（タグ名・使用件数） *@
				<div class="tag-item">				
					@tagText
					<span>@count</span>
				</div>
			</a>
		}
	</div>
	@* タグが1件も見つからなかった場合のメッセージ *@
	@if (!Model.Concepts.Any()) {
		<p>@SharedLocalizer["Tag_NoTagsFound"]</p>
	}
</div>

@* ページネーションエリア *@
<partial name="_Pagination" model="Model.Pagination" />
