@model IEnumerable<Meguri.Models.TagConcept>
@{
	// ページタイトルと検索クエリの初期設定
	ViewData["Title"] = SharedLocalizer["Tag_Title"];
	var searchQuery = ViewBag.SearchQuery as string;
}

@* ================================================== *@
@* 1. ヘッダーエリア                                   *@
@* ================================================== *@
<div class="tag-page">
	<div>
		<h2>🏷️ @SharedLocalizer["Tag_Title"] & @SharedLocalizer["Tag_Thesaurus"]</h2>
		<p>@SharedLocalizer["Tag_SubTitle"]</p>
	</div>
</div>

@* ================================================== *@
@* 2. タグ検索フォームエリア                           *@
@* ================================================== *@
@{
	var searchForm = new Meguri.Models.SearchFormModel {
		Controller = "Tag",
		Action = "Index",
		ParameterName = "q",
		Value = searchQuery,
		PlaceholderKey = "Tag_SearchPlaceholder"
	};
}
<partial name="_SearchForm" model="searchForm" />

@* ================================================== *@
@* 3. タグ一覧表示エリア                               *@
@* ================================================== *@
<div>
	<div>
		<div>
			@* タグ概念（TagConcept）一覧のループ表示 *@
			@foreach (var concept in Model) {
				// 代表タグ名の取得（存在しない場合はConcept IDでフォールバック）
				var tagText = concept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{concept.Id}";
				// 紐づく投稿数と画像数の合計カウント
				var count = concept.PostTags.Count + concept.ImageTags.Count;
				<div class="tag-item">
					@* タグ詳細ページへのリンク（タグ名・使用件数） *@
					<a asp-action="Details" asp-route-conceptId="@concept.Id">
						@tagText
						<span>@count</span>
					</a>
					@* 曖昧さ回避ページへのリンク *@
					<a asp-action="Disambiguation" asp-route-id="@concept.Id" title="@SharedLocalizer["Tag_DisambiguationBtn"]">
						@SharedLocalizer["Tag_DisambiguationBtn"]
					</a>
				</div>
			}
		</div>
		@* タグが1件も見つからなかった場合のメッセージ *@
		@if (!Model.Any()) {
			<p>@SharedLocalizer["Tag_NoTagsFound"]</p>
		}
	</div>

	@* ================================================== *@
	@* 4. ページネーションエリア                           *@
	@* ================================================== *@
	@{
		// ViewBagからページネーション用パラメータを展開
		var routeValues = new Dictionary<string, string>();
		if (!string.IsNullOrWhiteSpace(searchQuery)) {
			routeValues["q"] = searchQuery;
		}
		var pager = new Meguri.ViewModels.PaginationViewModel {
			Controller = "Tag",
			Action = "Index",
			HasPrevious = ViewBag.HasPrevious as bool? ?? false,
			HasNext = ViewBag.HasNext as bool? ?? false,
			TotalCount = ViewBag.TotalCount as int? ?? 0,
			Skip = ViewBag.Skip as int? ?? 0,
			PreviousSkip = ViewBag.PreviousSkip as int? ?? 0,
			NextSkip = ViewBag.NextSkip as int? ?? 0,
			CurrentCount = Model.Count(),
			RouteValues = routeValues
		};
	}
	<partial name="_Pagination" model="pager" />
</div>
