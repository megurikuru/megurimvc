@model IEnumerable<Meguri.Models.TagConcept>
@{
		ViewData["Title"] = SharedLocalizer["Tag_Title"];
		var searchQuery = ViewBag.SearchQuery as string;
}

<div>
		<div>
				<h2 >🏷️ @SharedLocalizer["Tag_Title"] & @SharedLocalizer["Tag_Thesaurus"]</h2>
				<p >@SharedLocalizer["Tag_SubTitle"]</p>
		</div>
</div>

<div>
		<div>
				<form asp-action="Index" method="get">
						<div>
								<input type="text" name="q" value="@searchQuery"  placeholder="@SharedLocalizer["Tag_SearchPlaceholder"]" />
						</div>
						<div>
								<button type="submit" >@SharedLocalizer["Common_Search"]</button>
						</div>
						@if (!string.IsNullOrWhiteSpace(searchQuery)) {
								<div>
										<a asp-action="Index" >@SharedLocalizer["Common_Clear"]</a>
								</div>
						}
				</form>
		</div>
</div>

<div>
		<div>
				<div>
						@foreach (var concept in Model) {
								var tagText = concept.Tags.FirstOrDefault()?.TagText ?? $"Concept#{concept.Id}";
								var count = concept.PostTags.Count + concept.ImageTags.Count;
								<div>
										<a asp-action="Details" asp-route-conceptId="@concept.Id">
												#@tagText
												<span >@count</span>
										</a>
										<a asp-action="Disambiguation" asp-route-id="@concept.Id"  title="@SharedLocalizer["Tag_DisambiguationBtn"]">
												⚖️
										</a>
								</div>
										}
										</div>
										@if (!Model.Any()) {
												<p >@SharedLocalizer["Tag_NoTagsFound"]</p>
										}
								</div>

								@{
									var tHasPrevious = ViewBag.HasPrevious as bool? ?? false;
							var tHasNext = ViewBag.HasNext as bool? ?? false;
							var tTotalCount = ViewBag.TotalCount as int? ?? 0;
							var tSkip = ViewBag.Skip as int? ?? 0;
							var tPreviousSkip = ViewBag.PreviousSkip as int? ?? 0;
							var tNextSkip = ViewBag.NextSkip as int? ?? 0;
							var tCount = Model.Count();
						}
						<nav>
										@if (tHasPrevious) {
											<a  asp-action="Index" asp-route-skip="@tPreviousSkip" asp-route-q="@searchQuery">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
										} else {
											<button type="button"  disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
										}
										<span >@(tTotalCount == 0 ? SharedLocalizer["Tag_TotalCountZero"].Value : string.Format(SharedLocalizer["Pagination_RangeFormat"].Value, tSkip + 1, tSkip + tCount, tTotalCount))</span>
										@if (tHasNext) {
											<a  asp-action="Index" asp-route-skip="@tNextSkip" asp-route-q="@searchQuery">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
										} else {
											<button type="button"  disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
										}
									</nav>
							</div>
