@model ShowRecoveryCodesViewModel
@{
	ViewData["Title"] = SharedLocalizer["Manage_ShowRecoveryCodes_Title"];
	ViewData.AddActivePage(ManageNavPages.TwoFactorAuthentication);
}

<h2>@ViewData["Title"]</h2>

<div class="account">
	<div role="alert">
		<p>
			<img src="~/icons/triangle-alert.svg" class="icon" />
			<strong>@SharedLocalizer["Manage_ShowRecoveryCodes_Warning"]</strong>
		</p>
		<p>@SharedLocalizer["Manage_ShowRecoveryCodes_Description"]</p>
	</div>
	<div>
		@foreach (var code in Model.RecoveryCodes) {
			<code>@code</code>
		}
	</div>
</div>
