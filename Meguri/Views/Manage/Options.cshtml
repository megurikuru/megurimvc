@model OptionsViewModel
@{
	ViewData["Title"] = SharedLocalizer["Manage_Options_Title"];
	ViewData.AddActivePage(ManageNavPages.Options);
}

<h2>@ViewData["Title"]</h2>
@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)

<article>
	<form method="post" id="optionsForm" class="account">
		<div asp-validation-summary="All"></div>
		<label asp-for="Culture">@SharedLocalizer["Manage_Options_Language"]</label>
		<div class="option-row">
			<input type="radio" asp-for="Culture" id="cultureJa" value="ja">
			<label for="cultureJa">
				@SharedLocalizer["Manage_Options_Language_Ja"]
			</label>
		</div>
		<div class="option-row">
			<input type="radio" asp-for="Culture" id="cultureEn" value="en">
			<label for="cultureEn">
				@SharedLocalizer["Manage_Options_Language_En"]
			</label>
		</div>

		<label>@SharedLocalizer["Manage_Options_ContentDisplay"]</label>
		@if (Model.IsAdult) {
			<div class="option-row">
				<input type="checkbox" asp-for="ShowSexual" id="showSexual">
				<label for="showSexual">
					@SharedLocalizer["Manage_Options_ShowSexual"]
				</label>
			</div>
			<div class="option-row">
				<input type="checkbox" asp-for="ShowViolence" id="showViolence">
				<label for="showViolence">
					@SharedLocalizer["Manage_Options_ShowViolence"]
				</label>
			</div>
		} else {
			<div class="option-row">
				<input type="checkbox" id="showSexual" disabled>
				<label for="showSexual">
					@SharedLocalizer["Manage_Options_ShowSexual"]
				</label>
			</div>
			<div class="option-row">
				<input type="checkbox" id="showViolence" disabled>
				<label for="showViolence">
					@SharedLocalizer["Manage_Options_ShowViolence"]
				</label>
			</div>
			<p class="description">@SharedLocalizer["Manage_Options_UnderageNotice"]</p>
		}

		<button type="submit">@SharedLocalizer["Manage_Options_Save"]</button>
	</form>
</article>

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}
