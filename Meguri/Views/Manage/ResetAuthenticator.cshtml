@{
    ViewData["Title"] = SharedLocalizer["Manage_ResetAuthenticator_Title"];
    ViewData.AddActivePage(ManageNavPages.TwoFactorAuthentication);
}

<h4>@ViewData["Title"]</h4>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="me-2">⚠️</span>
        <strong>@SharedLocalizer["Manage_ResetAuthenticator_Warning"]</strong>
    </p>
    <p>
        @SharedLocalizer["Manage_ResetAuthenticator_Description"]
    </p>
</div>
<div>
    <form asp-action="ResetAuthenticator" method="post">
        <button class="btn btn-danger" type="submit">@SharedLocalizer["Manage_ResetAuthenticator_Button"]</button>
    </form>
</div>
