@{
	ViewData["Title"] = SharedLocalizer["Manage_ResetAuthenticator_Title"];
	ViewData.AddActivePage(ManageNavPages.TwoFactorAuthentication);
}

<h2>@ViewData["Title"]</h2>

<form asp-action="ResetAuthenticator" method="post" class="account">
	<div role="alert">
		<p>
			<span>⚠️</span>
			<strong>@SharedLocalizer["Manage_ResetAuthenticator_Warning"]</strong>
		</p>
		<p>@SharedLocalizer["Manage_ResetAuthenticator_Description"]</p>
	</div>
	<button type="submit">@SharedLocalizer["Manage_ResetAuthenticator_Button"]</button>
</form>
