@{
	ViewData["Title"] = SharedLocalizer["Manage_GenerateRecoveryCodes_Title"];
	ViewData.AddActivePage(ManageNavPages.TwoFactorAuthentication);
}

<h2>@ViewData["Title"]</h2>

<form asp-action="GenerateRecoveryCodes" method="post" class="account">
	<div role="alert">
		<p>
			<span>⚠️</span>
			<strong>@SharedLocalizer["Manage_GenerateRecoveryCodes_Warning"]</strong>
		</p>
		<p>@SharedLocalizer["Manage_GenerateRecoveryCodes_Description"]</p>
		<p>
			@SharedLocalizer["Manage_GenerateRecoveryCodes_DescriptionExtra"]
			<a asp-action="ResetAuthenticatorWarning">@SharedLocalizer["Manage_GenerateRecoveryCodes_ResetLink"]</a>
		</p>
	</div>
	<button type="submit">@SharedLocalizer["Manage_GenerateRecoveryCodes_Button"]</button>
</form>
