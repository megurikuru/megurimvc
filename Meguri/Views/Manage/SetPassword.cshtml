@model SetPasswordViewModel
@{
    ViewData["Title"] = SharedLocalizer["Manage_SetPassword_Title"];
    ViewData.AddActivePage(ManageNavPages.ChangePassword);
}

<h4>@SharedLocalizer["Manage_SetPassword_Title"]</h4>
@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)
<p class="text-info">
    @SharedLocalizer["Manage_SetPassword_Description"]
</p>
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">@SharedLocalizer["Manage_SetPassword_NewPassword"]</label>
                <input asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">@SharedLocalizer["Manage_SetPassword_ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-secondary">@SharedLocalizer["Manage_SetPassword_Button"]</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
