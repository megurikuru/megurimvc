@model SetPasswordViewModel
@{
	ViewData["Title"] = SharedLocalizer["Manage_SetPassword_Title"];
	ViewData.AddActivePage(ManageNavPages.ChangePassword);
}

<article>
	<h1>@ViewData["Title"]</h1>
	@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)
	@if (Model.HasPasskeys) {
		<p>@SharedLocalizer["Manage_SetPassword_PasskeyDisabled"]</p>
	} else {
		<p>@SharedLocalizer["Manage_SetPassword_Description"]</p>

		<form method="post" class="account">
			<div asp-validation-summary="All"></div>
			<div>
				<label asp-for="NewPassword">@SharedLocalizer["Manage_SetPassword_NewPassword"]</label>
				<div class="input-group">
					<input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
					<button type="button" class="password-toggle" data-toggle-password aria-pressed="false" aria-label="@SharedLocalizer["Account_Password_Show"]" title="@SharedLocalizer["Account_Password_Show"]" data-label-show="@SharedLocalizer["Account_Password_Show"]" data-label-hide="@SharedLocalizer["Account_Password_Hide"]" data-icon-show="@Url.Content("~/icons/eye.svg")" data-icon-hide="@Url.Content("~/icons/eye-off.svg")">
						<img src="~/icons/eye.svg" class="icon" alt="" aria-hidden="true" />
					</button>
				</div>
				<span asp-validation-for="NewPassword"></span>
			</div>
			<button type="submit">@SharedLocalizer["Manage_SetPassword_Button"]</button>
		</form>
	}
</article>

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}
