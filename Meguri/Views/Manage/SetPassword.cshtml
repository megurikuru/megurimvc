@model SetPasswordViewModel
@{
    ViewData["Title"] = SharedLocalizer["Manage_SetPassword_Title"];
    ViewData.AddActivePage(ManageNavPages.ChangePassword);
}

<h4>@SharedLocalizer["Manage_SetPassword_Title"]</h4>
@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)
<p>
    @SharedLocalizer["Manage_SetPassword_Description"]
</p>
<div>
    <div>
        <form method="post">
            <div asp-validation-summary="All" ></div>
            <div>
                <label asp-for="NewPassword" >@SharedLocalizer["Manage_SetPassword_NewPassword"]</label>
                <input asp-for="NewPassword"  />
                <span asp-validation-for="NewPassword" ></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" >@SharedLocalizer["Manage_SetPassword_ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword"  />
                <span asp-validation-for="ConfirmPassword" ></span>
            </div>
            <button type="submit" >@SharedLocalizer["Manage_SetPassword_Button"]</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
