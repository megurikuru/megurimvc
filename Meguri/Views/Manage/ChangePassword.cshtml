@model ChangePasswordViewModel
@{
	ViewData["Title"] = SharedLocalizer["Manage_ChangePassword_Title"];
	ViewData.AddActivePage(ManageNavPages.ChangePassword);
}

<h2>@ViewData["Title"]</h2>
@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)

<form method="post" class="account">
	<div asp-validation-summary="All"></div>
	<div>
		<label asp-for="OldPassword">@SharedLocalizer["Account_Field_Password"]</label>
		<input asp-for="OldPassword" />
		<span asp-validation-for="OldPassword"></span>
	</div>
	<div>
		<label asp-for="NewPassword">@SharedLocalizer["Manage_ChangePassword_NewPassword"]</label>
		<input asp-for="NewPassword" />
		<span asp-validation-for="NewPassword"></span>
	</div>
	<div>
		<label asp-for="ConfirmPassword">@SharedLocalizer["Manage_ChangePassword_ConfirmPassword"]</label>
		<input asp-for="ConfirmPassword" />
		<span asp-validation-for="ConfirmPassword"></span>
	</div>
	<button type="submit">@SharedLocalizer["Manage_ChangePassword_UpdateButton"]</button>
</form>

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}
