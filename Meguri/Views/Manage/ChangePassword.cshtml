@model ChangePasswordViewModel
@{
	ViewData["Title"] = SharedLocalizer["Manage_ChangePassword_Title"];
	ViewData.AddActivePage(ManageNavPages.ChangePassword);
}

<h2>@ViewData["Title"]</h2>
@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)

<form method="post" class="account">
	<div asp-validation-summary="All"></div>
	<div>
		<label asp-for="OldPassword">@SharedLocalizer["Account_Field_Password"]</label>
		<div class="input-group">
			<input asp-for="OldPassword" class="form-control" autocomplete="current-password" />
			<button type="button" class="password-toggle" data-toggle-password aria-pressed="false" aria-label="@SharedLocalizer["Account_Password_Show"]" title="@SharedLocalizer["Account_Password_Show"]" data-label-show="@SharedLocalizer["Account_Password_Show"]" data-label-hide="@SharedLocalizer["Account_Password_Hide"]" data-icon-show="@Url.Content("~/icons/eye.svg")" data-icon-hide="@Url.Content("~/icons/eye-off.svg")">
				<img src="~/icons/eye.svg" class="icon" alt="" aria-hidden="true" />
			</button>
		</div>
		<span asp-validation-for="OldPassword"></span>
	</div>
	<div>
		<label asp-for="NewPassword">@SharedLocalizer["Manage_ChangePassword_NewPassword"]</label>
		<div class="input-group">
			<input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
			<button type="button" class="password-toggle" data-toggle-password aria-pressed="false" aria-label="@SharedLocalizer["Account_Password_Show"]" title="@SharedLocalizer["Account_Password_Show"]" data-label-show="@SharedLocalizer["Account_Password_Show"]" data-label-hide="@SharedLocalizer["Account_Password_Hide"]" data-icon-show="@Url.Content("~/icons/eye.svg")" data-icon-hide="@Url.Content("~/icons/eye-off.svg")">
				<img src="~/icons/eye.svg" class="icon" alt="" aria-hidden="true" />
			</button>
		</div>
		<span asp-validation-for="NewPassword"></span>
	</div>
	<button type="submit">@SharedLocalizer["Manage_ChangePassword_UpdateButton"]</button>
</form>

@if (Model.CanRemovePasswordAnd2fa) {
	<form asp-action="RemovePasswordAndTwoFactor" method="post" class="account" data-confirm="@SharedLocalizer["Manage_Passkeys_RemovePasswordAnd2fa_Confirm"]">
		<div>
			<h3>@SharedLocalizer["Manage_Passkeys_RemovePasswordAnd2fa_Title"]</h3>
			<p>@SharedLocalizer["Manage_Passkeys_RemovePasswordAnd2fa_Description"]</p>
		</div>
		<button type="submit">@SharedLocalizer["Manage_Passkeys_RemovePasswordAnd2fa_Button"]</button>
	</form>
}

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}
