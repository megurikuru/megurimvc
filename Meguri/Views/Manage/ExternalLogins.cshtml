@model ExternalLoginsViewModel
@{
    ViewData["Title"] = SharedLocalizer["Manage_ExternalLogins_Title"];
    ViewData.AddActivePage(ManageNavPages.ExternalLogins);
}

@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)
@if (Model.CurrentLogins?.Count > 0) {
    <h4>@SharedLocalizer["Manage_ExternalLogins_Registered"]</h4>
    <table class="table">
        <tbody>
            @foreach (var login in Model.CurrentLogins) {
                <tr>
                    <td>@login.LoginProvider</td>
                    <td>
                        @if (Model.ShowRemoveButton) {
                            <form asp-action="RemoveLogin" method="post">
                                <div>
                                    <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                    <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                    <button type="submit" class="btn btn-secondary" title="@string.Format(SharedLocalizer["Manage_ExternalLogins_RemoveButtonTitle"].Value, login.LoginProvider)">@SharedLocalizer["Manage_ExternalLogins_Remove"]</button>
                                </div>
                            </form>
                        }
                        else {
                            @: &nbsp;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.OtherLogins?.Count > 0) {
    <h4>@SharedLocalizer["Manage_ExternalLogins_AddService"]</h4>
    <hr />
    <form asp-action="LinkLogin" method="post">
        <div id="socialLoginList">
            <p>
                @foreach (var provider in Model.OtherLogins) {
                    <button type="submit" class="btn btn-secondary" name="provider" value="@provider.Name" title="@string.Format(SharedLocalizer["Manage_ExternalLogins_ProviderButtonTitle"].Value, provider.DisplayName)">@provider.DisplayName</button>
                }
            </p>
        </div>
    </form>
}
