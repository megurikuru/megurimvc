@model ExternalLoginsViewModel
@{
	ViewData["Title"] = SharedLocalizer["Manage_ExternalLogins_Title"];
	ViewData.AddActivePage(ManageNavPages.ExternalLogins);
}

<h2>@ViewData["Title"]</h2>
@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)
@if (Model.CurrentLogins?.Count > 0) {
	<h3>@SharedLocalizer["Manage_ExternalLogins_Registered"]</h3>
	@foreach (var login in Model.CurrentLogins) {
		<form asp-action="RemoveLogin" method="post" class="account">
			<div>
				<strong>@login.LoginProvider</strong>
				@if (Model.ShowRemoveButton) {
					<input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
					<input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
					<button type="submit" title="@string.Format(SharedLocalizer["Manage_ExternalLogins_RemoveButtonTitle"].Value, login.LoginProvider)">@SharedLocalizer["Manage_ExternalLogins_Remove"]</button>
				}
			</div>
		</form>
	}
}
@if (Model.OtherLogins?.Count > 0) {
	<h3>@SharedLocalizer["Manage_ExternalLogins_AddService"]</h3>
	<form asp-action="LinkLogin" method="post" class="account">
		@foreach (var provider in Model.OtherLogins) {
			<button type="submit" name="provider" value="@provider.Name" title="@string.Format(SharedLocalizer["Manage_ExternalLogins_ProviderButtonTitle"].Value, provider.DisplayName)">@provider.DisplayName</button>
		}
	</form>
}
