@{
	ViewData["Title"] = SharedLocalizer["Manage_Disable2fa_Title"];
	ViewData.AddActivePage(ManageNavPages.TwoFactorAuthentication);
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Disable2fa" method="post" class="account">
	<div role="alert">
		<p>
			<span>⚠️</span>
			<strong>@SharedLocalizer["Manage_Disable2fa_Warning"]</strong>
		</p>
		<p>
			@SharedLocalizer["Manage_Disable2fa_Description_Part1"]
			<a asp-action="ResetAuthenticatorWarning">@SharedLocalizer["Manage_Disable2fa_ResetLink"]</a>
		</p>
	</div>
	<button type="submit">@SharedLocalizer["Manage_Disable2fa_Button"]</button>
</form>
