@model EnableAuthenticatorViewModel
@{
    ViewData["Title"] = SharedLocalizer["Manage_EnableAuthenticator_Title"];
    ViewData.AddActivePage(ManageNavPages.TwoFactorAuthentication);
}

<h4>@ViewData["Title"]</h4>
<div>
    <p>@SharedLocalizer["Manage_EnableAuthenticator_Intro"]</p>
    <ol class="list-group list-group-numbered">
        <li class="list-group-item">
            <p>
                @SharedLocalizer["Manage_EnableAuthenticator_AppInstruction"]
            </p>
        </li>
        <li class="list-group-item">
            <p>@SharedLocalizer["Manage_EnableAuthenticator_ScanPrompt_Part1"] <kbd>@Model.SharedKey</kbd> @SharedLocalizer["Manage_EnableAuthenticator_ScanPrompt_Part2"]</p>
            @* <div class="alert alert-info">@SharedLocalizer["Manage_EnableAuthenticator_QRHint"] <a href="https://go.microsoft.com/fwlink/?Linkid=852423">@SharedLocalizer["Manage_EnableAuthenticator_Documentation"]</a>.</div> *@
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li class="list-group-item">
            <p>
                @SharedLocalizer["Manage_EnableAuthenticator_ConfirmationPrompt"]
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Code" class="form-label">@SharedLocalizer["Manage_EnableAuthenticator_VerificationCode"]</label>
                            <input asp-for="Code" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-secondary">@SharedLocalizer["Manage_EnableAuthenticator_VerifyButton"]</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <script src="~/lib/qrcodejs/qrcode.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const qrCodeElement = document.getElementById("qrCode");
            const qrCodeDataElement = document.getElementById("qrCodeData");

            if (qrCodeElement && qrCodeDataElement) {
                const url = qrCodeDataElement.dataset.url;
                if (url) {
                    new QRCode(qrCodeElement, {
                        text: url,
                        width: 220,
                        height: 220,
                        colorDark: "#000000",
                        colorLight: "#ffffff",
                        correctLevel: QRCode.CorrectLevel.H
                    });
                }
            }
        });
    </script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

