@model IndexViewModel
@{
	ViewData["Title"] = SharedLocalizer["Manage_Profile_Title"];
	ViewData.AddActivePage(ManageNavPages.Index);
}

<h2>@ViewData["Title"]</h2>
@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)

<form method="post" enctype="multipart/form-data" class="account">
	<div asp-validation-summary="All"></div>
	<div>
		<label asp-for="Username">@SharedLocalizer["Manage_Profile_Username"]</label>
		<input asp-for="Username" />
		<span asp-validation-for="Username"></span>
	</div>
	<div>
		<label asp-for="Email">@SharedLocalizer["Manage_Profile_Email"]</label>
		<div class="input-group">
			<input asp-for="Email" />
			@if (Model.IsEmailConfirmed) {
				<img src="~/icons/check.svg" class="icon" aria-hidden="true" />
			}
		</div>
		@if (!Model.IsEmailConfirmed) {
			<button asp-action="SendVerificationEmail" class="btn-sm">@SharedLocalizer["Manage_Profile_SendVerificationEmail"]</button>
		}
		<span asp-validation-for="Email"></span>
	</div>
	<div>
		<label asp-for="PhoneNumber">@SharedLocalizer["Manage_Profile_PhoneNumber"]</label>
		<input asp-for="PhoneNumber" />
		<span asp-validation-for="PhoneNumber"></span>
	</div>
	<div>
		<label asp-for="DateOfBirth">@SharedLocalizer["Manage_Profile_DateOfBirth"]</label>
		<input asp-for="DateOfBirth" type="date" readonly disabled />
	</div>
	<div>
		<label asp-for="Bio">@SharedLocalizer["Manage_Profile_Bio"]</label>
		<textarea asp-for="Bio" rows="4" placeholder="@SharedLocalizer["Manage_Profile_BioPlaceholder"]"></textarea>
		<span asp-validation-for="Bio"></span>
	</div>
	@{
		var avatarUpload = new FileUploadViewModel {
			InputId = "AvatarFile",
			InputName = "AvatarFile",
			LabelText = SharedLocalizer["Manage_Profile_AvatarLabel"].Value,
			Accept = "image/*",
			MaxImages = 1,
			PreviewContainerId = "avatarPreviewContainer",
			PreviewVariant = "avatar",
			ExistingImageUrl = Model.AvatarImageId.HasValue ? $"/Image/File/{Model.AvatarImageId}" : null,
			RemoveCheckboxId = "RemoveAvatar",
			RemoveCheckboxName = "RemoveAvatar",
			RemoveCheckboxChecked = Model.RemoveAvatar,
			RemoveLabelText = SharedLocalizer["Manage_Profile_RemoveImage"].Value
		};
		var headerUpload = new FileUploadViewModel {
			InputId = "HeaderFile",
			InputName = "HeaderFile",
			LabelText = SharedLocalizer["Manage_Profile_HeaderLabel"].Value,
			Accept = "image/*",
			MaxImages = 1,
			PreviewContainerId = "headerPreviewContainer",
			PreviewVariant = "wide",
			ExistingImageUrl = Model.HeaderImageId.HasValue ? $"/Image/File/{Model.HeaderImageId}" : null,
			RemoveCheckboxId = "RemoveHeader",
			RemoveCheckboxName = "RemoveHeader",
			RemoveCheckboxChecked = Model.RemoveHeader,
			RemoveLabelText = SharedLocalizer["Manage_Profile_RemoveImage"].Value
		};
	}
	<partial name="_FileUpload" model="avatarUpload" />
	<partial name="_FileUpload" model="headerUpload" />
	<div>
		<label>@SharedLocalizer["Manage_Profile_ExternalUrlsLabel"]</label>
		@for (var i = 0; i < 5; i++) {
			<input type="url" name="ExternalUrls[@i]" value="@Model.ExternalUrls[i]" maxlength="500" placeholder="https://" />
		}
		<span asp-validation-for="ExternalUrls"></span>
	</div>
	<div>
		<label class="check-row"><input type="checkbox" asp-for="IsProfilePublic" /> @SharedLocalizer["Manage_Profile_IsProfilePublicLabel"]</label>
	</div>
	<button type="submit">@SharedLocalizer["Manage_Profile_Save"]</button>
</form>

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}
