@model IndexViewModel
@{
    ViewData["Title"] = SharedLocalizer["Manage_Profile_Title"];
    ViewData.AddActivePage(ManageNavPages.Index);
}

<h4>@ViewData["Title"]</h4>
@await Html.PartialAsync("_StatusMessage", Model.StatusMessage)
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label">@SharedLocalizer["Manage_Profile_Username"]</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">@SharedLocalizer["Manage_Profile_Email"]</label>
                @if (Model.IsEmailConfirmed) {
                    <div class="input-group">
                        <input asp-for="Email" class="form-control" />
                        <span class="input-group-text text-success" aria-hidden="true">✓</span>
                    </div>
                }
                else {
                    <input asp-for="Email" class="form-control" />
                    <button asp-action="SendVerificationEmail" class="btn btn-link">@SharedLocalizer["Manage_Profile_SendVerificationEmail"]</button>
                }
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">@SharedLocalizer["Manage_Profile_PhoneNumber"]</label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DateOfBirth" class="form-label">@SharedLocalizer["Manage_Profile_DateOfBirth"]</label>
                <input asp-for="DateOfBirth" class="form-control" type="date" readonly disabled />
            </div>
            <div class="mb-3">
                <label asp-for="Bio" class="form-label">@SharedLocalizer["Manage_Profile_Bio"]</label>
                <textarea asp-for="Bio" class="form-control" rows="4" placeholder="@SharedLocalizer["Manage_Profile_BioPlaceholder"]"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-secondary">@SharedLocalizer["Manage_Profile_Save"]</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
