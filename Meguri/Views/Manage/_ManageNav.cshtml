@using Meguri
@using Meguri.Models
@using Meguri.Models.AccountViewModels
@using Meguri.Models.ManageViewModels
@using Meguri.Views.Manage
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<ul class="nav nav-pills flex-column">
    <li class="nav-item @ManageNavPages.IndexNavClass(ViewContext)"><a class="nav-link" asp-action="Index">@SharedLocalizer["Manage_Nav_Profile"]</a></li>
    <li class="nav-item @ManageNavPages.ChangePasswordNavClass(ViewContext)"><a class="nav-link" asp-action="ChangePassword">@SharedLocalizer["Manage_Nav_Password"]</a></li>
    @if (hasExternalLogins) {
        <li class="nav-item @ManageNavPages.ExternalLoginsNavClass(ViewContext)"><a class="nav-link" asp-action="ExternalLogins">@SharedLocalizer["Manage_Nav_ExternalLogins"]</a></li>
    }
    <li class="nav-item @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)"><a class="nav-link" asp-action="TwoFactorAuthentication">@SharedLocalizer["Manage_Nav_TwoFactorAuthentication"]</a></li>
    <li class="nav-item @ManageNavPages.OptionsNavClass(ViewContext)"><a class="nav-link" asp-action="Options">@SharedLocalizer["Manage_Nav_Options"]</a></li>
</ul>

