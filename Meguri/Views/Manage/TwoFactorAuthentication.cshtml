@model TwoFactorAuthenticationViewModel
@{
    ViewData["Title"] = SharedLocalizer["Manage_TwoFactorAuthentication_Title"];
    ViewData.AddActivePage(ManageNavPages.TwoFactorAuthentication);
}

<h4>@ViewData["Title"]</h4>
@if (Model.Is2faEnabled) {
    if (Model.RecoveryCodesLeft == 0) {
        <div class="alert alert-danger">
            <strong>@SharedLocalizer["Manage_TwoFactorAuthentication_NoCodes"]</strong>
            <p>@SharedLocalizer["Manage_TwoFactorAuthentication_NoCodes_Message"]</p>
        </div>
    }
    else if (Model.RecoveryCodesLeft == 1) {
        <div class="alert alert-danger">
            <strong>@SharedLocalizer["Manage_TwoFactorAuthentication_OneCodeLeft"]</strong>
            <p>@SharedLocalizer["Manage_TwoFactorAuthentication_OneCodeLeft_Message"]</p>
        </div>
    }
    else if (Model.RecoveryCodesLeft <= 3) {
        <div class="alert alert-warning">
            <strong>@string.Format(SharedLocalizer["Manage_TwoFactorAuthentication_CodesLeft"].Value, Model.RecoveryCodesLeft)</strong>
            <p>@SharedLocalizer["Manage_TwoFactorAuthentication_CodesLeft_Message"]</p>
        </div>
    }

    <a asp-action="Disable2faWarning" class="btn btn-secondary">@SharedLocalizer["Manage_TwoFactorAuthentication_Disable2FA"]</a>
    <a asp-action="GenerateRecoveryCodesWarning" class="btn btn-secondary">@SharedLocalizer["Manage_TwoFactorAuthentication_ResetRecoveryCodes"]</a>
}

<h5>@SharedLocalizer["Manage_TwoFactorAuthentication_AuthenticatorApp"]</h5>
@if (!Model.HasAuthenticator) {
    <a asp-action="EnableAuthenticator" class="btn btn-secondary">@SharedLocalizer["Manage_TwoFactorAuthentication_AddAuthenticator"]</a>
}
else {
    <a asp-action="EnableAuthenticator" class="btn btn-secondary">@SharedLocalizer["Manage_TwoFactorAuthentication_ConfigureAuthenticator"]</a>
    <a asp-action="ResetAuthenticatorWarning" class="btn btn-secondary">@SharedLocalizer["Manage_TwoFactorAuthentication_ResetAuthenticatorKey"]</a>
}

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
