@model WithdrawViewModel
@{
	ViewData["Title"] = SharedLocalizer["Manage_Withdraw_Title"];
	ViewData.AddActivePage(ManageNavPages.Withdraw);
}

<h2>@ViewData["Title"]</h2>

<p>@SharedLocalizer["Manage_Withdraw_Description"]</p>

<form method="post" class="account" onsubmit="return confirm('@SharedLocalizer["Manage_Withdraw_Confirm"]');">
	<div asp-validation-summary="All"></div>
	@if (Model.HasPassword) {
		<div>
			<label asp-for="Password">@SharedLocalizer["Account_Field_Password"]</label>
			<input asp-for="Password" autocomplete="current-password" />
			<span asp-validation-for="Password"></span>
		</div>
	}
	<button type="submit">@SharedLocalizer["Manage_Withdraw_Button"]</button>
</form>

@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")
}
