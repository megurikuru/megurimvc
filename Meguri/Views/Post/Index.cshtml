@model IEnumerable<Meguri.Models.Post>
@{
		ViewData["Title"] = SharedLocalizer["Post_Title"];
		var currentFandom = ViewBag.CurrentFandom as Meguri.Models.Fandom;
		var currentTag = ViewBag.CurrentTag as string;
		var currentSearch = ViewBag.CurrentSearch as string;
		var fandoms = ViewBag.Fandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
}

<div>
		<div>
				<h2 >📝 @SharedLocalizer["Post_Title"]</h2>
				<p >@SharedLocalizer["Post_SubTitle"]</p>
		</div>
		<a asp-action="Create" asp-route-fandomId="@currentFandom?.Id">
				✏️ @SharedLocalizer["Post_CreateNew"]
		</a>
</div>


<div>
		<div>
				<form asp-action="Index" method="get">
						<div>
								<select name="fandomId"  onchange="this.form.submit()">
										<option value="">@SharedLocalizer["Fandom_AllOption"]</option>
										@foreach (var f in fandoms) {
												<!option value="@f.Id" @(currentFandom?.Id == f.Id ? "selected" : "")>@f.Name</!option>
										}
								</select>
						</div>
						<div>
								<input type="text" name="search" value="@currentSearch"  placeholder="@SharedLocalizer["Post_SearchPlaceholder"]" />
						</div>
						<div>
								<button type="submit" >@SharedLocalizer["Common_Search"]</button>
						</div>
				</form>
		</div>
</div>

@if (!string.IsNullOrEmpty(currentTag)) {
		<div>
				<span>@Html.Raw(string.Format(SharedLocalizer["Post_ShowingTagFormat"].Value, $"<strong>#{currentTag}</strong>"))</span>
				<a asp-action="Index" >@SharedLocalizer["Common_All"]</a>
		</div>
}

@if (!Model.Any()) {
		<div>
				<h4>@SharedLocalizer["Common_NoItems"]</h4>
				<div>
						<a asp-action="Create" >@SharedLocalizer["Post_CreateNew"]</a>
				</div>
		</div>
}
else {
		<div>
				@foreach (var post in Model) {
						<div>
								<div>
										<div>
												<div>
														<a asp-controller="Fandom" asp-action="Details" asp-route-id="@post.FandomId">
																@(post.Fandom?.Name ?? SharedLocalizer["Fandom_DefaultLabel"].Value)
														</a>
														@if (post.IsPinned) {
																<span >@SharedLocalizer["Post_PinnedBadge"]</span>
														}
														@if (post.IsSexual) {
																<span >R-18</span>
														}
														@if (post.IsViolence) {
																<span >R-18G</span>
														}
												</div>
												<small >@post.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
										</div>

										<h4>
												<a asp-action="Details" asp-route-id="@post.Id">
														@post.Name
												</a>
										</h4>

										<p>
												@(post.Text.Length > 150 ? post.Text.Substring(0, 150) + "..." : post.Text)
										</p>

										<!-- 添付画像（順序付き）プレビュー -->
										@if (post.PostImages.Any()) {
												<div>
														@foreach (var pi in post.PostImages.OrderBy(x => x.DisplayOrder)) {
																<a asp-controller="Image" asp-action="Details" asp-route-id="@pi.ImageId">
																		<img src="/Image/File/@pi.ImageId"  style="width: 100px; height: 100px; object-fit: cover;" alt="@pi.Image.Name" />
																</a>
														}
												</div>
										}

										<!-- タグ -->
										@if (post.PostTags.Any()) {
												<div>
														@foreach (var pt in post.PostTags) {
																var tagText = pt.TagConcept?.Tags?.FirstOrDefault()?.TagText;
																if (!string.IsNullOrEmpty(tagText)) {
																		<a asp-controller="Tag" asp-action="Details" asp-route-conceptId="@pt.TagConceptId" >#@tagText</a>
																}
														}
												</div>
										}

										<div>
												<div>
														<span>👤 @(post.User?.UserName ?? SharedLocalizer["Common_UnknownUser"].Value)</span>
												</div>
												<div>
														@string.Format(SharedLocalizer["Post_CommentCountSuffix"].Value, post.CommentCount)
														@string.Format(SharedLocalizer["Post_ViewCountSuffix"].Value, post.ViewCount)
														@string.Format(SharedLocalizer["Post_ReactionCountSuffix"].Value, post.Reactions.Count)
												</div>
										</div>
								</div>
										</div>
								}
						</div>
						}

						@{
							var postHasPrevious = ViewBag.HasPrevious as bool? ?? false;
							var postHasNext = ViewBag.HasNext as bool? ?? false;
							var postTotalCount = ViewBag.TotalCount as int? ?? 0;
							var postSkip = ViewBag.Skip as int? ?? 0;
							var postPreviousSkip = ViewBag.PreviousSkip as int? ?? 0;
							var postNextSkip = ViewBag.NextSkip as int? ?? 0;
							var postCount = Model.Count();
						}
						@if (postTotalCount > 0) {
							<nav>
								@if (postHasPrevious) {
									<a  asp-action="Index" asp-route-skip="@postPreviousSkip" asp-route-fandomId="@currentFandom?.Id" asp-route-tag="@currentTag" asp-route-search="@currentSearch">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
								} else {
									<button type="button"  disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
								}
								<span >@(postSkip + 1) - @(postSkip + postCount) / @postTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>
								@if (postHasNext) {
									<a  asp-action="Index" asp-route-skip="@postNextSkip" asp-route-fandomId="@currentFandom?.Id" asp-route-tag="@currentTag" asp-route-search="@currentSearch">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
								} else {
									<button type="button"  disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
								}
							</nav>
						}
