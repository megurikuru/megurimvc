@model IEnumerable<Meguri.Models.Post>
@{
		ViewData["Title"] = SharedLocalizer["Post_Title"];
		var currentFandom = ViewBag.CurrentFandom as Meguri.Models.Fandom;
		var currentTag = ViewBag.CurrentTag as string;
		var currentSearch = ViewBag.CurrentSearch as string;
		var fandoms = ViewBag.Fandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
		var postRouteValues = new Dictionary<string, string>();
		if (currentFandom != null) {
			postRouteValues["fandomId"] = currentFandom.Id.ToString();
		}
		if (!string.IsNullOrEmpty(currentTag)) {
			postRouteValues["tag"] = currentTag;
		}
		if (!string.IsNullOrEmpty(currentSearch)) {
			postRouteValues["search"] = currentSearch;
		}
		var pager = new PaginationViewModel {
			Controller = "Post",
			Action = "Index",
			HasPrevious = ViewBag.HasPrevious as bool? ?? false,
			HasNext = ViewBag.HasNext as bool? ?? false,
			TotalCount = ViewBag.TotalCount as int? ?? 0,
			Skip = ViewBag.Skip as int? ?? 0,
			PreviousSkip = ViewBag.PreviousSkip as int? ?? 0,
			NextSkip = ViewBag.NextSkip as int? ?? 0,
			CurrentCount = Model.Count(),
			RouteValues = postRouteValues
		};
}

<div>
		<div>
				<h2 ><img src="~/icons/file-text.svg" class="icon" />@SharedLocalizer["Post_Title"]</h2>
				<p >@SharedLocalizer["Post_SubTitle"]</p>
		</div>
		@if (ViewBag.CanPostToCurrentFandom is true) {
		<div class="button-wrap">
			<a asp-action="Create" asp-route-fandomId="@currentFandom?.Id" class="button-like icon-wrap">
					<img src="~/icons/square-pen.svg" class="icon" />@SharedLocalizer["Post_CreateNew"]
			</a>
		</div>
		}
</div>


<div>
		<div>
				<form asp-action="Index" method="get" class="attribute-wrap">
						<div>
								<select name="fandomId" onchange="this.form.submit()">
										<option value="">@SharedLocalizer["Fandom_AllOption"]</option>
										@foreach (var f in fandoms) {
												<!option value="@f.Id" @(currentFandom?.Id == f.Id ? "selected" : "")>@f.Name</!option>
										}
								</select>
						</div>
						<div class="input-group">
								<input type="text" name="search" value="@currentSearch" placeholder="@SharedLocalizer["Post_SearchPlaceholder"]" />
								<button type="submit">@SharedLocalizer["Common_Search"]</button>
						</div>
				</form>
		</div>
</div>

@if (!string.IsNullOrEmpty(currentTag)) {
		<div class="inline-actions">
				<span>@Html.Raw(string.Format(SharedLocalizer["Post_ShowingTagFormat"].Value, $"<strong>#{currentTag}</strong>"))</span>
				<a asp-action="Index" class="button-like btn-sm">@SharedLocalizer["Common_All"]</a>
		</div>
}

@if (!Model.Any()) {
		<div>
				<h4>@SharedLocalizer["Common_NoItems"]</h4>
				@if (ViewBag.CanPostToCurrentFandom is true) {
				<div class="button-wrap">
						<a asp-action="Create" class="button-like">@SharedLocalizer["Post_CreateNew"]</a>
				</div>
				}
		</div>
}
else {
		<div>
				@foreach (var post in Model) {
						<div>
								<div>
										<div>
												<div>
														<a asp-controller="Fandom" asp-action="Details" asp-route-id="@post.FandomId">
																@(post.Fandom?.Name ?? SharedLocalizer["Fandom_DefaultLabel"].Value)
														</a>
														@if (post.IsPinned) {
																<span ><img src="~/icons/pin.svg" class="icon" />@SharedLocalizer["Post_PinnedBadge"]</span>
														}
														@if (post.IsSexual) {
																<span >R-18</span>
														}
														@if (post.IsViolence) {
																<span >R-18G</span>
														}
												</div>
												@post.CreatedAt.ToLocalTime()
										</div>

										<h4>
												<a asp-action="Details" asp-route-id="@post.Id">
														@post.Subject
												</a>
										</h4>

										<p>
												@(post.Body.Length > 150 ? post.Body.Substring(0, 150) + "..." : post.Body)
										</p>

										<!-- 添付画像（順序付き）プレビュー -->
										@if (post.PostImages.Any()) {
												<div>
														@foreach (var pi in post.PostImages.OrderBy(x => x.DisplayOrder)) {
																<a href="/Image/File/@pi.ImageId" target="_blank">
																		<img src="/Image/File/@pi.ImageId" class="post-thumb-img" alt="@pi.Image.Name" />
																</a>
														}
												</div>
										}

										<!-- タグ -->
										@if (post.PostTags.Any()) {
												<div>
														@foreach (var pt in post.PostTags) {
																var tagText = pt.TagConcept?.Tags?.FirstOrDefault()?.TagText;
																if (!string.IsNullOrEmpty(tagText)) {
																		<a asp-controller="Tag" asp-action="Details" asp-route-conceptId="@pt.TagConceptId" >#@tagText</a>
																}
														}
												</div>
										}

										<div>
												<div>
														@if (post.User == null) {
															@SharedLocalizer["Common_UnknownUser"].Value
														} else if (post.User.IsWithdrawn) {
															@SharedLocalizer["Common_WithdrawnUser"].Value
														} else {
															<text>@if (!post.User.IsProfilePublic && User.Identity?.IsAuthenticated != true) { @post.User.UserName } else { <a asp-controller="Profile" asp-action="Details" asp-route-id="@post.User.UserName">@post.User.UserName</a> }</text>
														}
												</div>
												<div>
														<img src="~/icons/message-circle.svg" class="icon" />@string.Format(SharedLocalizer["Post_CommentCountSuffix"].Value, post.CommentCount)
														<img src="~/icons/eye.svg" class="icon" />@string.Format(SharedLocalizer["Post_ViewCountSuffix"].Value, post.ViewCount)
														<img src="~/icons/heart.svg" class="icon" />@string.Format(SharedLocalizer["Post_ReactionCountSuffix"].Value, post.Reactions.Count)
												</div>
										</div>
								</div>
										</div>
								}
						</div>
						}

						<partial name="_Pagination" model="pager" />
