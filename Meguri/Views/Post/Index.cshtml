@model Meguri.ViewModels.Post.PostIndexViewModel
@{
	ViewData["Title"] = SharedLocalizer["Post_Title"];
}

<div>
	<div>
		<h2><img src="~/icons/file-text.svg" class="icon" />@SharedLocalizer["Post_Title"]</h2>
		<p>@SharedLocalizer["Post_SubTitle"]</p>
	</div>
	@if (Model.CanPostToCurrentFandom) {
		<div class="button-wrap">
			<a asp-action="Create" asp-route-fandomId="@Model.CurrentFandom?.Id" class="button-like icon-wrap">
				<img src="~/icons/square-pen.svg" class="icon" />@SharedLocalizer["Post_CreateNew"]
			</a>
		</div>
	}
</div>


<div>
	<div>
		<form asp-action="Index" method="get" class="attribute-wrap">
			<div>
				<select name="fandomId" data-auto-submit>
					<option value="">@SharedLocalizer["Fandom_AllOption"]</option>
					@foreach (var f in Model.Fandoms) {
						<!option value="@f.Id" @(Model.CurrentFandom?.Id == f.Id ? "selected" : "")>@f.Name</!option>
					}
				</select>
			</div>
			<div class="input-group">
				<input type="text" name="search" value="@Model.CurrentSearch" placeholder="@SharedLocalizer["Post_SearchPlaceholder"]" />
				<button type="submit">@SharedLocalizer["Common_Search"]</button>
			</div>
		</form>
	</div>
</div>

@if (!string.IsNullOrEmpty(Model.CurrentTag)) {
	<div class="inline-actions">
		<span>@Html.Raw(string.Format(SharedLocalizer["Post_ShowingTagFormat"].Value, $"<strong>#{Model.CurrentTag}</strong>"))</span>
		<a asp-action="Index" class="button-like btn-sm">@SharedLocalizer["Common_All"]</a>
	</div>
}

@if (!Model.Posts.Any()) {
	<div>
		<h4>@SharedLocalizer["Common_NoItems"]</h4>
		@if (Model.CanPostToCurrentFandom) {
			<div class="button-wrap">
				<a asp-action="Create" class="button-like">@SharedLocalizer["Post_CreateNew"]</a>
			</div>
		}
	</div>
} else {
	<div id="post-list">
		@foreach (var post in Model.Posts) {
			<partial name="_PostItem" model="new PostItemViewModel {
				Post = post,
				BodyMaxLength = 150,
				MaxImages = 16,
				LinkImagesToFile = true,
				ShowBadges = true,
				ShowTags = true
			}" />
		}
	</div>
}

<partial name="_Pagination" model="Model.Pagination" />
