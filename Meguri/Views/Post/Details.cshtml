@model Meguri.ViewModels.Post.PostDetailsViewModel

@{
	if (User.Identity?.IsAuthenticated != true && (!Model.Post.IsPublic || Model.Post.IsSexual || Model.Post.IsViolence)) {
		return;
	}
	ViewData["Title"] = Model.DisplayTitle;
	var breadcrumbs = new List<BreadcrumbItemViewModel>();
	foreach (var ancestor in Model.Ancestors) {
		breadcrumbs.Add(new(ancestor.Name, Url.Action("Details", "Fandom", new { id = ancestor.Id })));
	}
	breadcrumbs.Add(new(Model.Post.Fandom?.Name ?? SharedLocalizer["Fandom_DefaultLabel"].Value, Url.Action("Details", "Fandom", new { id = Model.Post.FandomId })));
	breadcrumbs.Add(new(Model.DisplayTitle));
}

<!-- パンくず -->
<partial name="_Breadcrumb" model="breadcrumbs" />

<!-- 本文 -->
<partial name="_Body" model="Model" />

<!-- スレッド式コメント一覧 & 投稿フォーム -->
<partial name="_Comment" model="Model" />
