@model Meguri.Models.Post
@using System.Security.Claims

@{
		ViewData["Title"] = Model.Name;
		var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
		var isAuthor = Model.UserId == currentUserId || User.IsInRole("Admin");
}

<div>
		<div>
				<div>
					<div>
						<!-- パンくず -->
						<nav aria-label="breadcrumb">
							<ol>
								<li ><a asp-controller="Fandom" asp-action="Index">@SharedLocalizer["Fandom_Title"]</a></li>
								<li ><a asp-controller="Fandom" asp-action="Details" asp-route-id="@Model.FandomId">@(Model.Fandom?.Name ?? "界隈")</a></li>
								<li  aria-current="page">@Model.Name</li>
							</ol>
						</nav>
						<!-- ヘッダー情報 -->
								<div>
										<div>
												<a asp-controller="Fandom" asp-action="Details" asp-route-id="@Model.FandomId">
														🏛️ @(Model.Fandom?.Name ?? "界隈")
												</a>
												@if (Model.IsPinned) {
														<span >📌 固定</span>
												}
												@if (Model.IsSexual) {
														<span >R-18</span>
												}
												@if (Model.IsViolence) {
														<span >R-18G</span>
												}
										</div>

										@if (isAuthor) {
												<div>
														<a asp-action="Edit" asp-route-id="@Model.Id">
																✏️ @SharedLocalizer["Common_Edit"]
														</a>
														<form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('@SharedLocalizer["Common_ConfirmDelete"]');">
																@Html.AntiForgeryToken()
																<button type="submit">
																		🗑️ @SharedLocalizer["Common_Delete"]
																</button>
														</form>
												</div>
										}
								</div>

								<h2 >@Model.Name</h2>

								<div>
										<div>
												<span>👤 @(Model.User?.UserName ?? "User")</span>
												<span >🕒 @Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
										</div>
										<div>
												<span>👁️ @Model.ViewCount 閲覧</span>
										</div>
								</div>

								<!-- 本文 -->
								<div>
										@Model.Text
								</div>

								<!-- 添付画像（順序付き） -->
								@if (Model.PostImages.Any()) {
										<div>
												<h5 >🖼️ @SharedLocalizer["Post_AttachImages"] (@Model.PostImages.Count)</h5>
												<div>
														@foreach (var pi in Model.PostImages.OrderBy(x => x.DisplayOrder)) {
																<div>
																		<a asp-controller="Image" asp-action="Details" asp-route-id="@pi.ImageId">
																				<img src="/Image/File/@pi.ImageId" alt="@pi.Image.Name" loading="lazy" />
																		</a>
																		<span>
																				#@(pi.DisplayOrder + 1)
																		</span>
																</div>
														}
												</div>
										</div>
								}

								<!-- タグ一覧 & あいまいさ回避 -->
								<div>
										<div>
												<span >🏷️ @SharedLocalizer["Post_Tags"]:</span>
												@if (!Model.PostTags.Any()) {
														<span >なし</span>
												}
												else {
														@foreach (var pt in Model.PostTags) {
																var tagText = pt.TagConcept?.Tags?.FirstOrDefault()?.TagText ?? "tag";
																<div>
																		<a asp-controller="Tag" asp-action="Details" asp-route-conceptId="@pt.TagConceptId">
																				#@tagText
																		</a>
																		<a asp-controller="Tag" asp-action="Disambiguation" asp-route-id="@pt.TagConceptId"  title="@SharedLocalizer["Tag_DisambiguationBtn"]">
																				⚖️
																		</a>
																</div>
														}
												}
										</div>
								</div>

								<!-- リアクションボタン -->
								<div>
										<div >@SharedLocalizer["Reaction_React"]</div>
										@await Html.PartialAsync("_ReactionButtons", ("Post", Model.Id, Model.Reactions.AsEnumerable()))
								</div>
						</div>
				</div>

				<!-- スレッド式コメント一覧 & 投稿フォーム -->
				<div>
					<div>
								<h5 >💬 @SharedLocalizer["Post_ThreadTitle"] (@Model.CommentCount)</h5>
								@if (Model.IsLocked) {
										<span >🔒 @SharedLocalizer["Post_Locked"]</span>
								}
						</div>
						<div>
								@if (Model.IsLocked) {
										<div >この投稿のスレッドはロックされており、新しいコメントは投稿できません。</div>
								}

								@await Html.PartialAsync("_CommentThread", (Model.Comments.Where(c => c.ParentId == null).OrderBy(c => c.CreatedAt).ToList(), "Post", Model.Id))
						</div>
				</div>
		</div>
</div>
