@model Meguri.Models.Post
@using System.Security.Claims

@{
	ViewData["Title"] = Model.Name;
	var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
	var isAuthor = Model.UserId == currentUserId || User.IsInRole("Admin");
	var breadcrumbs = new List<Meguri.Models.BreadcrumbItem> {
		new(Model.Fandom?.Name ?? "界隈", Url.Action("Details", "Fandom", new { id = Model.FandomId })),
		new(Model.Name)
	};
}


<div>
	<div>
		<!-- パンくず -->
		<partial name="_Breadcrumb" model="breadcrumbs" />
		<!-- ヘッダー情報 -->
		<div>
			<a asp-controller="Fandom" asp-action="Details" asp-route-id="@Model.FandomId">@Model.Fandom?.Name</a>
			<div class="attribute-wrap">
				<!-- 公開ステータス -->
				@if (Model.IsPublic) {
					<label title="@SharedLocalizer["Post_Public"]">
						<input type="checkbox" checked disabled />@SharedLocalizer["Post_Public"]
					</label>
				} else {
					<label title="@SharedLocalizer["Post_Public"]">
						<input type="checkbox" disabled />@SharedLocalizer["Post_Public"]
					</label>
				}

				<!-- ピン留め -->
				@if (Model.IsPinned) {
					<label title="@SharedLocalizer["Post_Pinned"]">
						<input type="checkbox" checked disabled />@SharedLocalizer["Post_Pinned"]
					</label>
				} else {
					<label title="@SharedLocalizer["Post_Pinned"]">
						<input type="checkbox" disabled />@SharedLocalizer["Post_Pinned"]
					</label>
				}

				<!-- ロック状態 -->
				@if (Model.IsLocked) {
					<label title="@SharedLocalizer["Post_Locked"]">
						<input type="checkbox" checked disabled />@SharedLocalizer["Post_Locked"]
					</label>
				} else {
					<label title="@SharedLocalizer["Post_Locked"]">
						<input type="checkbox" disabled />@SharedLocalizer["Post_Locked"]
					</label>
				}

				<!-- 性的コンテンツ (R-18) -->
				@if (Model.IsSexual) {
					<label title="@SharedLocalizer["Post_NSFW_Sexual"]">
						<input type="checkbox" checked disabled />@SharedLocalizer["Post_NSFW_Sexual"]
					</label>
				} else {
					<label title="@SharedLocalizer["Post_NSFW_Sexual"]">
						<input type="checkbox" disabled /> @SharedLocalizer["Post_NSFW_Sexual"]
					</label>
				}

				<!-- 暴力コンテンツ (R-18G) -->
				@if (Model.IsViolence) {
					<label title="@SharedLocalizer["Post_NSFW_Violence"]">
						<input type="checkbox" checked disabled />@SharedLocalizer["Post_NSFW_Violence"]
					</label>
				} else {
					<label title="@SharedLocalizer["Post_NSFW_Violence"]">
						<input type="checkbox" disabled />@SharedLocalizer["Post_NSFW_Violence"]
					</label>
				}
			</div>

			@if (isAuthor) {
				<div class="button-wrap">
					<div class="button-like">
						<a asp-action="Edit" asp-route-id="@Model.Id" class="icon-wrap">
							<img src="~/icons/square-pen.svg" alt="Edit" />@SharedLocalizer["Common_Edit"]
						</a>
					</div>
					<form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('@SharedLocalizer["Common_ConfirmDelete"]');">
						@Html.AntiForgeryToken()
						<button type="submit" class="icon-wrap">
							<img src="~/icons/delete.svg" alt="Delete" />@SharedLocalizer["Common_Delete"]
						</button>
					</form>
				</div>
			}
		</div>

		<h2>@Model.Name</h2>

		<div>
			<div>
				@if (Model.User == null) { @SharedLocalizer["Common_UnknownUser"].Value } else if (Model.User.IsWithdrawn) { @SharedLocalizer["Common_WithdrawnUser"].Value } else { <text>@if (!Model.User.IsProfilePublic && User.Identity?.IsAuthenticated != true) { @Model.User.UserName } else { <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.User.Id">@Model.User.UserName</a> }</text> }
				<span>@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
			</div>
			<div>
				<span>@Model.ViewCount 閲覧</span>
			</div>
		</div>

		<!-- 本文 -->
		<div>
			@Model.Text
		</div>

		<!-- 添付画像（順序付き） -->
		@if (Model.PostImages.Any()) {
			<div>
				<h2>@SharedLocalizer["Post_AttachImages"] (@Model.PostImages.Count)</h2>
				<div>
					@foreach (var pi in Model.PostImages.OrderBy(x => x.DisplayOrder)) {
						<div>
							<a asp-controller="Image" asp-action="Details" asp-route-id="@pi.ImageId">
								<img src="/Image/File/@pi.ImageId" alt="@pi.Image.Name" />
							</a>
							<span>
								#@(pi.DisplayOrder + 1)
							</span>
						</div>
					}
				</div>
			</div>
		}

		<!-- タグ一覧 & あいまいさ回避 -->
			@if (Model.PostTags.Any()) {
				<div><span>タグ</span>
				@foreach (var pt in Model.PostTags) {
					var tagText = pt.TagConcept?.Tags?.FirstOrDefault()?.TagText ?? "tag";
					<div>
						<a asp-controller="Tag" asp-action="Details" asp-route-conceptId="@pt.TagConceptId" class="icon-wrap">
							<img src="~/icons/tag.svg">@tagText
						</a>
						<a asp-controller="Tag" asp-action="Disambiguation" asp-route-id="@pt.TagConceptId">あいまいさ回避</a>
					</div>
				}
			</div>
			}
	
		<!-- リアクションボタン -->
		<div>
			<div>@SharedLocalizer["Reaction_React"]</div>
			@await Html.PartialAsync("_ReactionButtons", ("Post", Model.Id, Model.Reactions.AsEnumerable()))
		</div>
	</div>
</div>

<!-- スレッド式コメント一覧 & 投稿フォーム -->
<div>
	<div>
		<h2>コメント (@Model.CommentCount)</h2>
		@if (Model.IsLocked) {
			<span>🔒 @SharedLocalizer["Post_Locked"]</span>
		}
	</div>
	<div>
		@if (Model.IsLocked) {
			<div>この投稿のスレッドはロックされており、新しいコメントは投稿できません。</div>
		}

		@await Html.PartialAsync("_CommentThread", (Model.Comments.Where(c => c.ParentId == null).OrderBy(c => c.CreatedAt).ToList(), "Post", Model.Id))
	</div>
</div>
