@model Meguri.ViewModels.Post.PostEditViewModel
@{
	ViewData["Title"] = SharedLocalizer["Post_EditTitle"];
}

<h1>@SharedLocalizer["Post_EditTitle"]</h1>
<div>
	<form asp-action="Edit" method="post" enctype="multipart/form-data" class="post-edit">
		<input type="hidden" asp-for="Id" />
		<div asp-validation-summary="ModelOnly"></div>

		<input type="hidden" asp-for="FandomId" />

		<!-- タイトル -->
		<div class="attribute-wrap">
			<label asp-for="Name">@SharedLocalizer["Post_PostName"]</label>
			<input asp-for="Name" />
			<span asp-validation-for="Name"></span>
		</div>

		<!-- 本文 -->
		<div class="attribute-wrap">
			<label asp-for="Text">@SharedLocalizer["Post_PostText"]</label>
			<textarea asp-for="Text" rows="6"></textarea>
			<span asp-validation-for="Text"></span>
		</div>

		<!-- 既存の添付画像の並び替え & 削除 -->
		@if (Model.ExistingImages != null && Model.ExistingImages.Any()) {
			<div class="attribute-wrap">
				<label><img src="~/icons/image.svg" class="icon" />@SharedLocalizer["Post_ManageImagesLabel"]</label>
				<p class="description">@SharedLocalizer["Post_ImageOrderHint"]</p>
				<div id="imageOrderContainer">
					@for (int i = 0; i < Model.ExistingImages.Count; i++) {
						<div class="image-order-item">
							<div>
								<span class="order-number">@(i + 1)</span>
								<img src="/Image/File/@Model.ExistingImages[i].ImageId" />
								<span class="image-order-name">@Model.ExistingImages[i].ImageName</span>
								<input type="hidden" name="ExistingImages[@i].ImageId" value="@Model.ExistingImages[i].ImageId" />
								<input type="hidden" name="ExistingImages[@i].ImageName" value="@Model.ExistingImages[i].ImageName" />
								<input type="hidden" class="order-input" name="ExistingImages[@i].DisplayOrder" value="@Model.ExistingImages[i].DisplayOrder" />
							</div>
							<div>
								<button type="button" class="btn-sm" onclick="moveImageOrder(this, 'up')" title="@SharedLocalizer["Common_MoveUp"]"><img src="~/icons/chevron-up.svg" class="icon" /></button>
								<button type="button" class="btn-sm" onclick="moveImageOrder(this, 'down')" title="@SharedLocalizer["Common_MoveDown"]"><img src="~/icons/chevron-down.svg" class="icon" /></button>
								<label class="check-row" for="remove_@i">
									<input type="checkbox" name="ExistingImages[@i].Remove" value="true" id="remove_@i" />
									@SharedLocalizer["Common_Delete"]
								</label>
							</div>
						</div>
					}
				</div>
			</div>
		}

		<!-- 新規画像追加（複数可・最大16枚） -->
		<div class="attribute-wrap">
			<label asp-for="NewImageFiles"><img src="~/icons/plus.svg" class="icon" />@SharedLocalizer["Post_AddMoreImagesLabel"] <span id="imageCountDisplay">0/16</span></label>
			<input asp-for="NewImageFiles" type="file" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
			<span asp-validation-for="NewImageFiles"></span>
			<div id="imagePreviewContainer" class="image-preview-list"></div>
			<div class="description">@SharedLocalizer["Post_ImageUploadHint1"]</div>
			<div class="description">@SharedLocalizer["Post_ImageUploadHint2"]</div>
		</div>

		<!-- タグ編集コンポーネント (最大10個) -->
		<div class="attribute-wrap">
			<label><img src="~/icons/tag.svg" class="icon" />@SharedLocalizer["Post_Tags"] <span id="tagCountDisplay">0/10</span></label>
			<div class="input-group">
				<input type="text" id="tagInput" placeholder="@SharedLocalizer["Tag_SearchPlaceholder"]" />
				<button type="button" onclick="TagManager.addTag($('#tagInput').val())">@SharedLocalizer["Common_Add"]</button>
			</div>
			<div id="tagSuggestions"></div>

			<div id="selectedTagsContainer"></div>
			<div id="hiddenTagsInputs"></div>
			<div class="description">@SharedLocalizer["Post_TagsHint"]</div>
		</div>

		<!-- 各種フラグ -->
		<div class="attribute-wrap">
			<label class="check-row"><input asp-for="IsPublic" type="checkbox" role="switch" /> @SharedLocalizer["Post_Public"]</label>
			<label class="check-row"><input asp-for="IsPinned" type="checkbox" role="switch" /> @SharedLocalizer["Post_Pinned"]</label>
			<label class="check-row"><input asp-for="IsLocked" type="checkbox" role="switch" /> @SharedLocalizer["Post_Locked"]</label>
			<label class="check-row"><input asp-for="IsSexual" type="checkbox" role="switch" /> @SharedLocalizer["Post_NSFW_Sexual"]</label>
			<label class="check-row"><input asp-for="IsViolence" type="checkbox" role="switch" /> @SharedLocalizer["Post_NSFW_Violence"]</label>
		</div>

		<div class="button-wrap">
			<a asp-action="Details" asp-route-id="@Model.Id" class="button-like">@SharedLocalizer["Common_Back"]</a>
			<button type="submit">@SharedLocalizer["Common_Save"]</button>
		</div>
	</form>
</div>


@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script>
		$(document).ready(function () {
			TagManager.init(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tags)));
			ImageAttachmentManager.init('#NewImageFiles', '#imagePreviewContainer', '#imageCountDisplay', 16);
		});
	</script>
}
