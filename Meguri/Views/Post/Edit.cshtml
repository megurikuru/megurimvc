@model Meguri.Models.PostViewModels.PostEditViewModel
@{
		ViewData["Title"] = SharedLocalizer["Post_EditTitle"];
		var fandoms = ViewBag.Fandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
}

<div class="row justify-content-center">
		<div class="col-lg-8">
				<div class="card shadow-sm border-0">
						<div class="card-header bg-white py-3">
								<h4 class="card-title fw-bold mb-0">✏️ @SharedLocalizer["Post_EditTitle"]</h4>
						</div>
						<div class="card-body p-4">
								<form asp-action="Edit" method="post" enctype="multipart/form-data">
										<input type="hidden" asp-for="Id" />
										<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

										<!-- 界隈選択 -->
										<div class="mb-3">
												<label asp-for="FandomId" class="form-label fw-bold">@SharedLocalizer["Post_SelectFandom"] <span class="text-danger">*</span></label>
												<select asp-for="FandomId" class="form-select" required>
														@foreach (var f in fandoms)
														{
																<option value="@f.Id">@f.Name @(f.ParentFandomId.HasValue ? "(子界隈)" : "")</option>
														}
												</select>
												<span asp-validation-for="FandomId" class="text-danger"></span>
										</div>

										<!-- タイトル -->
										<div class="mb-3">
												<label asp-for="Name" class="form-label fw-bold">@SharedLocalizer["Post_PostName"] <span class="text-danger">*</span></label>
												<input asp-for="Name" class="form-control" required />
												<span asp-validation-for="Name" class="text-danger"></span>
										</div>

										<!-- 本文 -->
										<div class="mb-3">
												<label asp-for="Text" class="form-label fw-bold">@SharedLocalizer["Post_PostText"] <span class="text-danger">*</span></label>
												<textarea asp-for="Text" rows="6" class="form-control" required></textarea>
												<span asp-validation-for="Text" class="text-danger"></span>
										</div>

										<!-- 既存の添付画像の並び替え & 削除 -->
										@if (Model.ExistingImages != null && Model.ExistingImages.Any())
										{
												<div class="mb-3">
														<label class="form-label fw-bold mb-1">🖼️ @SharedLocalizer["Post_AttachImages"] の並び順・管理</label>
														<p class="text-body-secondary small mb-2">@SharedLocalizer["Post_ImageOrderHint"]</p>
														<div id="imageOrderContainer" class="d-flex flex-column gap-2">
																@for (int i = 0; i < Model.ExistingImages.Count; i++)
																{
																		<div class="image-order-item d-flex align-items-center justify-content-between p-2">
																				<div class="d-flex align-items-center gap-2">
																						<span class="badge bg-secondary order-number">@(i + 1)</span>
																						<img src="/Image/File/@Model.ExistingImages[i].ImageId" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
																						<span class="small text-truncate" style="max-width: 200px;">@Model.ExistingImages[i].ImageName</span>
																						<input type="hidden" name="ExistingImages[@i].ImageId" value="@Model.ExistingImages[i].ImageId" />
																						<input type="hidden" class="order-input" name="ExistingImages[@i].DisplayOrder" value="@Model.ExistingImages[i].DisplayOrder" />
																				</div>
																				<div class="d-flex align-items-center gap-2">
																						<button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveImageOrder(this, 'up')" title="@SharedLocalizer["Common_MoveUp"]">▲</button>
																						<button type="button" class="btn btn-sm btn-outline-secondary" onclick="moveImageOrder(this, 'down')" title="@SharedLocalizer["Common_MoveDown"]">▼</button>
																						<div class="form-check form-check-inline ms-2">
																								<input class="form-check-input" type="checkbox" name="ExistingImages[@i].Remove" value="true" id="remove_@i" />
																								<label class="form-check-label text-danger small" for="remove_@i">@SharedLocalizer["Common_Delete"]</label>
																						</div>
																				</div>
																		</div>
																}
														</div>
												</div>
										}

										<!-- 新規画像追加 -->
										<div class="mb-3">
												<label asp-for="NewImageFiles" class="form-label fw-bold">➕ 画像を追加添付</label>
												<input asp-for="NewImageFiles" type="file" multiple class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
												<div class="form-text">PNG/JPEG形式（最大5MB/枚）、WebPに自動変換され250KB以下に最適化されます。</div>
										</div>

										<!-- タグ編集コンポーネント (最大10個) -->
										<div class="mb-3 position-relative">
												<div class="d-flex justify-content-between align-items-center mb-1">
														<label class="form-label fw-bold mb-0">🏷️ @SharedLocalizer["Post_Tags"]</label>
														<span class="small text-body-secondary" id="tagCountDisplay">0/10</span>
												</div>
												<div class="input-group">
														<input type="text" id="tagInput" class="form-control" placeholder="@SharedLocalizer["Tag_SearchPlaceholder"]" />
														<button type="button" class="btn btn-outline-secondary" onclick="TagManager.addTag($('#tagInput').val())">@SharedLocalizer["Common_Add"]</button>
												</div>
												<div id="tagSuggestions" class="list-group position-absolute shadow-sm w-100" style="display:none; z-index:1000; max-height:200px; overflow-y:auto;"></div>

												<div id="selectedTagsContainer" class="d-flex flex-wrap gap-1 mt-2"></div>
												<div id="hiddenTagsInputs"></div>
												<div class="form-text">@SharedLocalizer["Post_TagsHint"]</div>
										</div>

										<!-- 各種フラグ -->
										<div class="row mb-4 g-2">
												<div class="col-6 col-md-4 col-lg-2">
														<div class="form-check form-switch">
																<input asp-for="IsPublic" class="form-check-input" type="checkbox" role="switch" />
																<label asp-for="IsPublic" class="form-check-label small">@SharedLocalizer["Post_Public"]</label>
														</div>
												</div>
												<div class="col-6 col-md-4 col-lg-2">
														<div class="form-check form-switch">
																<input asp-for="IsPinned" class="form-check-input" type="checkbox" role="switch" />
																<label asp-for="IsPinned" class="form-check-label small">@SharedLocalizer["Post_Pinned"]</label>
														</div>
												</div>
												<div class="col-6 col-md-4 col-lg-2">
														<div class="form-check form-switch">
																<input asp-for="IsLocked" class="form-check-input" type="checkbox" role="switch" />
																<label asp-for="IsLocked" class="form-check-label small">@SharedLocalizer["Post_Locked"]</label>
														</div>
												</div>
												<div class="col-6 col-md-4 col-lg-3">
														<div class="form-check form-switch">
																<input asp-for="IsSexual" class="form-check-input" type="checkbox" role="switch" />
																<label asp-for="IsSexual" class="form-check-label small text-danger">@SharedLocalizer["Post_NSFW_Sexual"]</label>
														</div>
												</div>
												<div class="col-6 col-md-4 col-lg-3">
														<div class="form-check form-switch">
																<input asp-for="IsViolence" class="form-check-input" type="checkbox" role="switch" />
																<label asp-for="IsViolence" class="form-check-label small text-dark">@SharedLocalizer["Post_NSFW_Violence"]</label>
														</div>
												</div>
										</div>

										<div class="d-flex justify-content-between">
												<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">@SharedLocalizer["Common_Back"]</a>
												<button type="submit" class="btn btn-primary px-4">@SharedLocalizer["Common_Save"]</button>
										</div>
								</form>
						</div>
				</div>
		</div>
</div>

@section Scripts {
		<script>
				$(document).ready(function () {
						TagManager.init(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tags)));
				});
		</script>
}
