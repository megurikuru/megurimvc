@model Meguri.ViewModels.Post.PostCreateViewModel
@{
	ViewData["Title"] = SharedLocalizer["Post_CreateNew"];
}
<h1>@SharedLocalizer["Post_CreateNew"]</h1>
<article>
	<form asp-action="Create" method="post" enctype="multipart/form-data">
		<div asp-validation-summary="ModelOnly"></div>
		<p class="description">@SharedLocalizer["Post_ContentRequired"]</p>

		<input asp-for="FandomId" type="hidden" />

		<!-- タイトル -->
		<div class="attribute-wrap">
			<label asp-for="Name">@SharedLocalizer["Post_OptionalTitle"]</label>
			<input asp-for="Name" class="form-control" placeholder="@SharedLocalizer["Post_TitlePlaceholder"]" />
			<span asp-validation-for="Name"></span>
		</div>

		<!-- 本文 -->
		<div class="attribute-wrap">
			<label asp-for="Text">@SharedLocalizer["Post_OptionalBody"]</label>
			@{
				var markdownEditor = new MarkdownEditorViewModel {
					InputId = "Text",
					InputName = "Text",
					Value = Model.Text,
					Placeholder = SharedLocalizer["Post_BodyPlaceholder"].Value,
					Rows = 10,
					UseMarkdown = Model.UseMarkdown
				};
			}
			<partial name="_MarkdownEditor" model="markdownEditor" />
			<span asp-validation-for="Text"></span>
		</div>

		<!-- 添付画像（複数可・最大16枚） -->
		<div class="attribute-wrap">
			@{
				var postImageUpload = new FileUploadViewModel {
					InputId = "ImageFiles",
					InputName = "ImageFiles",
					LabelText = SharedLocalizer["Post_AttachImages"].Value,
					MaxImages = 16,
					ShowCount = true,
					PreviewContainerId = "imagePreviewContainer",
					CountDisplayId = "imageCountDisplay",
					Hints = [
						SharedLocalizer["Post_ImageUploadHint1"].Value,
						SharedLocalizer["Post_ImageUploadHint2"].Value
					]
				};
			}
			<partial name="_FileUpload" model="postImageUpload" />
		</div>

		<!-- タグ入力コンポーネント (最大10個) -->
		<div class="attribute-wrap">
			<label>@SharedLocalizer["Post_Tags"] <span id="tagCountDisplay">0/10</span></label>
			<div class="input-group">
				<input type="text" class="form-control" id="tagInput" placeholder="@SharedLocalizer["Tag_SearchPlaceholder"]" data-initial-tags="@(System.Text.Json.JsonSerializer.Serialize(Model.Tags))" />
				<button type="button" data-add-tag>@SharedLocalizer["Common_Add"]</button>
			</div>
			<div id="tagSuggestions"></div>
			<div id="selectedTagsContainer"></div>
			<div id="hiddenTagsInputs"></div>
			<p>@SharedLocalizer["Post_TagsHint"]</p>
		</div>

		<!-- オプションフラグ -->
		<div class="attribute-wrap">
			<label class="check-row"><input asp-for="IsPublic" type="checkbox" role="switch" /> @SharedLocalizer["Post_Public"]</label>
			<label class="check-row"><input asp-for="IsSexual" type="checkbox" role="switch" /> @SharedLocalizer["Post_NSFW_Sexual"]</label>
			<label class="check-row"><input asp-for="IsViolence" type="checkbox" role="switch" /> @SharedLocalizer["Post_NSFW_Violence"]</label>
		</div>

		<div class="button-wrap">
			<a asp-action="Index" class="button-like">@SharedLocalizer["Common_Back"]</a>
			<button type="submit">@SharedLocalizer["Common_Submit"]</button>
		</div>
	</form>
</article>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
