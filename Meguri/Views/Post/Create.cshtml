@model Meguri.Models.PostViewModels.PostCreateViewModel
@{
		ViewData["Title"] = SharedLocalizer["Post_CreateNew"];
		var fandoms = ViewBag.Fandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
}

<div class="row justify-content-center">
		<div class="col-lg-8">
				<div class="card shadow-sm border-0">
						<div class="card-header bg-body-tertiary py-3">
								<h4 class="card-title fw-bold mb-0">✏️ @SharedLocalizer["Post_CreateNew"]</h4>
						</div>
						<div class="card-body p-4">
								<form asp-action="Create" method="post" enctype="multipart/form-data">
										<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

										<!-- 界隈選択 -->
										<div class="mb-3">
												<label asp-for="FandomId" class="form-label fw-bold">@SharedLocalizer["Post_SelectFandom"] <span class="text-danger">*</span></label>
												<select asp-for="FandomId" class="form-select" required>
														@foreach (var f in fandoms){
																<option value="@f.Id">@f.Name @(f.ParentFandomId.HasValue ? "(子界隈)" : "")</option>
														}
												</select>
												<span asp-validation-for="FandomId" class="text-danger"></span>
										</div>

										<!-- タイトル -->
										<div class="mb-3">
												<label asp-for="Name" class="form-label fw-bold">@SharedLocalizer["Post_PostName"] <span class="text-danger">*</span></label>
												<input asp-for="Name" class="form-control" placeholder="投稿のタイトル" required />
												<span asp-validation-for="Name" class="text-danger"></span>
										</div>

										<!-- 本文 -->
										<div class="mb-3">
												<label asp-for="Text" class="form-label fw-bold">@SharedLocalizer["Post_PostText"] <span class="text-danger">*</span></label>
												<textarea asp-for="Text" rows="6" class="form-control" placeholder="作品の本文、感想、考察など" required></textarea>
												<span asp-validation-for="Text" class="text-danger"></span>
										</div>

										<!-- 添付画像（複数可） -->
										<div class="mb-3">
												<label asp-for="ImageFiles" class="form-label fw-bold">🖼️ @SharedLocalizer["Post_AttachImages"]</label>
												<input asp-for="ImageFiles" type="file" multiple class="form-control" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
												<div class="form-text">PNG/JPEG形式（最大5MB/枚）、WebPに自動変換され250KB以下に最適化されます。</div>
												<div class="form-text">複数枚の画像を選択できます。投稿後に詳細または編集画面で並び順の変更が可能です。</div>
										</div>

										<!-- タグ入力コンポーネント (最大10個) -->
										<div class="mb-3 position-relative">
												<div class="d-flex justify-content-between align-items-center mb-1">
														<label class="form-label fw-bold mb-0">🏷️ @SharedLocalizer["Post_Tags"]</label>
														<span class="small text-body-secondary" id="tagCountDisplay">0/10</span>
												</div>
												<div class="input-group">
														<input type="text" id="tagInput" class="form-control" placeholder="@SharedLocalizer["Tag_SearchPlaceholder"]" />
														<button type="button" class="btn btn-outline-secondary" onclick="TagManager.addTag($('#tagInput').val())">@SharedLocalizer["Common_Add"]</button>
												</div>
												<div id="tagSuggestions" class="list-group position-absolute shadow-sm w-100" style="display:none; z-index:1000; max-height:200px; overflow-y:auto;"></div>

												<div id="selectedTagsContainer" class="d-flex flex-wrap gap-1 mt-2"></div>
												<div id="hiddenTagsInputs"></div>
												<div class="form-text">@SharedLocalizer["Post_TagsHint"]</div>
										</div>

										<!-- オプションフラグ -->
										<div class="row mb-4">
												<div class="col-md-4 mb-2">
														<div class="form-check form-switch">
																<input asp-for="IsPublic" class="form-check-input" type="checkbox" role="switch" />
																<label asp-for="IsPublic" class="form-check-label small">@SharedLocalizer["Post_Public"]</label>
														</div>
												</div>
												<div class="col-md-4 mb-2">
														<div class="form-check form-switch">
																<input asp-for="IsSexual" class="form-check-input" type="checkbox" role="switch" />
																<label asp-for="IsSexual" class="form-check-label small">@SharedLocalizer["Post_NSFW_Sexual"]</label>
														</div>
												</div>
												<div class="col-md-4 mb-2">
														<div class="form-check form-switch">
																<input asp-for="IsViolence" class="form-check-input" type="checkbox" role="switch" />
																<label asp-for="IsViolence" class="form-check-label small text-body">@SharedLocalizer["Post_NSFW_Violence"]</label>
														</div>
												</div>
										</div>

										<div class="d-flex justify-content-between">
												<a asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Common_Back"]</a>
												<button type="submit" class="btn btn-primary px-4">@SharedLocalizer["Common_Submit"]</button>
										</div>
								</form>
						</div>
				</div>
		</div>
</div>

@section Scripts {
		<script>
				$(document).ready(function () {
						TagManager.init(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tags)));
				});
		</script>
}
