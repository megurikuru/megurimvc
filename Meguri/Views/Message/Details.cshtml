@model Meguri.ViewModels.Message.MessageRoomViewModel
@using Meguri.Extensions
@{
	ViewData["Title"] = Model.DisplayTitle;

	var breadcrumbs = new List<BreadcrumbItemViewModel> {
		new(SharedLocalizer["Message_Title"].Value, Url.Action("Index", "Message")),
		new(Model.DisplayTitle)
	};
	// 日付指定をページ移動先にも引き継ぐ。
	var dateValue = Model.FilterDate?.ToString("yyyy-MM-dd");
	var routeValues = new Dictionary<string, string> {
		["id"] = Model.Conversation.Id.ToString()
	};
	if (!string.IsNullOrEmpty(dateValue)) {
		routeValues["date"] = dateValue;
	}
	// ページングの件数は返信を含む投稿数ではなく、表示中のスレッド数で数える。
	var pager = new PaginationViewModel {
		Controller = "Message",
		Action = "Details",
		HasPrevious = Model.HasPrevious,
		HasNext = Model.HasNext,
		TotalCount = Model.TotalCount,
		Skip = Model.Skip,
		PreviousSkip = Model.PreviousSkip,
		NextSkip = Model.NextSkip,
		CurrentCount = Model.Messages.Count(m => !m.ParentMessageId.HasValue || !Model.Messages.Any(x => x.Id == m.ParentMessageId)),
		PageSize = Model.PageSize,
		RouteValues = routeValues
	};
}

@* パンくずリスト *@
<partial name="_Breadcrumb" model="breadcrumbs" />

<h1><img src="~/icons/@(Model.Conversation.IsGroup ? "users.svg" : "user.svg")" class="icon" />@Model.DisplayTitle</h1>

@* メンバー一覧 *@
<partial name="_MemberList" model="Model"	/>

@* メッセージフォーム *@
<partial name="_MessageForm" model="Model" />

@* メッセージ一覧 *@
<partial name="_Messages" model="Model" />

@* ページネーション *@
<partial name="_Pagination" model="pager" />
