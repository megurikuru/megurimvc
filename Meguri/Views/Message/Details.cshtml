@model Meguri.ViewModels.Message.ChatRoomViewModel
@{
	ViewData["Title"] = Model.DisplayTitle;
	var dateValue = Model.FilterDate?.ToString("yyyy-MM-dd");
	var routeValues = new Dictionary<string, string> {
		["id"] = Model.Conversation.Id.ToString()
	};
	if (!string.IsNullOrEmpty(dateValue)) {
		routeValues["date"] = dateValue;
	}
	var pager = new PaginationViewModel {
		Controller = "Message",
		Action = "Details",
		HasPrevious = Model.HasPrevious,
		HasNext = Model.HasNext,
		TotalCount = Model.TotalCount,
		Skip = Model.Skip,
		PreviousSkip = Model.PreviousSkip,
		NextSkip = Model.NextSkip,
		CurrentCount = Model.Messages.Count(m => !m.ParentMessageId.HasValue || !Model.Messages.Any(x => x.Id == m.ParentMessageId)),
		PageSize = Model.PageSize,
		RouteValues = routeValues
	};
}

<div>
	<a asp-action="Index"><img src="~/icons/arrow-left.svg" class="icon" /></a>
	<h2><img src="~/icons/@(Model.Conversation.IsGroup ? "users.svg" : "user.svg")" class="icon" />@Model.DisplayTitle</h2>
	<p>
		<img src="~/icons/users.svg" class="icon" />@string.Format(SharedLocalizer["Message_MembersCountFormat"].Value, Model.Conversation.Members.Count):
		@foreach (var m in Model.Conversation.Members.Select((member, index) => new { member, index })) {
					@if (m.index > 0) { <text>, </text> }
					@if (m.member.User == null) { @SharedLocalizer["Common_UnknownUser"].Value }
					else if (m.member.User.IsWithdrawn) { @(m.member.User.UserName + "(" + SharedLocalizer["Common_WithdrawnUser"].Value + ")") }
					else { <text>@if (!m.member.User.IsProfilePublic && User.Identity?.IsAuthenticated != true) { @m.member.User.UserName } else { <a asp-controller="Profile" asp-action="Details" asp-route-id="@m.member.User.UserName">@m.member.User.UserName</a> }</text> }
				}
	</p>
</div>

<div class="attribute-wrap">
	<form asp-action="Details" method="get">
		<input type="hidden" name="id" value="@Model.Conversation.Id" />
		<label>@SharedLocalizer["Message_DateLabel"]</label>
		<div class="input-group">
			<input type="date" name="date" value="@dateValue" />
			<button type="submit">@SharedLocalizer["Common_Filter"]</button>
			<a asp-action="Details" asp-route-id="@Model.Conversation.Id" class="button-like">@SharedLocalizer["Common_Clear"]</a>
		</div>
		<span class="description">@string.Format(SharedLocalizer["Message_ChatDateFilterHintFormat"].Value, Model.PageSize)</span>
	</form>
</div>

<partial name="_Pagination" model="pager" />

<div id="chatMessageContainer">
	@if (!Model.Messages.Any()) {
		<p>@SharedLocalizer["Message_NoMessagesForDate"]</p>
	}
	else {
		@foreach (var msg in Model.Messages) {
			var isMe = msg.SenderId == Model.CurrentUserId;
			var depth = 0;
			var parentId = msg.ParentMessageId;
			while (parentId.HasValue && depth < 3) {
				var parent = Model.Messages.FirstOrDefault(x => x.Id == parentId.Value);
				if (parent == null) { break; }
				depth++;
				parentId = parent.ParentMessageId;
			}
			var indentClass = depth > 0 ? $"chat-indent-{depth}" : null;
			<div class="chat-message-item @indentClass">
				@if (!isMe) {
					<div><img src="~/icons/user.svg" class="icon" />@if (msg.Sender == null) { @SharedLocalizer["Common_UnknownUser"].Value } else if (msg.Sender.IsWithdrawn) { @(msg.Sender.UserName + "(" + SharedLocalizer["Common_WithdrawnUser"].Value + ")") } else { <text>@if (!msg.Sender.IsProfilePublic && User.Identity?.IsAuthenticated != true) { @msg.Sender.UserName } else { <a asp-controller="Profile" asp-action="Details" asp-route-id="@msg.Sender.UserName">@msg.Sender.UserName</a> }</text> }</div>
				}
				<div class="chat-message-box">
					@if (msg.IsDeleted) {
						<div><em>@SharedLocalizer["Message_Deleted"]</em></div>
					}
					@if (!msg.IsDeleted && !string.IsNullOrEmpty(msg.Subject)) {
						<div><strong>@msg.Subject</strong></div>
					}
					@if (!msg.IsDeleted && !string.IsNullOrEmpty(msg.Body)) {
						<div class="chat-message-body">@msg.Body</div>
					}
					@if (!msg.IsDeleted && msg.MessageImages.Any()) {
						<div>
							@foreach (var mi in msg.MessageImages.OrderBy(x => x.DisplayOrder)) {
								<a href="/Image/File/@mi.ImageId" target="_blank">
									<img src="/Image/File/@mi.ImageId" class="chat-message-image" alt="" />
								</a>
							}
						</div>
					}
					<div class="inline-actions">
						<span>@msg.CreatedAt.ToLocalTime()</span>
						@if (isMe && !msg.IsDeleted) {
							<a asp-action="Edit" asp-route-id="@msg.Id" class="button-like btn-sm">@SharedLocalizer["Common_Edit"]</a>
							<form asp-action="Delete" asp-route-id="@msg.Id" method="post" data-confirm="@SharedLocalizer["Common_ConfirmDelete"]">
								<button type="submit" class="btn-sm">@SharedLocalizer["Common_Delete"]</button>
							</form>
						}
						@if (User.Identity?.IsAuthenticated == true) {
							<button type="button" class="btn-sm" data-reply-subject="@msg.Subject" data-reply-id="@msg.Id"><img src="~/icons/reply.svg" class="icon" />@SharedLocalizer["Message_ReplyBtn"]</button>
						}
					</div>
				</div>
				@if (!msg.IsDeleted) {
				<div>
					<button type="button" class="btn-sm" data-toggle-next>@SharedLocalizer["Message_ReactionBtn"]</button>
					<div hidden>
						<partial name="_ReactionButtons" model='("Message", msg.Id, msg.Reactions.AsEnumerable())' />
					</div>
				</div>
				}
			</div>
		}
	}
</div>

<partial name="_Pagination" model="pager" />

<div>
	<form asp-action="SendMessage" method="post" enctype="multipart/form-data" autocomplete="off">
		@Html.AntiForgeryToken()
		<input type="hidden" name="conversationId" value="@Model.Conversation.Id" />
		<input type="hidden" id="parentMessageId" name="parentMessageId" value="" autocomplete="off" />
		<div class="attribute-wrap">
			<input type="text" id="messageSubject" name="subject" placeholder="@SharedLocalizer["Message_SubjectLabel"]" />
		</div>
		<div class="attribute-wrap">
			<textarea id="messageText" name="text" rows="3" placeholder="@SharedLocalizer["Message_TextPlaceholder"]"></textarea>
		</div>
		<div class="attribute-wrap">
			<input type="file" name="imageFiles" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
		</div>
		<div class="button-wrap">
			<button type="submit" class="btn-block"><img src="~/icons/send.svg" class="icon" />@SharedLocalizer["Message_SendBtn"]</button>
		</div>
	</form>
</div>
