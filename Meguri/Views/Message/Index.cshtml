@model Meguri.ViewModels.Message.ConversationListViewModel
@{
	ViewData["Title"] = SharedLocalizer["Message_Title"];
	var dateValue = Model.FilterDate?.ToString("yyyy-MM-dd");
	var routeValues = new Dictionary<string, string>();
	if (!string.IsNullOrEmpty(dateValue)) {
		routeValues["date"] = dateValue;
	}
	var pager = new PaginationViewModel {
		Controller = "Message",
		Action = "Index",
		HasPrevious = Model.HasPrevious,
		HasNext = Model.HasNext,
		TotalCount = Model.TotalCount,
		Skip = Model.Skip,
		PreviousSkip = Model.PreviousSkip,
		NextSkip = Model.NextSkip,
		CurrentCount = Model.Conversations.Count,
		PageSize = Model.PageSize,
		RouteValues = routeValues
	};
}

<h1>@SharedLocalizer["Message_Title"]</h1>
<nav class="nav-grid">
	<ul>
		<li>
			<a asp-action="Create" class="button-like icon-wrap">@SharedLocalizer["Message_NewConversation"]</a>
		</li>
	</ul>
</nav>

<div class="attribute-wrap">
	<form asp-action="Index" method="get">
		<div class="input-group">
			<input type="date" name="date" value="@dateValue" />
			<button type="submit">@SharedLocalizer["Common_Filter"]</button>
			<a asp-action="Index" class="button-like">@SharedLocalizer["Common_Clear"]</a>
		</div>
		<span class="description">@SharedLocalizer["Message_DateFilterHint"]</span>
	</form>
</div>

@if (!Model.Conversations.Any()) {
	<article>
		<h2>@SharedLocalizer["Message_NoConversations"]</h2>
		<p>@SharedLocalizer["Message_NoConversationsHint"]</p>
		<div class="button-wrap">
			<a asp-action="Create" class="button-like icon-wrap"><img src="~/icons/plus.svg" class="icon" />@SharedLocalizer["Message_NewConversation"]</a>
		</div>
	</article>
} else {
	@foreach (var c in Model.Conversations) {
		<a asp-action="Details" asp-route-id="@c.Id">
			<article>
				<h2>
					<img src="~/icons/@(c.IsGroup ? "users.svg" : "user.svg")" class="icon" />@c.Title
					@if (c.IsGroup) {
						<span>@SharedLocalizer["Message_GroupBadge"]</span>
					}
				</h2>
				<small>@c.LastMessageTime.ToString("yyyy年MM月dd日 HH:mm")</small>
				<p>@(c.LastMessageText.Length > 100 ? c.LastMessageText.Substring(0, 100) + "..." : c.LastMessageText)</p>
				
			</article>
		</a>
	}
}

<partial name="_Pagination" model="pager" />
