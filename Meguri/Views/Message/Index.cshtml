@model Meguri.Models.MessageViewModels.ConversationListViewModel
@{
		ViewData["Title"] = SharedLocalizer["Message_Title"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
		<div>
				<h2 class="fw-bold mb-1">💬 @SharedLocalizer["Message_Title"]</h2>
				<p class="text-body-secondary mb-0">@SharedLocalizer["Message_SubTitle"]</p>
		</div>
		<button type="button" class="btn btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#newConversationModal">
				➕ @SharedLocalizer["Message_NewConversation"]
		</button>
</div>

<!-- 日付絞り込みフォーム -->
<div class="card shadow-sm border-0 bg-body-tertiary mb-3">
		<div class="card-body py-2">
				<form asp-action="Index" method="get" class="d-flex flex-wrap align-items-end gap-2">
						<div>
								<label class="form-label small mb-0">@SharedLocalizer["Message_DateLabel"]</label>
								<input type="date" name="date" class="form-control form-control-sm" value="@(Model.FilterDate?.ToString("yyyy-MM-dd"))" />
						</div>
						<button type="submit" class="btn btn-sm btn-outline-primary">@SharedLocalizer["Common_Filter"]</button>
						<a asp-action="Index" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Common_Clear"]</a>
						<span class="small text-body-secondary ms-2">@SharedLocalizer["Message_DateFilterHint"]</span>
				</form>
		</div>
</div>

<!-- 会話一覧 -->
<div class="card shadow-sm border-0 bg-body-tertiary">
		@if (!Model.Conversations.Any()) {
				<div class="card-body p-5 text-center text-body-secondary">
						<h4>@SharedLocalizer["Message_NoConversations"]</h4>
						<p>@SharedLocalizer["Message_NoConversationsHint"]</p>
						<button type="button" class="btn btn btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#newConversationModal">
								➕ @SharedLocalizer["Message_NewConversation"]
						</button>
				</div>
		}
		else {
				<div class="list-group list-group-flush">
						@foreach (var c in Model.Conversations) {
								<a asp-action="Chat" asp-route-id="@c.Id" class="list-group-item list-group-item-action p-3 d-flex justify-content-between align-items-center">
										<div class="d-flex align-items-center gap-3">
												<div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 fs-4">
														@(c.IsGroup ? "👥" : "👤")
												</div>
												<div>
														<h6 class="fw-bold mb-1">
																@c.Title
																@if (c.IsGroup) {
																		<span class="badge bg-secondary ms-1">@SharedLocalizer["Message_GroupBadge"]</span>
																}
														</h6>
														<p class="text-body-secondary small mb-0 text-truncate" style="max-width: 400px;">
																@c.LastMessageText
														</p>
												</div>
										</div>
										<div class="text-end text-body-secondary small">
												<div class="message-time" data-utc="@c.LastMessageTime.ToString("o")">@c.LastMessageTime.ToString("MM/dd HH:mm")</div>
												<span class="badge bg-body-secondary border">@SharedLocalizer["Message_OpenBadge"]</span>
										</div>
								</a>
						}
				</div>
		}
</div>

@if (Model.TotalCount > 0) {
		<nav class="d-flex justify-content-between align-items-center py-2 border-top px-3">
				@if (Model.HasPrevious) {
						<a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-skip="@Model.PreviousSkip" asp-route-date="@(Model.FilterDate?.ToString("yyyy-MM-dd"))">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 20)</a>
				} else {
						<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 20)</button>
				}
				<span class="small text-body-secondary">@(Model.TotalCount == 0 ? 0 : Model.Skip + 1) - @(Model.Skip + Model.Conversations.Count) / @Model.TotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>
				@if (Model.HasNext) {
						<a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-skip="@Model.NextSkip" asp-route-date="@(Model.FilterDate?.ToString("yyyy-MM-dd"))">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 20)</a>
				} else {
						<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 20)</button>
				}
		</nav>
}

<!-- 新規会話作成モーダル -->
<div class="modal fade" id="newConversationModal" tabindex="-1" aria-labelledby="newConversationModalLabel" aria-hidden="true">
		<div class="modal-dialog">
				<div class="modal-content border-0 shadow">
						<div class="modal-header bg-body-tertiary">
								<h5 class="modal-title fw-bold" id="newConversationModalLabel">💬 @SharedLocalizer["Message_NewConversation"]</h5>
								<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
						</div>
						<form asp-action="Create" method="post" enctype="multipart/form-data">
								@Html.AntiForgeryToken()
								<div class="modal-body">
										<!-- タイプ切替 -->
										<div class="mb-3">
												<label class="form-label fw-bold">@SharedLocalizer["Message_ChatTypeLabel"]</label>
												<div class="d-flex gap-3">
														<div class="form-check">
																<input class="form-check-input" type="radio" name="IsGroup" id="typeDirect" value="false" checked onchange="$('#groupTitleContainer').addClass('d-none')" />
																<label class="form-check-label" for="typeDirect">@SharedLocalizer["Message_Direct"]</label>
														</div>
														<div class="form-check">
																<input class="form-check-input" type="radio" name="IsGroup" id="typeGroup" value="true" onchange="$('#groupTitleContainer').removeClass('d-none')" />
																<label class="form-check-label" for="typeGroup">@SharedLocalizer["Message_Group"]</label>
														</div>
												</div>
										</div>

										<!-- グループ名入力（グループ時のみ） -->
										<div class="mb-3 d-none" id="groupTitleContainer">
												<label class="form-label fw-bold">@SharedLocalizer["Message_GroupName"]</label>
												<input type="text" name="Title" class="form-control" placeholder="@SharedLocalizer["Message_GroupNamePlaceholder"]" />
										</div>

										<!-- メンバー選択 -->
										<div class="mb-3">
												<label class="form-label fw-bold">@SharedLocalizer["Message_SelectRecipient"] <span class="text-danger">*</span></label>
												<div class="border rounded p-2" style="max-height: 150px; overflow-y: auto;">
																@if (!Model.AvailableUsers.Any()) {
																			<p class="text-body-secondary small mb-0">@SharedLocalizer["Message_NoOtherUsers"]</p>
																		}
																		@foreach (var user in Model.AvailableUsers) {
																				<div class="form-check">
																					<input class="form-check-input recipient-checkbox" type="checkbox" name="SelectedUserIds" value="@user.Id" id="user_@user.Id" />
																					<label class="form-check-label" for="user_@user.Id">
																						👤 @user.UserName
																					</label>
																				</div>
																		}
																</div>
														</div>

														<!-- メッセージ入力 -->
														<div class="mb-3">
																<label class="form-label fw-bold">@SharedLocalizer["Message_InputPlaceholder"] <span class="text-danger">*</span></label>
																<textarea name="InitialMessage" id="initialMessageInput" rows="3" class="form-control" placeholder="@SharedLocalizer["Message_TextPlaceholder"]" required></textarea>
														</div>

										<!-- 画像添付 -->
										<div class="mb-3">
												<label class="form-label fw-bold">@SharedLocalizer["Message_ImageAttachLabel"]</label>
												<input type="file" name="ImageFiles" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control form-control-sm" />
										</div>
								</div>
								<div class="modal-footer bg-body-tertiary">
															<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@SharedLocalizer["Common_Cancel"]</button>
															<button type="submit" id="newConversationSubmitBtn" class="btn btn btn-outline-primary" disabled>@SharedLocalizer["Message_SendBtn"]</button>
														</div>
														</form>
													</div>
												</div>
										</div>

										@section Scripts {
											<script>
												$(document).ready(function () {
													function updateNewConversationButtonState() {
														var hasRecipient = $('.recipient-checkbox:checked').length > 0;
														var hasMessage = $('#initialMessageInput').val().trim().length > 0;
														$('#newConversationSubmitBtn').prop('disabled', !(hasRecipient && hasMessage));
													}

													$('.message-time[data-utc]').each(function () {
														var raw = $(this).data('utc');
														if (!raw) return;
														var dt = new Date(raw);
														if (isNaN(dt.getTime())) return;
														$(this).text(dt.toLocaleString('ja-JP', {
															month: '2-digit',
															day: '2-digit',
															hour: '2-digit',
															minute: '2-digit',
															hour12: false
														}).replace(/\//g, '/'));
													});

													$(document).on('change', '.recipient-checkbox', updateNewConversationButtonState);
													$(document).on('input', '#initialMessageInput', updateNewConversationButtonState);

													updateNewConversationButtonState();
												});
											</script>
										}
