@model Meguri.Models.MessageViewModels.ConversationListViewModel
@{
	ViewData["Title"] = SharedLocalizer["Message_Title"];
	var dateValue = Model.FilterDate?.ToString("yyyy-MM-dd");
	var routeValues = new Dictionary<string, string>();
	if (!string.IsNullOrEmpty(dateValue)) {
		routeValues["date"] = dateValue;
	}
	var pager = new Meguri.ViewModels.PaginationViewModel {
		Controller = "Message",
		Action = "Index",
		HasPrevious = Model.HasPrevious,
		HasNext = Model.HasNext,
		TotalCount = Model.TotalCount,
		Skip = Model.Skip,
		PreviousSkip = Model.PreviousSkip,
		NextSkip = Model.NextSkip,
		CurrentCount = Model.Conversations.Count,
		PageSize = Model.PageSize,
		RouteValues = routeValues
	};
}

<div>
	<div>
		<h2>💬 @SharedLocalizer["Message_Title"]</h2>
		<p>@SharedLocalizer["Message_SubTitle"]</p>
	</div>
	<a asp-action="Create">➕ @SharedLocalizer["Message_NewConversation"]</a>
</div>

<div>
	<form asp-action="Index" method="get">
		<div>
			<label>@SharedLocalizer["Message_DateLabel"]</label>
			<input type="date" name="date" value="@dateValue" />
		</div>
		<button type="submit">@SharedLocalizer["Common_Filter"]</button>
		<a asp-action="Index">@SharedLocalizer["Common_Clear"]</a>
		<span>@SharedLocalizer["Message_DateFilterHint"]</span>
	</form>
</div>

@if (!Model.Conversations.Any()) {
	<div>
		<h4>@SharedLocalizer["Message_NoConversations"]</h4>
		<p>@SharedLocalizer["Message_NoConversationsHint"]</p>
		<a asp-action="Create">➕ @SharedLocalizer["Message_NewConversation"]</a>
	</div>
}
else {
	<div>
		@foreach (var c in Model.Conversations) {
			<div>
				<h4>
					<a asp-action="Details" asp-route-id="@c.Id">
						@(c.IsGroup ? "👥" : "👤") @c.Title
					</a>
					@if (c.IsGroup) {
						<span>@SharedLocalizer["Message_GroupBadge"]</span>
					}
				</h4>
				<p>@(c.LastMessageText.Length > 100 ? c.LastMessageText.Substring(0, 100) + "..." : c.LastMessageText)</p>
				<small>@c.LastMessageTime.ToString("yyyy/MM/dd HH:mm")</small>
			</div>
		}
	</div>
}

<partial name="_Pagination" model="pager" />
