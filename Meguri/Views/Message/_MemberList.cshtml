@* グループメッセージの場合には、メンバー一覧を開閉できるようにする。 *@
@if (Model.Conversation.IsGroup) {
	<details class="message-disclosure">
		<summary><img src="~/icons/users.svg" class="icon" alt="" />@string.Format(SharedLocalizer["Message_MembersCountFormat"].Value, Model.Conversation.Members.Count)</summary>
		<ul class="member-list">
			@foreach (var member in Model.Conversation.Members) {
				<li>
					@if (member.User == null) {
						<span>@SharedLocalizer["Common_UnknownUser"].Value</span>
					} else if (member.User.IsWithdrawn) {
						<span>
							@if (member.User.ActiveAvatarImageId.HasValue) {
								<img src="/Image/File/@member.User.ActiveAvatarImageId" class="user-avatar-sm" alt="" />
							}
							@(member.User.UserName + "(" + SharedLocalizer["Common_WithdrawnUser"].Value + ")")
						</span>
					} else if (!member.User.IsProfilePublic && User.Identity?.IsAuthenticated != true) {
						<span>
							@if (member.User.ActiveAvatarImageId.HasValue) {
								<img src="/Image/File/@member.User.ActiveAvatarImageId" class="user-avatar-sm" alt="" />
							}
							@member.User.UserName
						</span>
					} else {
						<a asp-controller="Profile" asp-action="Details" asp-route-id="@member.User.UserName">
							@if (member.User.ActiveAvatarImageId.HasValue) {
								<img src="/Image/File/@member.User.ActiveAvatarImageId" class="user-avatar-sm" alt="" />
							}
							@member.User.UserName
						</a>
					}
				</li>
			}
		</ul>
	</details>
}