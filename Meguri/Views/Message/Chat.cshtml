@model Meguri.Models.MessageViewModels.ChatRoomViewModel
@{
		ViewData["Title"] = Model.DisplayTitle;
}

<div class="row justify-content-center">
		<div class="col-lg-9">
				<div class="card shadow-sm border-0 mb-3 bg-body-tertiary">
						<div class="card-header bg-body-tertiary py-3 d-flex justify-content-between align-items-center">
								<div class="d-flex align-items-center gap-2">
										<a asp-action="Index" class="btn btn-sm btn-outline-secondary">←</a>
										<h5 class="fw-bold mb-0">
												@(Model.Conversation.IsGroup ? "👥" : "👤") @Model.DisplayTitle
										</h5>
								</div>
								<div class="dropdown">
										<button class="btn btn-sm btn-light border dropdown-toggle" type="button" data-bs-toggle="dropdown">
												👥 メンバー (@Model.Conversation.Members.Count)
										</button>
										<ul class="dropdown-menu dropdown-menu-end">
												@foreach (var m in Model.Conversation.Members) {
														<li class="dropdown-item-text small">👤 @(m.User?.UserName ?? "User")</li>
												}
										</ul>
								</div>
						</div>

						<!-- 日付絞り込みフォーム -->
						<div class="card-body border-bottom py-2">
								<form asp-action="Chat" method="get" class="d-flex flex-wrap align-items-end gap-2">
										<input type="hidden" name="id" value="@Model.Conversation.Id" />
										<div>
												<label class="form-label small mb-0">日付</label>
												<input type="date" name="date" class="form-control form-control-sm" value="@(Model.FilterDate?.ToString("yyyy-MM-dd"))" />
										</div>
										<button type="submit" class="btn btn-sm btn-outline-primary">絞り込み</button>
										<a asp-action="Chat" asp-route-id="@Model.Conversation.Id" class="btn btn-sm btn-outline-secondary">クリア</a>
										<span class="small text-body-secondary ms-2">指定した日付の前後最大40件（合計最大80件）を表示します</span>
								</form>
						</div>

						<!-- チャットメッセージエリア -->
						<div class="chat-container" id="chatMessageContainer">
								@if (!Model.Messages.Any()) {
										<p class="text-center text-body-secondary my-auto">該当するメッセージがありません</p>
								} else {
										@foreach (var msg in Model.Messages) {
											var isMe = msg.SenderId == Model.CurrentUserId;
												<div class="d-flex flex-column @(isMe ? "align-items-end" : "align-items-start")">
														@if (!isMe) {
																<span class="small text-body-secondary ms-1 mb-1">👤 @(msg.Sender?.UserName ?? "User")</span>
														}
														<div class="chat-bubble @(isMe ? "chat-bubble-outgoing" : "chat-bubble-incoming") shadow-sm">
																@if (!string.IsNullOrEmpty(msg.Text)) {
																		<div style="white-space: pre-line;">@msg.Text</div>
																}

																@if (msg.MessageImages.Any()) {
																		<div class="d-flex flex-wrap gap-2 mt-2">
																				@foreach (var mi in msg.MessageImages.OrderBy(x => x.DisplayOrder)) {
																						<a asp-controller="Image" asp-action="Details" asp-route-id="@mi.ImageId">
																								<img src="/Image/File/@mi.ImageId" class="rounded" style="max-height: 150px; object-fit: cover;" alt="Attached" />
																						</a>
																				}
																		</div>
																}
																<div class="timestamp" data-utc="@msg.CreatedAt.ToString("o")">@msg.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
														</div>

														<!-- リアクションバー -->
														<div class="mt-1">
																@await Html.PartialAsync("_ReactionButtons", ("Message", msg.Id, msg.Reactions.AsEnumerable()))
														</div>
												</div>
										}
								}
						</div>

						<nav class="d-flex justify-content-between align-items-center py-2 border-top px-3">
								@if (Model.HasPrevious) {
										<a class="btn btn-sm btn-outline-secondary" asp-action="Chat" asp-route-id="@Model.Conversation.Id" asp-route-skip="@Model.PreviousSkip">← 前の80件</a>
								} else {
										<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>← 前の80件</button>
								}
								<span class="small text-body-secondary">@(Model.TotalCount == 0 ? 0 : Model.Skip + 1) - @(Model.Skip + Model.Messages.Count) / @Model.TotalCount 件</span>
								@if (Model.HasNext) {
										<a class="btn btn-sm btn-outline-secondary" asp-action="Chat" asp-route-id="@Model.Conversation.Id" asp-route-skip="@Model.NextSkip">次の80件 →</a>
								} else {
										<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>次の80件 →</button>
								}
						</nav>

						<!-- 送信フォーム -->
						<div class="card-footer bg-body-tertiary border-top p-3">
								<form asp-action="SendMessage" method="post" enctype="multipart/form-data">
										@Html.AntiForgeryToken()
										<input type="hidden" name="conversationId" value="@Model.Conversation.Id" />

										<div class="mb-2">
											<textarea name="text" id="messageTextInput" rows="2" class="form-control" placeholder="@SharedLocalizer["Message_InputPlaceholder"]" autofocus></textarea>
										</div>

										<div class="d-flex justify-content-between align-items-center">
											<input type="file" name="imageFiles" id="messageImageInput" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="form-control form-control-sm" style="max-width: 250px;" />
											<button type="submit" id="sendMessageBtn" class="btn btn btn-outline-primary btn-sm px-4" disabled>
												🚀 @SharedLocalizer["Message_SendBtn"]
											</button>
										</div>
								</form>
						</div>
				</div>
		</div>
</div>

@section Scripts {
		<script>
				$(document).ready(function () {
					const container = document.getElementById('chatMessageContainer');
					if (container) {
						container.scrollTop = container.scrollHeight;
					}

					$('.timestamp[data-utc]').each(function () {
						var raw = $(this).data('utc');
						if (!raw) return;
						var dt = new Date(raw);
						if (isNaN(dt.getTime())) return;
						var datePart = dt.toLocaleDateString('ja-JP', {
							year: 'numeric',
							month: '2-digit',
							day: '2-digit'
						});
						var timePart = dt.toLocaleTimeString('ja-JP', {
							hour: '2-digit',
							minute: '2-digit',
							hour12: false
						});
						$(this).text(datePart + ' ' + timePart);
					});

					function updateSendButtonState() {
						var hasText = $('#messageTextInput').val().trim().length > 0;
						var hasFiles = $('#messageImageInput')[0] && $('#messageImageInput')[0].files.length > 0;
						$('#sendMessageBtn').prop('disabled', !(hasText || hasFiles));
					}

					$(document).on('input', '#messageTextInput', updateSendButtonState);
					$(document).on('change', '#messageImageInput', updateSendButtonState);

					updateSendButtonState();
				});
		</script>
}
