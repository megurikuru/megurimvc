@model Meguri.Models.MessageViewModels.ChatRoomViewModel
@{
		ViewData["Title"] = Model.DisplayTitle;
}

<div>
		<div>
				<div>
						<div>
								<div>
										<a asp-action="Index" >←</a>
										<h5>
												@(Model.Conversation.IsGroup ? "👥" : "👤") @Model.DisplayTitle
										</h5>
								</div>
								<div>
										<button  type="button" data-bs-toggle="dropdown">
												👥 @string.Format(SharedLocalizer["Message_MembersCountFormat"].Value, Model.Conversation.Members.Count)
										</button>
										<ul>
												@foreach (var m in Model.Conversation.Members) {
														<li >👤 @(m.User?.UserName ?? SharedLocalizer["Common_UnknownUser"].Value)</li>
												}
										</ul>
								</div>
						</div>

						<!-- 日付絞り込みフォーム -->
						<div>
								<form asp-action="Chat" method="get">
										<input type="hidden" name="id" value="@Model.Conversation.Id" />
										<div>
												<label >@SharedLocalizer["Message_DateLabel"]</label>
												<input type="date" name="date"  value="@(Model.FilterDate?.ToString("yyyy-MM-dd"))" />
										</div>
										<button type="submit" >@SharedLocalizer["Common_Filter"]</button>
										<a asp-action="Chat" asp-route-id="@Model.Conversation.Id" >@SharedLocalizer["Common_Clear"]</a>
										<span >@string.Format(SharedLocalizer["Message_ChatDateFilterHintFormat"].Value, 40, 80)</span>
								</form>
						</div>

						<!-- チャットメッセージエリア -->
						<div  id="chatMessageContainer">
								@if (!Model.Messages.Any()) {
										<p >@SharedLocalizer["Message_NoMessagesForDate"]</p>
								} else {
										@foreach (var msg in Model.Messages) {
											var isMe = msg.SenderId == Model.CurrentUserId;
												<div align-items-end" : "align-items-start")">
														@if (!isMe) {
																<span >👤 @(msg.Sender?.UserName ?? SharedLocalizer["Common_UnknownUser"].Value)</span>
														}
														<div chat-bubble-outgoing" : "chat-bubble-incoming") shadow-sm">
																@if (!string.IsNullOrEmpty(msg.Text)) {
																		<div>@msg.Text</div>
																}

																@if (msg.MessageImages.Any()) {
																		<div>
																				@foreach (var mi in msg.MessageImages.OrderBy(x => x.DisplayOrder)) {
																						<a asp-controller="Image" asp-action="Details" asp-route-id="@mi.ImageId">
																								<img src="/Image/File/@mi.ImageId"  style="max-height: 150px; object-fit: cover;" alt="Attached" />
																						</a>
																				}
																		</div>
																}
																<div  data-utc="@msg.CreatedAt.ToString("o")">@msg.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
														</div>

														<!-- リアクションバー -->
														<div>
																@await Html.PartialAsync("_ReactionButtons", ("Message", msg.Id, msg.Reactions.AsEnumerable()))
														</div>
												</div>
										}
								}
						</div>

						<nav>
								@if (Model.HasPrevious) {
										<a  asp-action="Chat" asp-route-id="@Model.Conversation.Id" asp-route-skip="@Model.PreviousSkip">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 80)</a>
								} else {
										<button type="button"  disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 80)</button>
								}
								<span >@(Model.TotalCount == 0 ? 0 : Model.Skip + 1) - @(Model.Skip + Model.Messages.Count) / @Model.TotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>
								@if (Model.HasNext) {
										<a  asp-action="Chat" asp-route-id="@Model.Conversation.Id" asp-route-skip="@Model.NextSkip">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 80)</a>
								} else {
										<button type="button"  disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 80)</button>
								}
						</nav>

						<!-- 送信フォーム -->
						<div>
								<form asp-action="SendMessage" method="post" enctype="multipart/form-data">
										@Html.AntiForgeryToken()
										<input type="hidden" name="conversationId" value="@Model.Conversation.Id" />

										<div>
											<textarea name="text" id="messageTextInput" rows="2"  placeholder="@SharedLocalizer["Message_InputPlaceholder"]" autofocus></textarea>
										</div>

										<div>
											<input type="file" name="imageFiles" id="messageImageInput" multiple accept=".jpg,.jpeg,.png,image/jpeg,image/png"  style="max-width: 250px;" />
											<button type="submit" id="sendMessageBtn"  disabled>
												🚀 @SharedLocalizer["Message_SendBtn"]
											</button>
										</div>
								</form>
						</div>
				</div>
		</div>
</div>

@section Scripts {
		<script>
				$(document).ready(function () {
					const container = document.getElementById('chatMessageContainer');
					if (container) {
						container.scrollTop = container.scrollHeight;
					}

					$('.timestamp[data-utc]').each(function () {
						var raw = $(this).data('utc');
						if (!raw) return;
						var dt = new Date(raw);
						if (isNaN(dt.getTime())) return;
						var datePart = dt.toLocaleDateString('ja-JP', {
							year: 'numeric',
							month: '2-digit',
							day: '2-digit'
						});
						var timePart = dt.toLocaleTimeString('ja-JP', {
							hour: '2-digit',
							minute: '2-digit',
							hour12: false
						});
						$(this).text(datePart + ' ' + timePart);
					});

					function updateSendButtonState() {
						var hasText = $('#messageTextInput').val().trim().length > 0;
						var hasFiles = $('#messageImageInput')[0] && $('#messageImageInput')[0].files.length > 0;
						$('#sendMessageBtn').prop('disabled', !(hasText || hasFiles));
					}

					$(document).on('input', '#messageTextInput', updateSendButtonState);
					$(document).on('change', '#messageImageInput', updateSendButtonState);

					updateSendButtonState();
				});
		</script>
}
