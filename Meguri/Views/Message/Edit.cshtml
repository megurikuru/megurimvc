@model Meguri.Models.MessageViewModels.EditMessageViewModel
@{
	ViewData["Title"] = SharedLocalizer["Common_Edit"];
}

<h2>✏️ @SharedLocalizer["Common_Edit"]</h2>

<div>
	<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
		<input type="hidden" asp-for="Id" />
		<input type="hidden" asp-for="ConversationId" />
		<div asp-validation-summary="ModelOnly"></div>

		<div>
			<label asp-for="Subject">@SharedLocalizer["Message_SubjectLabel"] <span>*</span></label>
			<input asp-for="Subject" required />
			<span asp-validation-for="Subject"></span>
		</div>

		<div>
			<label asp-for="Body">@SharedLocalizer["Message_InputPlaceholder"] <span>*</span></label>
			<textarea asp-for="Body" rows="4" required></textarea>
			<span asp-validation-for="Body"></span>
		</div>

		<div>
			<a asp-action="Details" asp-route-id="@Model.ConversationId">@SharedLocalizer["Common_Cancel"]</a>
			<button type="submit">@SharedLocalizer["Common_Save"]</button>
		</div>
	</form>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
