@model Meguri.ViewModels.Message.EditMessageViewModel
@{
	ViewData["Title"] = SharedLocalizer["Common_Edit"];
}

<article>
	<h2><img src="~/icons/square-pen.svg" class="icon" />@SharedLocalizer["Common_Edit"]</h2>
	<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
		<input type="hidden" asp-for="Id" />
		<input type="hidden" asp-for="ConversationId" />
		<div asp-validation-summary="ModelOnly"></div>

		<div class="attribute-wrap">
			<label asp-for="Subject">@SharedLocalizer["Message_OptionalSubject"]</label>
			<input asp-for="Subject" class="form-control" />
			<span asp-validation-for="Subject"></span>
		</div>

		<div class="attribute-wrap">
			<label asp-for="Body">@SharedLocalizer["Message_InputPlaceholder"] <span>*</span></label>
			@{
				var editMessageMarkdownEditor = new MarkdownEditorViewModel {
					InputId = "Body",
					InputName = "Body",
					Value = Model.Body,
					Placeholder = SharedLocalizer["Message_TextPlaceholder"].Value,
					Rows = 5,
					Required = true,
					ToggleInputId = "UseMarkdown",
					ToggleInputName = "UseMarkdown",
					UseMarkdown = Model.UseMarkdown
				};
			}
			<partial name="_MarkdownEditor" model="editMessageMarkdownEditor" />
			<span asp-validation-for="Body"></span>
		</div>

		<div class="button-wrap">
			<a asp-action="Details" asp-route-id="@Model.ConversationId" class="button-like">@SharedLocalizer["Common_Cancel"]</a>
			<button type="submit">@SharedLocalizer["Common_Save"]</button>
		</div>
	</form>
</article>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}
