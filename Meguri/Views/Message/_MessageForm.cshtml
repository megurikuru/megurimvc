@model Meguri.ViewModels.Message.MessageRoomViewModel
<!-- 新規メッセージと返信で共用する送信フォーム -->
<div class="message-composer">
	@if (TempData["Error"] is string messageError && !string.IsNullOrEmpty(messageError)) {
		<div role="alert">
			<ul><li>@messageError</li></ul>
		</div>
	}
	<form asp-action="SendMessage" method="post" enctype="multipart/form-data" autocomplete="off">
		@Html.AntiForgeryToken()
		<input type="hidden" name="conversationId" value="@Model.Conversation.Id" />
		@* 返信ボタンで返信先IDと案内を設定し、取り消すとIDを空にして通常の投稿へ戻す。 *@
		<input type="hidden" id="parentMessageId" name="parentMessageId" value="" autocomplete="off" />
		<div id="chatReplyNotice" class="message-reply-notice" hidden role="status">
			<div><strong id="chatReplyLabel"></strong><span id="chatReplyPreview" class="message-preview-text"></span></div>
			<button type="button" class="btn-sm" data-cancel-message-reply aria-label="@SharedLocalizer["Message_CancelReply"]" title="@SharedLocalizer["Message_CancelReply"]">×</button>
		</div>
		@* 本文入力を中心にするため、任意の件名と画像添付は必要なときだけ展開する。 *@
		<details class="message-disclosure">
			<summary>@SharedLocalizer["Message_OptionalSubject"]</summary>
			<input type="text" class="form-control" id="messageSubject" name="subject" aria-label="@SharedLocalizer["Message_SubjectLabel"]" />
		</details>
		<div class="attribute-wrap">
			@{
				var replyMarkdownEditor = new MarkdownEditorViewModel {
					InputId = "messageText",
					InputName = "text",
					Placeholder = SharedLocalizer["Message_TextPlaceholder"].Value,
					AriaLabel = SharedLocalizer["Message_TextPlaceholder"].Value,
					Rows = 3,
					Required = true,
					ToggleInputId = "messageUseMarkdown",
					ToggleInputName = "useMarkdown",
					UseMarkdown = false
				};
			}
			<partial name="_MarkdownEditor" model="replyMarkdownEditor" />
		</div>
		@{
			var chatImageUpload = new FileUploadViewModel {
				InputId = "chatImageFiles",
				InputName = "imageFiles",
				LabelText = SharedLocalizer["Message_ImageAttachLabel"].Value,
				MaxImages = 16,
				ShowCount = true,
				PreviewContainerId = "chatImagePreviewContainer",
				CountDisplayId = "chatImageCountDisplay",
				UseDisclosure = true
			};
		}
		<partial name="_FileUpload" model="chatImageUpload" />
		<div class="button-wrap">
			<button type="submit" class="btn-block">@SharedLocalizer["Message_SendBtn"]</button>
		</div>
	</form>
</div>