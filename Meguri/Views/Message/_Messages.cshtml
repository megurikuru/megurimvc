@model Meguri.ViewModels.Message.MessageRoomViewModel
@using Meguri.Extensions
@{
	// 表示中のメッセージから返信先や祖先をIDで参照する。
	var messagesById = Model.Messages.ToDictionary(m => m.Id);
	// 返信先の表示名にも、不明ユーザー・退会済みユーザーの表記を適用する。
	string SenderName(Message message) => message.Sender == null
		? SharedLocalizer["Common_UnknownUser"].Value
		: message.Sender.UserName + (message.Sender.IsWithdrawn ? "(" + SharedLocalizer["Common_WithdrawnUser"].Value + ")" : "");
	// 引用は本文・件名・添付の順に選び、削除済みの内容は表示しない。
	string Preview(Message message) => message.IsDeleted ? SharedLocalizer["Message_Deleted"].Value
		: !string.IsNullOrWhiteSpace(message.Body) ? new string(message.Body.Take(80).ToArray())
		: !string.IsNullOrWhiteSpace(message.Subject) ? new string(message.Subject.Take(80).ToArray())
		: SharedLocalizer["Message_ImageAttachLabel"].Value;

	// ルートメッセージ単位でスレッドをグループ化する。
	var threads = new List<List<Message>>();
	foreach (var m in Model.Messages) {
		var isRoot = !m.ParentMessageId.HasValue || !messagesById.ContainsKey(m.ParentMessageId.Value);
		if (isRoot || threads.Count == 0) {
			threads.Add(new List<Message>());
		}
		threads[^1].Add(m);
	}
}

@* コントローラーで親子順に並べたメッセージをスレッド単位で表示する。 *@
<div id="messageContainer">
	@if (!Model.Messages.Any()) {
		<p>@SharedLocalizer["Message_NoMessagesForDate"]</p>
	} else {
		@foreach (var thread in threads) {
			<div class="message-thread">
				@foreach (var msg in thread) {
					var isMine = msg.SenderId == Model.CurrentUserId; // 自分の投稿かどうか
					var replyParent = msg.ParentMessageId.HasValue ? messagesById.GetValueOrDefault(msg.ParentMessageId.Value) : null;
					var replyLabel = string.Format(SharedLocalizer["Message_ReplyToFormat"].Value, SenderName(msg));
					// 祖先を最大3段までたどって字下げクラスを選ぶ。
					var depth = 0;
					var parentId = msg.ParentMessageId;
					while (parentId.HasValue && depth < 3) {
						var parent = messagesById.GetValueOrDefault(parentId.Value);
						if (parent == null) { break; }
						depth++;
						parentId = parent.ParentMessageId;
					}
					var indentClass = depth > 0 ? $"message-indent-{depth}" : null;
					var messageBoxClass = isMine ? "message-box is-mine" : "message-box";
					<div id="message-@msg.Id" class="message-item @indentClass @(msg.ParentMessageId.HasValue ? "message-reply" : "message-root")">
						<div class="@messageBoxClass">
							<div class="message-header">
								@if (!isMine) {
									<div class="message-sender">
										<img src="~/icons/user.svg" class="icon" alt="" />
										@if (msg.Sender == null) {
											@SharedLocalizer["Common_UnknownUser"].Value
										} else if (msg.Sender.IsWithdrawn) {
											@(msg.Sender.UserName + "(" + SharedLocalizer["Common_WithdrawnUser"].Value + ")")
										} else {
											<text>
												@if (!msg.Sender.IsProfilePublic && User.Identity?.IsAuthenticated != true) {
													@msg.Sender.UserName
												} else {
													<a asp-controller="Profile" asp-action="Details" asp-route-id="@msg.Sender.UserName">@msg.Sender.UserName</a>
												}
											</text>
										}
									</div>
								}
								@* UTC日時をJavaScriptで端末のローカル日時（年月日・時分）に変換する。 *@
								<time class="local-time message-time" datetime="@msg.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")" data-format="datetime">@msg.CreatedAt.ToString("yyyy/MM/dd HH:mm") UTC</time>
							</div>
							@* 返信先が同じページにある場合は、引用から元のメッセージへ移動できる。 *@
							@if (replyParent != null) {
								<a href="#message-@replyParent.Id" class="message-reply-preview">
									<span class="message-reply-target">@string.Format(SharedLocalizer["Message_ReplyToFormat"].Value, SenderName(replyParent))</span>
									<span class="message-preview-text">@Preview(replyParent)</span>
								</a>
							}
							@if (msg.IsDeleted) {
								<div><em>@SharedLocalizer["Message_Deleted"]</em></div>
							}
							@* 返信元と同じ件名や「Re:」付きの重複件名は、返信先の引用に役割を寄せて省略する。 *@
							@if (!msg.IsDeleted && !string.IsNullOrEmpty(msg.Subject) && (replyParent == null || msg.Subject != "Re: " + replyParent.Subject && msg.Subject != replyParent.Subject)) {
								<div class="message-subject"><strong>@msg.Subject</strong></div>
							}
							@* メッセージ本文 *@
							@if (!msg.IsDeleted && !string.IsNullOrEmpty(msg.Body)) {
								<div class="chat-message-body">@msg.Body</div>
							}
							@if (!msg.IsDeleted && msg.MessageImages.Any()) {
								<div class="message-images">
									@foreach (var mi in msg.MessageImages.OrderBy(x => x.DisplayOrder)) {
										<a href="/Image/File/@mi.ImageId" target="_blank">
											<img src="/Image/File/@mi.ImageId" class="message-image" alt="@SharedLocalizer["Message_AttachmentAlt"]" loading="lazy" />
										</a>
									}
								</div>
							}
							<div class="message-actions">
								@if (User.Identity?.IsAuthenticated == true) {
									<button type="button" class="btn-sm" data-reply-label="@replyLabel" data-reply-preview="@Preview(msg)" data-reply-id="@msg.Id"><img src="~/icons/reply.svg" class="icon" alt="" />@SharedLocalizer["Message_ReplyBtn"]</button>
								}
								@if (!msg.IsDeleted) {
									@* 編集・削除は自分の投稿のみ表示し、リアクション追加とともにメニューへまとめる。 *@
									<details class="chat-more-actions">
										<summary aria-label="@SharedLocalizer["Message_MoreActions"]" title="@SharedLocalizer["Message_MoreActions"]">…</summary>
										<div class="chat-actions-panel">
											@if (isMine) {
												<div class="inline-actions">
													<a asp-action="Edit" asp-route-id="@msg.Id" class="button-like btn-sm">@SharedLocalizer["Common_Edit"]</a>
													<form asp-action="Delete" asp-route-id="@msg.Id" method="post" data-confirm="@SharedLocalizer["Common_ConfirmDelete"]">
														<button type="submit" class="btn-sm">@SharedLocalizer["Common_Delete"]</button>
													</form>
												</div>
											}
											<div>@SharedLocalizer["Message_ReactionBtn"]</div>
											<partial name="_ReactionButtons" model='("Message", msg.Id, msg.Reactions.AsEnumerable())' />
										</div>
									</details>
								}
							</div>
						</div>
					</div>
				}
			</div>
		}
	}
</div>