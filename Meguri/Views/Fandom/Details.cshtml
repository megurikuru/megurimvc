@model Meguri.Models.Fandom
@{
		ViewData["Title"] = Model.Name;
		bool isJoined = ViewBag.IsJoined is true;
		var fandomPosts = ViewBag.FandomPosts as List<Meguri.Models.Post> ?? new List<Meguri.Models.Post>();
}

<div class="card shadow-sm border-0 mb-4 bg-body-tertiary">
		<div class="card-body p-4">
				<!-- パンくず / 親界隈 -->
				<nav aria-label="breadcrumb" class="mb-2">
						<ol class="breadcrumb mb-0">
								<li class="breadcrumb-item"><a asp-action="Index">@SharedLocalizer["Fandom_Title"]</a></li>
								@if (ViewBag.Ancestors is List<Meguri.Models.Fandom> ancestors && ancestors.Count > 0) {
										@foreach (var ancestor in ancestors) {
												<li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@ancestor.Id">@ancestor.Name</a></li>
										}
								} else if (Model.ParentFandom != null) {
										<li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ParentFandom.Id">@Model.ParentFandom.Name</a></li>
								}
								<li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
						</ol>
				</nav>
				<div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
						<div>
								<h2 class="fw-bold mb-1">@Model.Name</h2>
								<div class="text-body-secondary small icon-wrap">
										<img src="~/icons/users.svg" class="lucide-icons me-2 icon-sm" /> @string.Format(SharedLocalizer["Fandom_MembersCount"].Value, Model.FandomUsers.Count)
										&nbsp;|&nbsp;
										<img src="~/icons/gallery-vertical-end.svg" class="lucide-icons me-2 icon-md" /> @string.Format(SharedLocalizer["Fandom_PostsCount"].Value, (int)(ViewBag.FandomPostsTotalCount ?? 0))
								</div>
						</div>

						<div class="d-flex gap-2">
								@if (isJoined) {
										<form asp-action="Leave" asp-route-id="@Model.Id" method="post">
												@Html.AntiForgeryToken()
												<button type="submit" class="btn btn-outline-danger">
														@SharedLocalizer["Fandom_Leave"]
												</button>
										</form>
								} else {
										<form asp-action="Join" asp-route-id="@Model.Id" method="post">
												@Html.AntiForgeryToken()
												<button type="submit" class="btn btn btn-outline-primary d-flex align-items-center">
														<img src="~/icons/plus.svg" class="lucide-icons me-2" /> @SharedLocalizer["Fandom_Join"]
												</button>
										</form>
								}

								<a asp-controller="Post" asp-action="Create" asp-route-fandomId="@Model.Id" class="btn btn-success">
										✏️ @SharedLocalizer["Post_CreateNew"]
								</a>
						</div>
				</div>

				<!-- 子界隈一覧 -->
				@if (Model.ChildFandoms.Any()) {
						<div class="mt-4 pt-3 border-top">
								<h6 class="text-body-secondary fw-bold mb-2">📂 @SharedLocalizer["Fandom_ChildFandoms"]</h6>
								<div class="d-flex flex-wrap gap-2">
										@foreach (var child in Model.ChildFandoms) {
												<a asp-action="Details" asp-route-id="@child.Id" class="btn btn-outline-secondary btn-sm rounded-pill">
														@child.Name (@child.Posts.Count)
												</a>
										}
								</div>
						</div>
				}
		</div>
</div>

<!-- 所属投稿一覧 -->
<div class="row g-4">
		<div class="col-lg-8">
				<div class="d-flex justify-content-between align-items-center mb-3">
						<h4 class="fw-bold mb-0">📝 @SharedLocalizer["Fandom_Posts"]</h4>
						<a asp-controller="Post" asp-action="Create" asp-route-fandomId="@Model.Id" class="btn btn-sm btn-outline-primary">
								@SharedLocalizer["Post_CreateNew"]
						</a>
				</div>

				@if (!fandomPosts.Any()) {
						<div class="card p-4 text-center text-body-secondary">
								<p class="mb-0">この界隈にはまだ投稿がありません。</p>
						</div>
				}
				else {
						<div class="d-flex flex-column gap-3">
								@foreach (var post in fandomPosts) {
										<div class="card shadow-sm border-0">
												<div class="card-body">
														<div class="d-flex justify-content-between align-items-center mb-2">
																<span class="badge bg-secondary">👤 @(post.User?.UserName ?? "User")</span>
																<small class="text-body-secondary">@post.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
														</div>
														<h5 class="card-title">
																<a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="text-decoration-none text-body fw-bold">
																		@post.Name
																</a>
														</h5>
														<p class="card-text text-secondary mb-2" style="white-space: pre-line;">
																@(post.Text.Length > 100 ? post.Text.Substring(0, 100) + "..." : post.Text)
														</p>

														@if (post.PostImages.Any()) {
																<div class="d-flex gap-2 overflow-auto mb-2 py-1">
																		@foreach (var pi in post.PostImages.OrderBy(x => x.DisplayOrder).Take(3)) {
																				<a asp-controller="Image" asp-action="Details" asp-route-id="@pi.ImageId">
																						<img src="/Image/File/@pi.ImageId" class="rounded" style="width: 70px; height: 70px; object-fit: cover;" alt="@pi.Image.Name" />
																				</a>
																		}
																</div>
														}

														<!-- タグ -->
														@if (post.PostTags.Any()) {
																<div class="mb-2">
																		@foreach (var pt in post.PostTags) {
																				var tagText = pt.TagConcept?.Tags?.FirstOrDefault()?.TagText;
																				if (!string.IsNullOrEmpty(tagText)) {
																						<span class="tag-badge">#@tagText</span>
																				}
																		}
																</div>
														}

														<div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top small text-body-secondary">
																<span>💬 @post.CommentCount コメント</span>
																<span>❤️ @post.Reactions.Count リアクション</span>
														</div>
												</div>
										</div>
								}
						</div>
				}
		</div>

		@{
			var fpHasPrevious = ViewBag.FandomPostsHasPrevious as bool? ?? false;
			var fpHasNext = ViewBag.FandomPostsHasNext as bool? ?? false;
			var fpTotalCount = ViewBag.FandomPostsTotalCount as int? ?? 0;
			var fpSkip = ViewBag.FandomPostsSkip as int? ?? 0;
			var fpPreviousSkip = ViewBag.FandomPostsPreviousSkip as int? ?? 0;
			var fpNextSkip = ViewBag.FandomPostsNextSkip as int? ?? 0;
			var fpCount = fandomPosts.Count;
		}
		@if (fpTotalCount > 0) {
			<nav class="d-flex justify-content-between align-items-center py-2 mt-3 border-top px-1">
				@if (fpHasPrevious) {
					<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id" asp-route-skip="@fpPreviousSkip">← 前の40件</a>
				} else {
					<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>← 前の40件</button>
				}
				<span class="small text-body-secondary">@(fpSkip + 1) - @(fpSkip + fpCount) / @fpTotalCount 件</span>
				@if (fpHasNext) {
					<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id" asp-route-skip="@fpNextSkip">次の40件 →</a>
				} else {
					<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>次の40件 →</button>
				}
			</nav>
		}
	</div>

	<!-- サイドバー：参加ユーザー -->
	<div class="col-lg-4">
				<div class="card shadow-sm border-0">
						<div class="card-header bg-body-tertiary fw-bold">
								👥 参加メンバー (@Model.FandomUsers.Count)
						</div>
						<div class="card-body">
								@if (!Model.FandomUsers.Any()) {
										<p class="text-body-secondary small mb-0">まだ参加メンバーはいません。</p>
								} else {
										<div class="d-flex flex-wrap gap-2">
												@foreach (var fu in Model.FandomUsers.Take(20)) {
														<span class="badge bg-body-secondary border p-2">
																👤 @(fu.User?.UserName ?? "User")
														</span>
												}
										</div>
								}
						</div>
				</div>
		</div>
</div>
