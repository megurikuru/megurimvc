@model Meguri.Models.Fandom
@{
	ViewData["Title"] = Model.Name;
	bool isJoined = ViewBag.IsJoined is true;
	var fandomPosts = ViewBag.FandomPosts as List<Meguri.Models.Post> ?? new List<Meguri.Models.Post>();
}


<!-- パンくずリスト -->
<div>
	<a asp-action="Index">@SharedLocalizer["Fandom_Title"]</a>
	@if (ViewBag.Ancestors is List<Meguri.Models.Fandom> ancestors && ancestors.Count > 0) {
		@foreach (var ancestor in ancestors) {
			<span>/</span>
			<a asp-action="Details" asp-route-id="@ancestor.Id">@ancestor.Name</a>
		}
	} else if (Model.ParentFandom != null) {
		<span>/</span>
		<a asp-action="Details" asp-route-id="@Model.ParentFandom.Id">@Model.ParentFandom.Name</a>
	}
	<span>/</span>
	<span>@Model.Name</span>
</div>

<!-- 界隈メニュー -->
<nav class="nav-grid">
	<ul>
		<li>
			@if (isJoined) {
				<form asp-action="Leave" asp-route-id="@Model.Id" method="post">
					@Html.AntiForgeryToken()
					<button type="submit">@SharedLocalizer["Fandom_Leave"]</button>
				</form>
			} else {
				<form asp-action="Join" asp-route-id="@Model.Id" method="post">
					@Html.AntiForgeryToken()
					<button type="submit">@SharedLocalizer["Fandom_Join"]</button>
				</form>
			}
		</li>
		<li>
			<a asp-controller="Post" asp-action="Create" asp-route-fandomId="@Model.Id" class="button-like">
				@SharedLocalizer["Post_CreateNew"]
			</a>
		</li>
	</ul>
</nav>

<!-- ファイルマネージャー風一覧：子界隈（フォルダ）＋投稿（ファイル） -->
<div>
	<div>
		@if (!Model.ChildFandoms.Any() && !fandomPosts.Any()) {
			<div>@SharedLocalizer["Fandom_NoPosts"]</div>
		} else {
			@foreach (var child in Model.ChildFandoms) {
				<div>
					<img src="~/icons/folder.svg" />
					<a asp-action="Details" asp-route-id="@child.Id">@child.Name</a>
				</div>
			}

			@foreach (var post in fandomPosts) {
				var thumb = post.PostImages.OrderBy(x => x.DisplayOrder).FirstOrDefault();
				<div>
					<a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">
						<div class="icon-wrap">
							@if (thumb != null) {
								<img src="/Image/File/@thumb.ImageId" alt="@thumb.Image.Name" />
							} else {
								<img src="~/icons/file-text.svg" />
							}
							<span>@post.Name</span>
						</div>
					</a>
				</div>
			}
		}
	</div>

	<div>
		<img src="~/icons/users.svg" /> @string.Format(SharedLocalizer["Fandom_MembersCount"].Value, Model.FandomUsers.Count)
		&nbsp;|&nbsp;
		<img src="~/icons/gallery-vertical-end.svg" /> @string.Format(SharedLocalizer["Fandom_PostsCount"].Value, (int)(ViewBag.FandomPostsTotalCount ?? 0))
	</div>

	@{
		var fpHasPrevious = ViewBag.FandomPostsHasPrevious as bool? ?? false;
		var fpHasNext = ViewBag.FandomPostsHasNext as bool? ?? false;
		var fpTotalCount = ViewBag.FandomPostsTotalCount as int? ?? 0;
		var fpSkip = ViewBag.FandomPostsSkip as int? ?? 0;
		var fpPreviousSkip = ViewBag.FandomPostsPreviousSkip as int? ?? 0;
		var fpNextSkip = ViewBag.FandomPostsNextSkip as int? ?? 0;
		var fpCount = fandomPosts.Count;
	}
	@if (fpTotalCount > 0) {
		<nav>
			@if (fpHasPrevious) {
				<a asp-action="Details" asp-route-id="@Model.Id" asp-route-skip="@fpPreviousSkip">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
			} else {
				<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
			}
			<span>@string.Format(SharedLocalizer["Pagination_RangeFormat"].Value, fpSkip + 1, fpSkip + fpCount, fpTotalCount)</span>
			@if (fpHasNext) {
				<a asp-action="Details" asp-route-id="@Model.Id" asp-route-skip="@fpNextSkip">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
			} else {
				<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
			}
		</nav>
	}
</div>
