@model Meguri.ViewModels.Fandom.FandomDetailsViewModel
@{
	ViewData["Title"] = Model.Fandom.Name;
	var breadcrumbs = new List<BreadcrumbItemViewModel>();
	if (Model.Ancestors.Count > 0) {
		foreach (var ancestor in Model.Ancestors) {
			breadcrumbs.Add(new(ancestor.Name, Url.Action("Details", "Fandom", new { id = ancestor.Id })));
		}
	} else if (Model.Fandom.ParentFandom != null) {
		breadcrumbs.Add(new(Model.Fandom.ParentFandom.Name, Url.Action("Details", "Fandom", new { id = Model.Fandom.ParentFandom.Id })));
	}
	breadcrumbs.Add(new(Model.Fandom.Name));
}

<div>
	<!-- パンくずリスト -->
	<partial name="_Breadcrumb" model="breadcrumbs" />
	<!-- 界隈メタ情報 -->
	<div class="fandom-meta">
		<div>
			<img src="~/icons/users.svg" class="icon" /><span>@string.Format(SharedLocalizer["Fandom_MembersCount"].Value, Model.Fandom.FandomUsers.Count)</span>
		</div>
		<div>
			<span>@string.Format(SharedLocalizer["Fandom_PostsCount"].Value, Model.FandomPostsDescendantCount)</span>
		</div>
	</div>

	<!-- 界隈メニュー -->
	@if (Model.Fandom.Id != 1) {
		<nav class="nav-grid">
			<ul>
				<li>
					@if (Model.IsJoined) {
						<form asp-action="Leave" asp-route-id="@Model.Fandom.Id" method="post">
							@Html.AntiForgeryToken()
							<button type="submit">@SharedLocalizer["Fandom_Leave"]</button>
						</form>
					} else {
						<form asp-action="Join" asp-route-id="@Model.Fandom.Id" method="post">
							@Html.AntiForgeryToken()
							<button type="submit">@SharedLocalizer["Fandom_Join"]</button>
						</form>
					}
				</li>
				@if (Model.IsJoined) {
					<li>
						<a asp-controller="Post" asp-action="Create" asp-route-fandomId="@Model.Fandom.Id" class="button-like">
							@SharedLocalizer["Post_CreateNew"]
						</a>
					</li>
				}
			</ul>
		</nav>
	}
</div>

<partial name="_Finder" model="new FinderViewModel { ParentFandomId = Model.Fandom.ParentFandomId, ChildFandoms = Model.Fandom.ChildFandoms, Posts = Model.FandomPosts }" />

<!-- ページネーション -->
<div>
	<partial name="_Pagination" model="Model.Pagination" />
</div>
