@model Meguri.Models.Fandom
@{
	ViewData["Title"] = Model.Name;
	bool isJoined = ViewBag.IsJoined is true;
	var fandomPosts = ViewBag.FandomPosts as List<Meguri.Models.Post> ?? new List<Meguri.Models.Post>();
	var breadcrumbs = new List<Meguri.Models.BreadcrumbItem> {
		new(SharedLocalizer["Fandom_Title"].Value, Url.Action("Index", "Fandom"))
	};
	if (ViewBag.Ancestors is List<Meguri.Models.Fandom> ancestors && ancestors.Count > 0) {
		foreach (var ancestor in ancestors) {
			breadcrumbs.Add(new(ancestor.Name, Url.Action("Details", "Fandom", new { id = ancestor.Id })));
		}
	} else if (Model.ParentFandom != null) {
		breadcrumbs.Add(new(Model.ParentFandom.Name, Url.Action("Details", "Fandom", new { id = Model.ParentFandom.Id })));
	}
	breadcrumbs.Add(new(Model.Name));
	var pager = new Meguri.ViewModels.PaginationViewModel {
		Action = "Details",
		HasPrevious = ViewBag.FandomPostsHasPrevious as bool? ?? false,
		HasNext = ViewBag.FandomPostsHasNext as bool? ?? false,
		TotalCount = ViewBag.FandomPostsTotalCount as int? ?? 0,
		Skip = ViewBag.FandomPostsSkip as int? ?? 0,
		PreviousSkip = ViewBag.FandomPostsPreviousSkip as int? ?? 0,
		NextSkip = ViewBag.FandomPostsNextSkip as int? ?? 0,
		CurrentCount = fandomPosts.Count,
		RouteValues = new Dictionary<string, string> {
			["id"] = Model.Id.ToString()
		}
	};
}

<!-- パンくずリスト -->
<partial name="_Breadcrumb" model="breadcrumbs" />

<!-- 界隈メタ情報 -->
<div class="fandom-meta">
	<div>
		<img src="~/icons/users.svg" class="icon"/><span>参加者：@Model.FandomUsers.Count</span>
	</div>
	<div>
		<img src="~/icons/files.svg" class="icon"/><span>投稿：@(ViewBag.FandomPostsTotalCount as int? ?? 0)</span>
	</div>
</div>

<!-- 界隈メニュー -->
<nav class="nav-grid">
	<ul>
		<li>
			@if (isJoined) {
				<form asp-action="Leave" asp-route-id="@Model.Id" method="post">
					@Html.AntiForgeryToken()
					<button type="submit">@SharedLocalizer["Fandom_Leave"]</button>
				</form>
			} else {
				<form asp-action="Join" asp-route-id="@Model.Id" method="post">
					@Html.AntiForgeryToken()
					<button type="submit">@SharedLocalizer["Fandom_Join"]</button>
				</form>
			}
		</li>
		<li>
			<a asp-controller="Post" asp-action="Create" asp-route-fandomId="@Model.Id" class="button-like">
				@SharedLocalizer["Post_CreateNew"]
			</a>
		</li>
	</ul>
</nav>

<!-- ファインダー：子界隈（フォルダ）＋投稿（ファイル） -->
<div>
	<div>
		<!-- フォルダー  -->
		@foreach (var child in Model.ChildFandoms) {
			<a asp-action="Details" asp-route-id="@child.Id" class="finder-item-wrap">
				<img src="~/icons/folder.svg" class="icon"/>
				<span class="name">@child.Name</span>
			</a>
		}
		<!-- 投稿  -->
		@foreach (var post in fandomPosts) {
			var thumb = post.PostImages.OrderBy(x => x.DisplayOrder).FirstOrDefault();
			<a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="finder-item-wrap">
				<!-- 画像がある場合-->
				@if (thumb != null) {
					<img src="~/icons/image.svg" class="icon">
					<span class="name with-thumb">@post.Name</span>
					<div class="thumb-wrap">
						<img src="/Image/File/@thumb.ImageId" alt="@thumb.Image.Name" class="thumb"/>
					</div>
				<!-- 画像がない場合-->
				} else {
					<img src="~/icons/file-text.svg" class="icon" />
					<span class="name">@post.Name</span>
				}
			</a>
		}
	</div>
</div>

<!-- ページネーション -->	
<div>
	<partial name="_Pagination" model="pager" />
</div>
