@model IEnumerable<Meguri.Models.Fandom>
@{
	ViewData["Title"] = SharedLocalizer["Fandom_Title"];
	var joinedFandomIds = ViewBag.JoinedFandomIds as HashSet<int> ?? new HashSet<int>();
	var topLevelFandoms = Model.Where(f => f.ParentFandomId == null).OrderBy(f => f.Id).ToList();
}

<h2>@SharedLocalizer["Fandom_Title"]</h2>

<div id="fandom-list">
	@foreach (var parent in topLevelFandoms) {
		var isParentJoined = joinedFandomIds.Contains(parent.Id);
		var childFandoms = Model.Where(f => f.ParentFandomId == parent.Id).ToList();
		
			<div class="space-between-wrap">
				<div>		
					<a asp-action="Details" asp-route-id="@parent.Id">@parent.Name</a>
					<span>
					@if (isParentJoined) {
						<span>✓</span>
					}
					</span>
				</div>
				<div>	
					<small>@parent.FandomUsers.Count 人</small>
					<small>@parent.Posts.Count 投稿</small>
				</div>
			</div>

		@if (childFandoms.Any()) {
			@foreach (var child in childFandoms) {
				var isChildJoined = joinedFandomIds.Contains(child.Id);
				<div class="space-between-wrap">
					<div>
						<a asp-action="Details" asp-route-id="@child.Id">@child.Name</a>
						@if (isChildJoined) {
							<span>✓</span>
						}
					</div>
					<div>
						<small>@child.FandomUsers.Count 人</small>
						<small>@child.Posts.Count 件</small>					
					</div>
				</div>
			}
		}
	}
</div>


@{
	var fHasPrevious = ViewBag.HasPrevious as bool? ?? false;
	var fHasNext = ViewBag.HasNext as bool? ?? false;
	var fTotalCount = ViewBag.TotalCount as int? ?? 0;
	var fSkip = ViewBag.Skip as int? ?? 0;
	var fPreviousSkip = ViewBag.PreviousSkip as int? ?? 0;
	var fNextSkip = ViewBag.NextSkip as int? ?? 0;
	var fCount = Model.Count();
}
@if (fTotalCount > 0) {
	<nav class="pagination">
		@if (fHasPrevious) {
			<a asp-action="Index" asp-route-skip="@fPreviousSkip">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
		}
		<span>@string.Format(SharedLocalizer["Pagination_RangeFormat"].Value, fSkip + 1, fSkip + fCount, fTotalCount)</span>
		@if (fHasNext) {
			<a asp-action="Index" asp-route-skip="@fNextSkip">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
		}
	</nav>
}
