@model IEnumerable<Meguri.Models.Fandom>
@{
		ViewData["Title"] = SharedLocalizer["Fandom_Title"];
		var joinedFandomIds = ViewBag.JoinedFandomIds as HashSet<int> ?? new HashSet<int>();
		var topLevelFandoms = Model.Where(f => f.ParentFandomId == null).OrderBy(f => f.Id).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
		<div>
				<h2 class="fw-bold mb-1">🏛️ @SharedLocalizer["Fandom_Title"]</h2>
				<p class="text-body-secondary mb-0">@SharedLocalizer["Fandom_SubTitle"]</p>
		</div>
		<a asp-action="Create" class="btn btn-primary">
				➕ @SharedLocalizer["Fandom_CreateNew"]
		</a>
</div>

<div class="alert alert-info py-2 mb-4 d-flex align-items-center">
		<span class="me-2">💡</span>
		<span>@SharedLocalizer["Fandom_CascadeNote"]</span>
</div>

<div class="row g-4">
		@foreach (var parent in topLevelFandoms)
		{
				var isParentJoined = joinedFandomIds.Contains(parent.Id);
				var childFandoms = Model.Where(f => f.ParentFandomId == parent.Id).ToList();

				<div class="col-lg-6">
						<div class="card h-100 shadow-sm border-0">
								<div class="card-body">
										<div class="d-flex justify-content-between align-items-start mb-2">
												<div>
														<h4 class="card-title fw-bold mb-1">
																<a asp-action="Details" asp-route-id="@parent.Id" class="text-decoration-none text-dark">
																		@parent.Name
																</a>
														</h4>
														<div class="small text-body-secondary">
																👥 @string.Format(SharedLocalizer["Fandom_MembersCount"].Value, parent.FandomUsers.Count)
																&nbsp;|&nbsp;
																📝 @string.Format(SharedLocalizer["Fandom_PostsCount"].Value, parent.Docs.Count)
														</div>
												</div>

												<div>
														@if (isParentJoined)
														{
																<form asp-action="Leave" asp-route-id="@parent.Id" method="post" class="d-inline">
																		@Html.AntiForgeryToken()
																		<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
																		<button type="submit" class="btn btn-sm btn-outline-success">
																				✓ @SharedLocalizer["Fandom_Joined"]
																		</button>
																</form>
														}
														else
														{
																<form asp-action="Join" asp-route-id="@parent.Id" method="post" class="d-inline">
																		@Html.AntiForgeryToken()
																		<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
																		<button type="submit" class="btn btn-sm btn-primary">
																				+ @SharedLocalizer["Fandom_Join"]
																		</button>
																</form>
														}
												</div>
										</div>

										<!-- 子界隈リスト -->
										@if (childFandoms.Any())
										{
												<div class="mt-3 pt-3 border-top">
														<h6 class="text-body-secondary small fw-bold mb-2">📂 @SharedLocalizer["Fandom_ChildFandoms"]</h6>
														<div class="d-flex flex-wrap gap-2">
																@foreach (var child in childFandoms)
																{
																		var isChildJoined = joinedFandomIds.Contains(child.Id);
																		<div class="border rounded-pill px-3 py-1 bg-light d-flex align-items-center gap-2 small">
																				<a asp-action="Details" asp-route-id="@child.Id" class="text-decoration-none text-dark fw-semibold">
																						@child.Name
																				</a>
																				@if (isChildJoined)
																				{
																						<span class="badge bg-success" style="font-size: 0.65rem;">参加中</span>
																				}
																				else
																				{
																						<form asp-action="Join" asp-route-id="@child.Id" method="post" class="d-inline">
																								@Html.AntiForgeryToken()
																								<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
																								<button type="submit" class="btn btn-link p-0 text-primary small text-decoration-none">
																										参加
																								</button>
																						</form>
																				}
																		</div>
																}
														</div>
												</div>
										}
								</div>
								<div class="card-footer bg-white border-0 pt-0 text-end">
										<a asp-action="Details" asp-route-id="@parent.Id" class="btn btn-sm btn-outline-secondary">
												@SharedLocalizer["Common_Details"] →
										</a>
								</div>
						</div>
				</div>
		}
</div>
