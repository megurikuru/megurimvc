@model IEnumerable<Meguri.Models.Fandom>
@{
		ViewData["Title"] = SharedLocalizer["Fandom_Title"];
		var joinedFandomIds = ViewBag.JoinedFandomIds as HashSet<int> ?? new HashSet<int>();
		var topLevelFandoms = Model.Where(f => f.ParentFandomId == null).OrderBy(f => f.Id).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
		<div>
		<h2 class="fw-bold mb-1 icon-wrap"><img src="~/icons/loader-pinwheel.svg" class="lucide-icons me-2" />@SharedLocalizer["Fandom_Title"]</h2>
				<p class="text-body-secondary mb-0">@SharedLocalizer["Fandom_SubTitle"]</p>
		</div>
</div>

<div class="row g-4">
		@foreach (var parent in topLevelFandoms) {
				var isParentJoined = joinedFandomIds.Contains(parent.Id);
				var childFandoms = Model.Where(f => f.ParentFandomId == parent.Id).ToList();

				<div class="col-lg-6">
						<div class="card h-100 shadow-sm border-0">
								<div class="card-body">
										<div class="d-flex justify-content-between align-items-start mb-2">
												<div>
														<h4 class="card-title fw-bold mb-1">
																<a asp-action="Details" asp-route-id="@parent.Id" class="text-decoration-none text-body">
																		@parent.Name
																</a>
														</h4>
														<div class="small text-body-secondary icon-wrap">
																<img src="~/icons/users.svg" class="lucide-icons me-2 icon-md" /> @string.Format(SharedLocalizer["Fandom_MembersCount"].Value, parent.FandomUsers.Count)
																&nbsp;|&nbsp;
																<img src="~/icons/gallery-vertical-end.svg" class="lucide-icons me-2 icon-md" /> @string.Format(SharedLocalizer["Fandom_PostsCount"].Value, parent.Posts.Count)
														</div>
												</div>

												<div>
														@if (isParentJoined) {
																<form asp-action="Leave" asp-route-id="@parent.Id" method="post" class="d-inline">
																		@Html.AntiForgeryToken()
																		<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
																		<button type="submit" class="btn btn-sm btn-outline-success">
																				✓ @SharedLocalizer["Fandom_Joined"]
																		</button>
																</form>
														}
														else {
																<form asp-action="Join" asp-route-id="@parent.Id" method="post" class="d-inline">
																		@Html.AntiForgeryToken()
																		<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
																		<button type="submit" class="btn btn-sm btn btn-outline-primary">
																				+ @SharedLocalizer["Fandom_Join"]
																		</button>
																</form>
														}
												</div>
										</div>

										<!-- 子界隈リスト -->
										@if (childFandoms.Any()) {
												<div class="mt-3 pt-3 border-top">
														<h6 class="text-body-secondary small fw-bold mb-2">📂 @SharedLocalizer["Fandom_ChildFandoms"]</h6>
														<div class="d-flex flex-wrap gap-2">
																@foreach (var child in childFandoms) {
																		var isChildJoined = joinedFandomIds.Contains(child.Id);
																		<div class="border rounded-pill px-3 py-1 bg-body-secondary d-flex align-items-center gap-2 small">
																				<a asp-action="Details" asp-route-id="@child.Id" class="text-decoration-none text-body fw-semibold">
																						@child.Name
																				</a>
																				@if (isChildJoined) {
																						<span class="badge bg-success-subtle text-success-emphasis" style="font-size: 0.65rem;">@SharedLocalizer["Fandom_JoinedBadge"]</span>
																				}
																				else {
																						<form asp-action="Join" asp-route-id="@child.Id" method="post" class="d-inline">
																								@Html.AntiForgeryToken()
																								<input type="hidden" name="returnUrl" value="@Context.Request.Path" />
																								<button type="submit" class="btn btn-link p-0 text-primary small text-decoration-none">
																										@SharedLocalizer["Fandom_JoinShort"]
																								</button>
																						</form>
																				}
																		</div>
																}
														</div>
												</div>
										}
								</div>
						</div>
				</div>
		}
</div>

@{
	var fHasPrevious = ViewBag.HasPrevious as bool? ?? false;
	var fHasNext = ViewBag.HasNext as bool? ?? false;
	var fTotalCount = ViewBag.TotalCount as int? ?? 0;
	var fSkip = ViewBag.Skip as int? ?? 0;
	var fPreviousSkip = ViewBag.PreviousSkip as int? ?? 0;
	var fNextSkip = ViewBag.NextSkip as int? ?? 0;
	var fCount = Model.Count();
}
@if (fTotalCount > 0) {
	<nav class="d-flex justify-content-between align-items-center py-2 mt-3 border-top px-1">
		@if (fHasPrevious) {
			<a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-skip="@fPreviousSkip">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
		} else {
			<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
		}
		<span class="small text-body-secondary">@string.Format(SharedLocalizer["Pagination_RangeFormat"].Value, fSkip + 1, fSkip + fCount, fTotalCount)</span>
		@if (fHasNext) {
			<a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-skip="@fNextSkip">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
		} else {
			<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
		}
	</nav>
}
