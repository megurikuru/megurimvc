@model Meguri.Models.Fandom
@{
		ViewData["Title"] = SharedLocalizer["Fandom_CreateNew"];
		var parentFandoms = ViewBag.ParentFandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
}

<div>
		<div>
				<div>
						<div>
								<h4 >🏛️ @SharedLocalizer["Fandom_CreateNew"]</h4>
						</div>
						<div>
								<form asp-action="Create" method="post">
										<div asp-validation-summary="ModelOnly" ></div>

										<div>
												<label asp-for="Name" >@SharedLocalizer["Fandom_Name"] <span >*</span></label>
												<input asp-for="Name"  placeholder="@SharedLocalizer["Fandom_NamePlaceholder"]" required />
												<span asp-validation-for="Name" ></span>
										</div>

										<div>
												<label asp-for="ParentFandomId" >@SharedLocalizer["Fandom_Parent"]</label>
												<select asp-for="ParentFandomId">
														<option value="">-- @SharedLocalizer["Fandom_NoParent"] --</option>
														@foreach (var p in parentFandoms) {
																<option value="@p.Id">@p.Name</option>
														}
												</select>
												<div >@SharedLocalizer["Fandom_ParentHelp"]</div>
										</div>

										<div>
												<a asp-action="Index" >@SharedLocalizer["Common_Back"]</a>
												<button type="submit" >@SharedLocalizer["Common_Create"]</button>
										</div>
								</form>
						</div>
				</div>
		</div>
</div>
