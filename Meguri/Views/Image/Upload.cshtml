@model Meguri.Models.ImageViewModels.ImageUploadViewModel
@{
		ViewData["Title"] = SharedLocalizer["Image_UploadTitle"];
		var fandoms = ViewBag.Fandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
}

<div>
		<div>
				<div>
						<div>
								<h4 >📤 @SharedLocalizer["Image_UploadTitle"]</h4>
						</div>
						<div>
								<form asp-action="Upload" method="post" enctype="multipart/form-data">
										<div asp-validation-summary="ModelOnly" ></div>

										<!-- ファイル選択 -->
										<div>
												<label asp-for="Files" >@SharedLocalizer["Image_SelectFiles"] <span >*</span></label>
												<input asp-for="Files" type="file" multiple  accept=".jpg,.jpeg,.png,image/jpeg,image/png" required id="imageFileInput" />
												<span asp-validation-for="Files" ></span>
												<div>
													@Html.Raw(SharedLocalizer["Image_FileFormatLine1"].Value)<br />
													@Html.Raw(SharedLocalizer["Image_FileFormatLine2"].Value)<br />
													@SharedLocalizer["Image_FileFormatLine3"]
												</div>
										</div>

										<!-- 投稿先界隈 -->
										<div>
												<label asp-for="FandomId" >@SharedLocalizer["Post_SelectFandom"]</label>
												<select asp-for="FandomId">
														<option value="">@string.Format(SharedLocalizer["Fandom_SelectOptionalFormat"].Value, SharedLocalizer["Fandom_Title"].Value)</option>
																@foreach (var f in fandoms) {
																		<option value="@f.Id">@f.Name @(f.ParentFandomId.HasValue ? SharedLocalizer["Fandom_ChildLabel"].Value : "")</option>
														}
												</select>
										</div>

										<!-- キャプション・タイトル -->
										<div>
												<label asp-for="Caption" >@SharedLocalizer["Image_Caption"]</label>
												<input asp-for="Caption"  placeholder="@SharedLocalizer["Image_CaptionPlaceholder"]" />
												<span asp-validation-for="Caption" ></span>
										</div>

										<!-- 説明・解説 -->
										<div>
												<label asp-for="Description" >@SharedLocalizer["Image_Description"]</label>
												<textarea asp-for="Description" rows="4"  placeholder="@SharedLocalizer["Image_DescriptionPlaceholder"]"></textarea>
												<span asp-validation-for="Description" ></span>
										</div>

										<!-- タグ入力コンポーネント (最大10個) -->
										<div>
												<div>
														<label >🏷️ @SharedLocalizer["Post_Tags"]</label>
														<span  id="tagCountDisplay">0/10</span>
												</div>
												<div>
														<input type="text" id="tagInput"  placeholder="@SharedLocalizer["Tag_SearchPlaceholder"]" />
														<button type="button"  onclick="TagManager.addTag($('#tagInput').val())">@SharedLocalizer["Common_Add"]</button>
												</div>
												<div id="tagSuggestions"  style="display:none; z-index:1000; max-height:200px; overflow-y:auto;"></div>

												<!-- 選択中タグ表示領域 -->
												<div id="selectedTagsContainer" ></div>
												<div id="hiddenTagsInputs"></div>
												<div >@SharedLocalizer["Post_TagsHint"]</div>
										</div>

										<!-- 公開設定 -->
										<div>
												<div>
													<div>
														<input asp-for="IsPublic"  type="checkbox" role="switch" />
														<label asp-for="IsPublic" >@SharedLocalizer["Post_Public"]</label>
													</div>
												</div>
												<div>
													<div>
														<input asp-for="IsSexual"  type="checkbox" role="switch" />
														<label asp-for="IsSexual" >@SharedLocalizer["Post_NSFW_Sexual"]</label>
													</div>
												</div>
												<div>
													<div>
														<input asp-for="IsViolence"  type="checkbox" role="switch" />
														<label asp-for="IsViolence" >@SharedLocalizer["Post_NSFW_Violence"]</label>
													</div>
												</div>
										</div>

										<div>
												<a asp-action="Index" >@SharedLocalizer["Common_Back"]</a>
												<button type="submit" >@SharedLocalizer["Common_Submit"]</button>
										</div>
								</form>
						</div>
				</div>
		</div>
</div>

				@section Scripts {
<script>
		const imageFileTooLargeMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["Image_FileTooLargeAlert"].Value));
		$(document).ready(function () {
				TagManager.init(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tags)));

				$('#imageFileInput').on('change', function () {
						const maxBytes = 5 * 1024 * 1024;
						for (let i = 0; i < this.files.length; i++) {
								if (this.files[i].size > maxBytes) {
										alert(imageFileTooLargeMessage.replace('{0}', this.files[i].name));
												this.value = '';
												break;
										}
								}
						});
				});
		</script>
}
