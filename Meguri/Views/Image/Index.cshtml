@model IEnumerable<Meguri.Models.Image>
@{
		ViewData["Title"] = SharedLocalizer["Image_GalleryTitle"];
		var currentTag = ViewBag.CurrentTag as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
		<div>
				<h2 class="fw-bold mb-1">🖼️ @SharedLocalizer["Image_GalleryTitle"]</h2>
				<p class="text-body-secondary mb-0">@SharedLocalizer["Image_SingleOrMultiple"]</p>
		</div>
		<a asp-action="Upload" class="btn btn btn-outline-primary">
				➕ @SharedLocalizer["Image_UploadTitle"]
		</a>
</div>

@if (!string.IsNullOrEmpty(currentTag)) {
		<div class="alert alert-info d-flex justify-content-between align-items-center py-2 mb-4">
				<span>#@currentTag の画像を表示中</span>
				<a asp-action="Index" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Common_All"]</a>
		</div>
}

@if (!Model.Any()) {
		<div class="card p-5 text-center text-body-secondary">
				<h4>@SharedLocalizer["Image_NoImages"]</h4>
				<div class="mt-3">
						<a asp-action="Upload" class="btn btn btn-outline-primary">@SharedLocalizer["Image_UploadTitle"]</a>
				</div>
		</div>
}
else {
		<div class="image-grid">
				@foreach (var item in Model) {
						<div class="card border-0 shadow-sm image-card position-relative">
								<a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
										<img src="/Image/File/@item.Id" alt="@item.Name" loading="lazy" />
								</a>
								<div class="position-absolute bottom-0 start-0 w-100 p-2 bg-dark bg-opacity-75 text-white small d-flex justify-content-between align-items-center gap-2">
										<span class="text-truncate me-1">@(string.IsNullOrEmpty(item.Caption) ? item.Name : item.Caption)</span>
										<div class="d-flex align-items-center gap-1 flex-shrink-0">
											@if (!item.IsPublic) {
												<span class="badge bg-warning text-dark">会員限定</span>
											}
											@if (item.IsSexual) {
												<span class="badge bg-danger">R-18</span>
											}
											@if (item.IsViolence) {
												<span class="badge bg-dark">R-18G</span>
											}
											<span class="badge bg-primary">❤️ @item.Reactions.Count</span>
										</div>
								</div>
						</div>
				}
		</div>
}

@{
	var imgHasPrevious = ViewBag.HasPrevious as bool? ?? false;
	var imgHasNext = ViewBag.HasNext as bool? ?? false;
	var imgTotalCount = ViewBag.TotalCount as int? ?? 0;
	var imgSkip = ViewBag.Skip as int? ?? 0;
	var imgPreviousSkip = ViewBag.PreviousSkip as int? ?? 0;
	var imgNextSkip = ViewBag.NextSkip as int? ?? 0;
	var imgCount = Model.Count();
}
@if (imgTotalCount > 0) {
	<nav class="d-flex justify-content-between align-items-center py-2 mt-3 border-top px-1">
		@if (imgHasPrevious) {
			<a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-skip="@imgPreviousSkip" asp-route-tag="@currentTag">← 前の40件</a>
		} else {
			<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>← 前の40件</button>
		}
		<span class="small text-body-secondary">@(imgSkip + 1) - @(imgSkip + imgCount) / @imgTotalCount 件</span>
		@if (imgHasNext) {
			<a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-skip="@imgNextSkip" asp-route-tag="@currentTag">次の40件 →</a>
		} else {
			<button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>次の40件 →</button>
		}
	</nav>
}
