@model IEnumerable<Meguri.Models.Image>
@{
		ViewData["Title"] = SharedLocalizer["Image_GalleryTitle"];
		var currentTag = ViewBag.CurrentTag as string;
}

<div>
		<div>
				<h2 >🖼️ @SharedLocalizer["Image_GalleryTitle"]</h2>
				<p >@SharedLocalizer["Image_SingleOrMultiple"]</p>
		</div>
		<a asp-action="Upload">
				➕ @SharedLocalizer["Image_UploadTitle"]
		</a>
</div>

@if (!string.IsNullOrEmpty(currentTag)) {
		<div>
				<span>@string.Format(SharedLocalizer["Image_ShowingTagFormat"].Value, currentTag)</span>
				<a asp-action="Index" >@SharedLocalizer["Common_All"]</a>
		</div>
}

@if (!Model.Any()) {
		<div>
				<h4>@SharedLocalizer["Image_NoImages"]</h4>
				<div>
						<a asp-action="Upload" >@SharedLocalizer["Image_UploadTitle"]</a>
				</div>
		</div>
}
else {
		<div>
				@foreach (var item in Model) {
						<div>
								<a asp-action="Details" asp-route-id="@item.Id">
										<img src="/Image/File/@item.Id" alt="@item.Name" />
								</a>
								<div>
										<span >@(string.IsNullOrEmpty(item.Caption) ? item.Name : item.Caption)</span>
										<div>
											@if (item.IsPublic) {
												<span >@SharedLocalizer["Image_PublicBadge"]</span>
											}
											@if (item.IsSexual) {
												<span >R-18</span>
											}
											@if (item.IsViolence) {
												<span >R-18G</span>
											}
											<span >❤️ @item.Reactions.Count</span>
										</div>
								</div>
						</div>
				}
		</div>
}

@{
	var imgHasPrevious = ViewBag.HasPrevious as bool? ?? false;
	var imgHasNext = ViewBag.HasNext as bool? ?? false;
	var imgTotalCount = ViewBag.TotalCount as int? ?? 0;
	var imgSkip = ViewBag.Skip as int? ?? 0;
	var imgPreviousSkip = ViewBag.PreviousSkip as int? ?? 0;
	var imgNextSkip = ViewBag.NextSkip as int? ?? 0;
	var imgCount = Model.Count();
}
@if (imgTotalCount > 0) {
	<nav>
		@if (imgHasPrevious) {
			<a  asp-action="Index" asp-route-skip="@imgPreviousSkip" asp-route-tag="@currentTag">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
		} else {
			<button type="button"  disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
		}
		<span >@(imgSkip + 1) - @(imgSkip + imgCount) / @imgTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>
		@if (imgHasNext) {
			<a  asp-action="Index" asp-route-skip="@imgNextSkip" asp-route-tag="@currentTag">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
		} else {
			<button type="button"  disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
		}
	</nav>
}
