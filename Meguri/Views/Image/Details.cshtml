@model Meguri.Models.Image
@using System.Security.Claims

@{
		ViewData["Title"] = !string.IsNullOrEmpty(Model.Caption) ? Model.Caption : Model.Name;
		var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="row justify-content-center">
		<div class="col-lg-9">
				<div class="card shadow-sm border-0 mb-4">
						<div class="card-body p-0 text-center bg-black rounded-top overflow-hidden">
								<img src="/Image/File/@Model.Id" alt="@Model.Name" class="img-fluid" style="max-height: 70vh; object-fit: contain;" />
						</div>
						<div class="card-body p-4">
								<div class="d-flex justify-content-between align-items-start mb-2">
										<div>
												<h3 class="card-title fw-bold mb-1">@(string.IsNullOrEmpty(Model.Caption) ? Model.Name : Model.Caption)</h3>
												<div class="text-muted small">@Model.Created.ToString("yyyy/MM/dd HH:mm")</div>
										</div>
										<div class="d-flex gap-2">
												<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">@SharedLocalizer["Common_Edit"]</a>
												<form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('@SharedLocalizer["Common_ConfirmDelete"]');">
														@Html.AntiForgeryToken()
														<button type="submit" class="btn btn-sm btn-outline-danger">@SharedLocalizer["Common_Delete"]</button>
												</form>
										</div>
								</div>

								@if (!string.IsNullOrEmpty(Model.Description))
								{
										<p class="card-text text-secondary mt-3" style="white-space: pre-line;">@Model.Description</p>
								}

								<!-- タグ一覧 & あいまいさ回避ボタン -->
								<div class="my-3 pt-2 border-top">
										<div class="d-flex flex-wrap align-items-center gap-1">
												<span class="fw-bold me-2 small text-muted">🏷️ @SharedLocalizer["Post_Tags"]:</span>
												@if (!Model.ImageTags.Any())
												{
														<span class="text-muted small">なし</span>
												}
												else
												{
														@foreach (var it in Model.ImageTags)
														{
																var tagText = it.TagConcept?.Tags?.FirstOrDefault()?.TagText ?? "tag";
																var isOwner = it.TagConcept?.UserId == currentUserId;
																<div class="btn-group btn-group-sm me-1 mb-1">
																		<a asp-controller="Tag" asp-action="Details" asp-route-conceptId="@it.TagConceptId" class="btn btn-outline-primary">
																				#@tagText
																		</a>
																		<a asp-controller="Tag" asp-action="Disambiguation" asp-route-id="@it.TagConceptId" class="btn btn-outline-secondary" title="@SharedLocalizer["Tag_DisambiguationBtn"]">
																				⚖️
																		</a>
																</div>
														}
												}
										</div>
								</div>

								<!-- リアクションボタン -->
								<div class="pt-2 border-top">
										<div class="fw-bold small text-muted mb-1">@SharedLocalizer["Reaction_React"]</div>
										@await Html.PartialAsync("_ReactionButtons", ("Image", Model.Id, Model.Reactions.AsEnumerable()))
								</div>
						</div>
				</div>

				<!-- スレッド式コメントセクション -->
				<div class="card shadow-sm border-0 mb-4">
						<div class="card-header bg-white py-3">
								<h5 class="fw-bold mb-0">💬 @SharedLocalizer["Comment_Header"] (@Model.Comments.Count)</h5>
						</div>
						<div class="card-body p-4">
								@await Html.PartialAsync("_CommentThread", (Model.Comments.Where(c => c.ParentId == null).OrderBy(c => c.Created).ToList(), "Image", Model.Id))
						</div>
				</div>
		</div>
</div>
