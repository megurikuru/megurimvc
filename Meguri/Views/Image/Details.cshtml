@model Meguri.Models.Image
@using System.Security.Claims

@{
		ViewData["Title"] = !string.IsNullOrEmpty(Model.Caption) ? Model.Caption : Model.Name;
		var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div>
		<div>
				<!-- パンくず -->
				<nav aria-label="breadcrumb">
						<ol>
								<li ><a asp-controller="Image" asp-action="Index">@SharedLocalizer["Image_GalleryTitle"]</a></li>
								<li  aria-current="page">@(string.IsNullOrEmpty(Model.Caption) ? Model.Name : Model.Caption)</li>
						</ol>
				</nav>
				<div>
						<div>
								<img src="/Image/File/@Model.Id" alt="@Model.Name"  style="max-height: 70vh; object-fit: contain;" />
						</div>
						<div>
								<div>
										<div>
												<h3 >@(string.IsNullOrEmpty(Model.Caption) ? Model.Name : Model.Caption)</h3>
												<div>
													<span >@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
													@if (Model.User != null) {
														<span >by <strong>@Model.User.UserName</strong></span>
													}
													@if (Model.FileSize > 0) {
														<span >@(Model.FileSize / 1024) KB (WebP)</span>
													}
													@if (Model.Width.HasValue && Model.Height.HasValue) {
														<span >@Model.Width.Value × @Model.Height.Value</span>
													}
													@if (Model.IsPublic) {
														<span >公開</span>
													}
													@if (Model.IsSexual) {
														<span >R-18</span>
													}
													@if (Model.IsViolence) {
														<span >R-18G</span>
													}
												</div>
										</div>
										@if (Model.UserId == currentUserId || User.IsInRole("Admin")) {
											<div>
													<a asp-action="Edit" asp-route-id="@Model.Id" >@SharedLocalizer["Common_Edit"]</a>
													<form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('@SharedLocalizer["Common_ConfirmDelete"]');">
															@Html.AntiForgeryToken()
															<button type="submit" >@SharedLocalizer["Common_Delete"]</button>
													</form>
											</div>
										}
								</div>

								@if (!string.IsNullOrEmpty(Model.Description)) {
										<p>@Model.Description</p>
								}

								<!-- タグ一覧 & あいまいさ回避ボタン -->
								<div>
										<div>
												<span >🏷️ @SharedLocalizer["Post_Tags"]:</span>
												@if (!Model.ImageTags.Any()) {
														<span >なし</span>
												}
												else {
														@foreach (var it in Model.ImageTags) {
																var tagText = it.TagConcept?.Tags?.FirstOrDefault()?.TagText ?? "tag";
																var isOwner = it.TagConcept?.UserId == currentUserId;
																<div>
																		<a asp-controller="Tag" asp-action="Details" asp-route-conceptId="@it.TagConceptId">
																				#@tagText
																		</a>
																		<a asp-controller="Tag" asp-action="Disambiguation" asp-route-id="@it.TagConceptId"  title="@SharedLocalizer["Tag_DisambiguationBtn"]">
																				⚖️
																		</a>
																</div>
														}
												}
										</div>
								</div>

								<!-- リアクションボタン -->
								<div>
										<div >@SharedLocalizer["Reaction_React"]</div>
										@await Html.PartialAsync("_ReactionButtons", ("Image", Model.Id, Model.Reactions.AsEnumerable()))
								</div>
						</div>
				</div>

				<!-- スレッド式コメントセクション -->
				<div>
						<div>
								<h5 >💬 @SharedLocalizer["Comment_Header"] (@Model.Comments.Count)</h5>
						</div>
						<div>
								@await Html.PartialAsync("_CommentThread", (Model.Comments.Where(c => c.ParentId == null).OrderBy(c => c.CreatedAt).ToList(), "Image", Model.Id))
						</div>
				</div>
		</div>
</div>
