@model Meguri.Models.ImageViewModels.ImageEditViewModel
@{
		ViewData["Title"] = SharedLocalizer["Image_EditTitle"];
}

<div>
		<div>
				<div>
						<div>
								<h4 >✏️ @SharedLocalizer["Image_EditTitle"]</h4>
						</div>
						<div>
								<div>
										<img src="/Image/File/@Model.Id"  style="max-height: 200px;" />
								</div>
								<form asp-action="Edit" method="post">
										<input type="hidden" asp-for="Id" />
										<div asp-validation-summary="ModelOnly" ></div>

										<div>
												<label asp-for="Caption" >@SharedLocalizer["Image_Caption"]</label>
												<input asp-for="Caption"  />
												<span asp-validation-for="Caption" ></span>
										</div>

										<div>
												<label asp-for="Description" >@SharedLocalizer["Image_Description"]</label>
												<textarea asp-for="Description" rows="4" ></textarea>
												<span asp-validation-for="Description" ></span>
										</div>

										<!-- タグ編集 -->
										<div>
												<div>
														<label >🏷️ @SharedLocalizer["Post_Tags"]</label>
														<span  id="tagCountDisplay">0/10</span>
												</div>
												<div>
														<input type="text" id="tagInput"  placeholder="@SharedLocalizer["Tag_SearchPlaceholder"]" />
														<button type="button"  onclick="TagManager.addTag($('#tagInput').val())">@SharedLocalizer["Common_Add"]</button>
												</div>
												<div id="tagSuggestions"  style="display:none; z-index:1000; max-height:200px; overflow-y:auto;"></div>

												<div id="selectedTagsContainer" ></div>
												<div id="hiddenTagsInputs"></div>
										</div>

										<div>
												<div>
													<div>
														<input asp-for="IsPublic"  type="checkbox" role="switch" />
														<label asp-for="IsPublic" >@SharedLocalizer["Post_Public"]</label>
													</div>
												</div>
												<div>
													<div>
														<input asp-for="IsSexual"  type="checkbox" role="switch" />
														<label asp-for="IsSexual" >@SharedLocalizer["Post_NSFW_Sexual"]</label>
													</div>
												</div>
												<div>
													<div>
														<input asp-for="IsViolence"  type="checkbox" role="switch" />
														<label asp-for="IsViolence" >@SharedLocalizer["Post_NSFW_Violence"]</label>
													</div>
												</div>
										</div>

										<div>
												<a asp-action="Details" asp-route-id="@Model.Id" >@SharedLocalizer["Common_Back"]</a>
												<button type="submit" >@SharedLocalizer["Common_Save"]</button>
										</div>
								</form>
						</div>
				</div>
		</div>
</div>

@section Scripts {
		<script>
				$(document).ready(function () {
						TagManager.init(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tags)));
				});
		</script>
}
