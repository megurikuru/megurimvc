@using Meguri.Extensions
@{
	// レイアウト制御用フラグ（トップページ判定）
	ViewData["IsHomePage"] = true;

	// コントローラー（ViewBag）からのデータ取得と型キャスト（nullの場合は空リスト・既定値を設定）
	var posts = ViewBag.Posts as List<Meguri.Models.Post> ?? new List<Meguri.Models.Post>();
	var search = ViewBag.Search as string;

	// 投稿・画像ともに存在しない場合の判定フラグ
	var nothingFound = !posts.Any();
}

@{
	var searchForm = new Meguri.Models.SearchFormModel {
		Controller = "Home",
		Action = "Index",
		ParameterName = "search",
		Value = search,
		NothingFound = nothingFound
	};
}
<partial name="_SearchForm" model="searchForm" />

@* ================================================== *@
@* 2. 新着投稿一覧エリア                            *@
@* ================================================== *@
<div id="post-list">
	@* 投稿データが存在する場合 *@
	@if (posts.Any()) {
		<h1>新着投稿</h1>
		@* 投稿リストをループして描画 *@
		@foreach (var post in posts) {
			<div>
				@* ファンダム名（未設定時はデフォルト名）と投稿日時 *@
				<div class="space-between-wrap">
					<h2>@post.Fandom?.Name</h2>
					<small>@post.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
				</div>

				@* 投稿タイトル（詳細画面へのリンク） *@
				<h3><a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">@post.Name</a></h3>

				@* 投稿本文プレビュー（120文字を超える場合は「...」で切り詰める） *@
				<p>
					@(post.Text.Length > 120 ? post.Text.Substring(0, 120) + "..." : post.Text)
				</p>

				@* 添付画像サムネイル一覧（DisplayOrder順にソートし、最大4枚まで表示） *@
				@if (post.PostImages.Any()) {
					<div>
						@foreach (var pi in post.PostImages.OrderBy(x => x.DisplayOrder).Take(4)) {
							<a asp-controller="Image" asp-action="Details" asp-route-id="@pi.ImageId">
								<img src="/Image/File/@pi.ImageId" alt="@pi.Image.Name" />
							</a>
						}
					</div>
				}
			</div>
		}
	}
</div>

@* ================================================== *@
@* 3. 投稿一覧のページネーション                      *@
@* ================================================== *@
@{
	// 投稿用ページネーション情報の取得
	var postsHasPrevious = ViewBag.PostsHasPrevious as bool? ?? false;
	var postsHasNext = ViewBag.PostsHasNext as bool? ?? false;
	var postsTotalCount = ViewBag.PostsTotalCount as int? ?? 0;
	var postsSkip = ViewBag.PostsSkip as int? ?? 0;
	var postsPreviousSkip = ViewBag.PostsPreviousSkip as int? ?? 0;
	var postsNextSkip = ViewBag.PostsNextSkip as int? ?? 0;
}
@if (postsTotalCount > 0) {
	<nav class="pagination">
		@* 前のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (postsHasPrevious) {
			<a asp-action="Index" asp-route-skip="@postsPreviousSkip" asp-route-search="@search">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 10)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 10)</button>
		}

		@* 現在の表示範囲と総件数 (例: 1 - 40 / 120件) *@
		<span>@(postsSkip + 1) - @(postsSkip + posts.Count) / @postsTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>

		@* 次のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (postsHasNext) {
			<a asp-action="Index" asp-route-skip="@postsNextSkip" asp-route-search="@search">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 10)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 10)</button>
		}
	</nav>
}

@* 	}
} *@