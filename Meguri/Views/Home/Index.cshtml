@using Meguri.Extensions
@inject SignInManager<ApplicationUser> SignInManager

@{
	// レイアウト制御用フラグ（トップページ判定）
	ViewData["IsHomePage"] = true;

	// コントローラー（ViewBag）からのデータ取得と型キャスト（nullの場合は空リスト・既定値を設定）
	var posts = ViewBag.Posts as List<Meguri.Models.Post> ?? new List<Meguri.Models.Post>();
	var search = ViewBag.Search as string;

	var foundUsers = ViewBag.Users as List<Meguri.Models.ApplicationUser>;

	// 投稿・ユーザーともに存在しない場合の判定フラグ
	var nothingFound = !posts.Any() && (foundUsers == null || !foundUsers.Any());
}

@{
	var searchForm = new SearchFormViewModel {
		Controller = "Home",
		Action = "Index",
		ParameterName = "search",
		Value = search,
		NothingFound = nothingFound
	};
}

@if (SignInManager.IsSignedIn(User)) {
	<partial name="_SearchForm" model="searchForm" />
}

@if (foundUsers != null && foundUsers.Any()) {
	<div id="user-list">
		<h1>@SharedLocalizer["Home_UsersHeading"]</h1>
		<ul>
			@foreach (var u in foundUsers) {
				<li>
					@if (u.ActiveAvatarImageId.HasValue) {
						<img src="/Image/File/@u.ActiveAvatarImageId" alt="" />
					}
					@if (!u.IsProfilePublic && User.Identity?.IsAuthenticated != true) {
						@u.UserName
					} else {
						<a asp-controller="Profile" asp-action="Details" asp-route-id="@u.UserName">@u.UserName</a>
					}
				</li>
			}
		</ul>
	</div>
}

@* 新着投稿一覧 *@
@if (posts.Any()) {
	<div id="post-list">
		<h1>@SharedLocalizer["Home_LatestPostsHeading"]</h1>
		@* 投稿リストをループして描画 *@
		@foreach (var post in posts) {
			var displayTitle = string.IsNullOrWhiteSpace(post.Subject) ? SharedLocalizer["Post_Untitled"].Value : post.Subject;
			<article>
				@* 投稿タイトル（詳細画面へのリンク） *@
				<h2><a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">@displayTitle</a></h2>
				@* 界隈と投稿日時 *@
				<div class="article-meta">
					<a asp-controller="Fandom" asp-action="Details" asp-route-id="@post.FandomId">@post.Fandom?.Name</a>
					<span>@post.CreatedAt.ToLocalTime().ToString("M月d日 H:mm")</span>
				</div>
				@* 投稿本文プレビュー（120文字を超える場合は「...」で切り詰める） *@
				@if (!string.IsNullOrWhiteSpace(post.Body)) {
					<p><a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">@(post.Body.Length > 120 ? post.Body.Substring(0, 120) + "..." : post.Body)</a></p>
				}

				@* 添付画像サムネイル一覧（投稿詳細へのリンク。DisplayOrder順に最大4枚まで表示） *@
				@foreach (var pi in post.PostImages.OrderBy(x => x.DisplayOrder).Take(4)) {
					<a class="article-image-wrap" asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">
						<img src="/Image/File/@pi.ImageId" alt="@pi.Image.Name" />
					</a>
				}
			</article>
		}
	</div>
}

@* ページネーション *@
@{
	// 投稿用ページネーション情報の取得
	var postsHasPrevious = ViewBag.PostsHasPrevious as bool? ?? false;
	var postsHasNext = ViewBag.PostsHasNext as bool? ?? false;
	var postsTotalCount = ViewBag.PostsTotalCount as int? ?? 0;
	var postsSkip = ViewBag.PostsSkip as int? ?? 0;
	var postsPreviousSkip = ViewBag.PostsPreviousSkip as int? ?? 0;
	var postsNextSkip = ViewBag.PostsNextSkip as int? ?? 0;
}
@if (postsTotalCount > 0) {
	<nav class="pagination">
		@* 前のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (postsHasPrevious) {
			<a asp-action="Index" asp-route-skip="@postsPreviousSkip" asp-route-search="@search">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 10)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 10)</button>
		}

		@* 現在の表示範囲と総件数 (例: 1 - 40 / 120件) *@
		<span>@(postsSkip + 1) - @(postsSkip + posts.Count) / @postsTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>

		@* 次のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (postsHasNext) {
			<a asp-action="Index" asp-route-skip="@postsNextSkip" asp-route-search="@search">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 10)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 10)</button>
		}
	</nav>
}
