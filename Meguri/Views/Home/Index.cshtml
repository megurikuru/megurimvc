@using Meguri.Extensions
@{
	// レイアウト制御用フラグ（トップページ判定）
	ViewData["IsHomePage"] = true;

	// コントローラー（ViewBag）からのデータ取得と型キャスト（nullの場合は空リスト・既定値を設定）
	var recentPosts = ViewBag.RecentPosts as List<Meguri.Models.Post> ?? new List<Meguri.Models.Post>();
	var recentImages = ViewBag.RecentImages as List<Meguri.Models.Image> ?? new List<Meguri.Models.Image>();
	var currentSearch = ViewBag.CurrentSearch as string;
	var currentFandom = ViewBag.CurrentFandom as Meguri.Models.Fandom;

	// 投稿・画像ともに存在しない場合の判定フラグ
	var nothingFound = !recentPosts.Any() && !recentImages.Any();
}

@* ================================================== *@
@* 1. 検索フォームエリア                             *@
@* ================================================== *@
<div id="search-box">
	<form class="search" asp-controller="Home" asp-action="Index" method="get">
		@* 検索キーワード入力欄 *@
		<input type="text" name="search" value="@currentSearch" placeholder="@SharedLocalizer["Home_SearchPlaceholder"]" />

		@* 検索送信ボタン *@
		<button type="submit">検索</button>

		@* 検索キーワード入力中、またはファンダム選択中の場合のみリセットボタンを表示 *@
		@if (!string.IsNullOrEmpty(currentSearch) || currentFandom != null) {
			<div>
				<a asp-controller="Home" asp-action="Index">リセット</a>
			</div>
		}
	</form>
	@* 投稿も画像もデータがない場合のみ「見つかりません」を表示 *@
	@if (nothingFound) {
		<p>@SharedLocalizer["Common_NothingFound"]</p>
	}
</div>

@* ================================================== *@
@* 2. 新着投稿一覧エリア                            *@
@* ================================================== *@
<div id="post-list">
	@* 投稿データが存在する場合 *@
	@if (recentPosts.Any()) {
		<h1>投稿</h1>
		@* 投稿リストをループして描画 *@
		@foreach (var post in recentPosts) {
			<div>
				@* ファンダム名（未設定時はデフォルト名）と投稿日時 *@
				<div class="space-between-wrap">
					<h2>@post.Fandom?.Name</h2>
					<small>@post.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
				</div>

				@* 投稿タイトル（詳細画面へのリンク） *@
				<h3><a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">@post.Name</a></h3>

				@* 投稿本文プレビュー（120文字を超える場合は「...」で切り詰める） *@
				<p>
					@(post.Text.Length > 120 ? post.Text.Substring(0, 120) + "..." : post.Text)
				</p>

				@* 添付画像サムネイル一覧（DisplayOrder順にソートし、最大4枚まで表示） *@
				@if (post.PostImages.Any()) {
					<div>
						@foreach (var pi in post.PostImages.OrderBy(x => x.DisplayOrder).Take(4)) {
							<a asp-controller="Image" asp-action="Details" asp-route-id="@pi.ImageId">
								<img src="/Image/File/@pi.ImageId" alt="@pi.Image.Name" />
							</a>
						}
					</div>
				}

				@* タグ一覧 *@
				@if (post.PostTags.Any()) {
					<div>
						@foreach (var pt in post.PostTags) {
							var tagText = pt.TagConcept?.Tags?.FirstOrDefault()?.TagText;
							if (!string.IsNullOrEmpty(tagText)) {
								<a class="icon-with-text" asp-controller="Tag" asp-action="Details" asp-route-conceptId="@pt.TagConceptId">
									<img src="~/icons/tag.svg">@tagText
								</a>
							}
						}
					</div>
				}

				@* 投稿ユーザー情報および反響データ（コメント数・リアクション数） *@
				<div>
					<div>
						<span class="icon-with-text"><img src="~/icons/user.svg"> @(post.User?.UserName ?? SharedLocalizer["Common_UnknownUser"].Value)</span>
					</div>
					<div>
						<span>💬 @post.CommentCount</span>
						<span>❤️ @post.Reactions.Count</span>
					</div>
				</div>
			</div>
		}
	}
</div>

@* ================================================== *@
@* 3. 投稿一覧のページネーション                      *@
@* ================================================== *@
@{
	// 投稿用ページネーション情報の取得
	var postsHasPrevious = ViewBag.PostsHasPrevious as bool? ?? false;
	var postsHasNext = ViewBag.PostsHasNext as bool? ?? false;
	var postsTotalCount = ViewBag.PostsTotalCount as int? ?? 0;
	var postsSkip = ViewBag.PostsSkip as int? ?? 0;
	var postsPreviousSkip = ViewBag.PostsPreviousSkip as int? ?? 0;
	var postsNextSkip = ViewBag.PostsNextSkip as int? ?? 0;
}
@if (postsTotalCount > 0) {
	<nav class="pagination">
		@* 前のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (postsHasPrevious) {
			<a asp-action="Index" asp-route-skip="@postsPreviousSkip" asp-route-search="@currentSearch" asp-route-fandomId="@currentFandom?.Id">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
		}

		@* 現在の表示範囲と総件数 (例: 1 - 40 / 120件) *@
		<span>@(postsSkip + 1) - @(postsSkip + recentPosts.Count) / @postsTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>

		@* 次のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (postsHasNext) {
			<a asp-action="Index" asp-route-skip="@postsNextSkip" asp-route-search="@currentSearch" asp-route-fandomId="@currentFandom?.Id">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
		}
	</nav>
}

@* ================================================== *@
@* 4. 検索結果の画像一覧および画像ページネーション    *@
@* ================================================== *@
@{
	// 画像用ページネーション情報の取得
	var imagesTotalCount = ViewBag.ImagesTotalCount as int? ?? 0;
	var imagesHasPrevious = ViewBag.ImagesHasPrevious as bool? ?? false;
	var imagesHasNext = ViewBag.ImagesHasNext as bool? ?? false;
	var imagesSkip = ViewBag.ImagesSkip as int? ?? 0;
	var imagesPreviousSkip = ViewBag.ImagesPreviousSkip as int? ?? 0;
	var imagesNextSkip = ViewBag.ImagesNextSkip as int? ?? 0;
}

@* 検索キーワードが指定されている場合のみ画像検索セクションを表示 *@
@if (!string.IsNullOrEmpty(currentSearch)) {
	@* 画像サムネイル一覧 *@
	@if (recentImages.Any()) {
		<div id="image-list">
			<h1>画像</h1>
			@foreach (var image in recentImages) {
				<a asp-controller="Image" asp-action="Details" asp-route-id="@image.Id">
					<img src="/Image/File/@image.Id" style="width: 120px; height: 120px; object-fit: cover;" alt="@image.Name" />
				</a>
			}
		</div>
	}

	@* 画像用のページネーション *@
	@if (imagesTotalCount > 0) {
		<nav class="pagination">
			@* 画像の前ページ *@
			@if (imagesHasPrevious) {
				<a asp-action="Index" asp-route-imageSkip="@imagesPreviousSkip" asp-route-skip="@postsSkip" asp-route-search="@currentSearch" asp-route-fandomId="@currentFandom?.Id">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</a>
			} else {
				<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, 40)</button>
			}

			@* 画像の現在表示範囲と総件数 *@
			<span>@(imagesSkip + 1) - @(imagesSkip + recentImages.Count) / @imagesTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>

			@* 画像の次ページ *@
			@if (imagesHasNext) {
				<a asp-action="Index" asp-route-imageSkip="@imagesNextSkip" asp-route-skip="@postsSkip" asp-route-search="@currentSearch" asp-route-fandomId="@currentFandom?.Id">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</a>
			} else {
				<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, 40)</button>
			}
		</nav>
	}
}