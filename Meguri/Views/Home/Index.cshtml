        </ul>
    </div>
    <div class="col-md-3">
        <h2>@SharedLocalizer["Home_Section_RunDeploy"]</h2>
        <ul>
            <li><a href="https://go.microsoft.com/fwlink/?LinkID=517851">@SharedLocalizer["Home_RunDeploy_Item1"]</a></li>
            <li><a href="https://go.microsoft.com/fwlink/?LinkID=517853">@SharedLocalizer["Home_RunDeploy_Item2"]</a></li>
            <li><a href="https://go.microsoft.com/fwlink/?LinkID=398609">@SharedLocalizer["Home_RunDeploy_Item3"]</a></li>
        </ul>
