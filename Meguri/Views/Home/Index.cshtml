@model Meguri.ViewModels.Home.HomeIndexViewModel
@using Meguri.Extensions
@inject SignInManager<ApplicationUser> SignInManager

@{
	// レイアウト制御用フラグ（トップページ判定）
	ViewData["IsHomePage"] = true;

	// 投稿・ユーザーともに存在しない場合の判定フラグ
	var nothingFound = !Model.Posts.Any() && !Model.Users.Any();
}

@{
	var searchForm = new SearchFormViewModel {
		Controller = "Home",
		Action = "Index",
		ParameterName = "search",
		Value = Model.Search,
		NothingFound = nothingFound
	};
}

@if (SignInManager.IsSignedIn(User)) {
	<partial name="_SearchForm" model="searchForm" />
}

@if (Model.Users.Any()) {
	<h1>@SharedLocalizer["Home_UsersHeading"]</h1>
	<div id="user-list">
		<ul>
			@foreach (var u in Model.Users) {
				<li>
					@if (u.ActiveAvatarImageId.HasValue) {
						<img src="/Image/File/@u.ActiveAvatarImageId" alt="" />
					}
					@if (!u.IsProfilePublic && User.Identity?.IsAuthenticated != true) {
						@u.UserName
					} else {
						<a asp-controller="Profile" asp-action="Details" asp-route-id="@u.UserName">@u.UserName</a>
					}
				</li>
			}
		</ul>
	</div>
}

@* 新着投稿一覧 *@
@if (Model.Posts.Any()) {
	<h1>@SharedLocalizer["Home_LatestPostsHeading"]</h1>
	<div id="post-list">
		@* 投稿リストをループして描画 *@
		@foreach (var post in Model.Posts) {
			<partial name="_PostItem" model="new PostItemViewModel { 
				Post = post, 
				ShowStats = false 
			}" />
		}
	</div>
}

@* ページネーション *@
@if (Model.PostsTotalCount > 0) {
	<nav class="pagination">
		@* 前のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (Model.PostsHasPrevious) {
			<a asp-action="Index" asp-route-skip="@Model.PostsPreviousSkip" asp-route-search="@Model.Search">@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, Model.PostsPageSize)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_PreviousCountFormat"].Value, Model.PostsPageSize)</button>
		}

		@* 現在の表示範囲と総件数 (例: 1 - 40 / 120件) *@
		<span>@(Model.PostsSkip + 1) - @(Model.PostsSkip + Model.Posts.Count) / @Model.PostsTotalCount @SharedLocalizer["Common_ItemsSuffix"]</span>

		@* 次のページ（存在する場合はリンク、ない場合は無効化ボタン） *@
		@if (Model.PostsHasNext) {
			<a asp-action="Index" asp-route-skip="@Model.PostsNextSkip" asp-route-search="@Model.Search">@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, Model.PostsPageSize)</a>
		} else {
			<button type="button" disabled>@string.Format(SharedLocalizer["Pagination_NextCountFormat"].Value, Model.PostsPageSize)</button>
		}
	</nav>
}
