@using Meguri.Extensions
@{
    ViewData["IsHomePage"] = true;
    var recentPosts = ViewBag.RecentPosts as List<Meguri.Models.Post> ?? new List<Meguri.Models.Post>();
    var recentImages = ViewBag.RecentImages as List<Meguri.Models.Image> ?? new List<Meguri.Models.Image>();
    var topFandoms = ViewBag.TopFandoms as List<Meguri.Models.Fandom> ?? new List<Meguri.Models.Fandom>();
    var currentSearch = ViewBag.CurrentSearch as string;
    var currentFandom = ViewBag.CurrentFandom as Meguri.Models.Fandom;
    var nothingFound = !recentPosts.Any() && !recentImages.Any();
}

<div class="row g-4">
    <!-- メイン：新着投稿 -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4 bg-body-tertiary">
            <form asp-controller="Home" asp-action="Index" method="get" class="row g-2 align-items-center">
                <div class="col">
                    <input type="text" name="search" value="@currentSearch" class="form-control" placeholder="タイトル・本文・タグで検索..." />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">@SharedLocalizer["Common_Search"]</button>
                </div>
                @if (!string.IsNullOrEmpty(currentSearch) || currentFandom != null) {
                    <div class="col-auto">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@SharedLocalizer["Common_Reset"]</a>
                    </div>
                }
            </form>
        </div>

        @if (!recentPosts.Any()) {
            @if (nothingFound) {
                <div class="card p-4 text-center text-body-secondary">
                    <p class="mb-0">@SharedLocalizer["Common_NothingFound"]</p>
                </div>
            }
        }
        else {
            <div class="d-flex flex-column gap-3">
                @foreach (var post in recentPosts) {
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary">@(post.Fandom?.Name ?? "界隈")</span>
                                <small class="text-body-secondary">@post.Created.ToString("yyyy/MM/dd HH:mm")</small>
                            </div>
                            <h5 class="card-title">
                                <a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id" class="text-decoration-none text-body fw-bold">
                                    @post.Name
                                </a>
                            </h5>
                            <p class="card-text text-secondary mb-2" style="white-space: pre-line;">
                                @(post.Text.Length > 120 ? post.Text.Substring(0, 120) + "..." : post.Text)
                            </p>

                            @if (post.PostImages.Any()) {
                                <div class="d-flex gap-2 overflow-auto mb-2 py-1">
                                    @foreach (var pi in post.PostImages.OrderBy(x => x.DisplayOrder).Take(4)) {
                                        <a asp-controller="Image" asp-action="Details" asp-route-id="@pi.ImageId">
                                            <img src="/Image/File/@pi.ImageId" class="rounded" style="width: 80px; height: 80px; object-fit: cover;" alt="@pi.Image.Name" />
                                        </a>
                                    }
                                </div>
                            }

                            <!-- タグ -->
                            @if (post.PostTags.Any()) {
                                <div class="mb-2">
                                    @foreach (var pt in post.PostTags) {
                                        var tagText = pt.TagConcept?.Tags?.FirstOrDefault()?.TagText;
                                        if (!string.IsNullOrEmpty(tagText)) {
                                            <a asp-controller="Tag" asp-action="Details" asp-route-conceptId="@pt.TagConceptId" class="tag-badge">#@tagText</a>
                                        }
                                    }
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top small text-body-secondary">
                                <div>
                                    <span>👤 @(post.User?.UserName ?? "User")</span>
                                </div>
                                <div class="d-flex gap-3">
                                    <span>💬 @post.CommentCount</span>
                                    <span>❤️ @post.Reactions.Count</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @{
            var postsHasPrevious = ViewBag.PostsHasPrevious as bool? ?? false;
            var postsHasNext = ViewBag.PostsHasNext as bool? ?? false;
            var postsTotalCount = ViewBag.PostsTotalCount as int? ?? 0;
            var postsSkip = ViewBag.PostsSkip as int? ?? 0;
            var postsPreviousSkip = ViewBag.PostsPreviousSkip as int? ?? 0;
            var postsNextSkip = ViewBag.PostsNextSkip as int? ?? 0;
        }
        @if (postsTotalCount > 0) {
            <nav class="d-flex justify-content-between align-items-center py-2 mt-3 border-top px-1">
                @if (postsHasPrevious) {
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-skip="@postsPreviousSkip" asp-route-search="@currentSearch" asp-route-fandomId="@currentFandom?.Id">← 前の40件</a>
                } else {
                    <button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>← 前の40件</button>
                }
                <span class="small text-body-secondary">@(postsSkip + 1) - @(postsSkip + recentPosts.Count) / @postsTotalCount 件</span>
                @if (postsHasNext) {
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-skip="@postsNextSkip" asp-route-search="@currentSearch" asp-route-fandomId="@currentFandom?.Id">次の40件 →</a>
                } else {
                    <button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>次の40件 →</button>
                }
            </nav>
        }

        @{
            var imagesTotalCount = ViewBag.ImagesTotalCount as int? ?? 0;
            var imagesHasPrevious = ViewBag.ImagesHasPrevious as bool? ?? false;
            var imagesHasNext = ViewBag.ImagesHasNext as bool? ?? false;
            var imagesSkip = ViewBag.ImagesSkip as int? ?? 0;
            var imagesPreviousSkip = ViewBag.ImagesPreviousSkip as int? ?? 0;
            var imagesNextSkip = ViewBag.ImagesNextSkip as int? ?? 0;
        }
        @if (!string.IsNullOrEmpty(currentSearch)) {
            @if (recentImages.Any()) {
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var image in recentImages) {
                        <a asp-controller="Image" asp-action="Details" asp-route-id="@image.Id" class="text-decoration-none">
                            <img src="/Image/File/@image.Id" class="rounded" style="width: 120px; height: 120px; object-fit: cover;" alt="@image.Name" />
                        </a>
                    }
                </div>
            }

            @if (imagesTotalCount > 0) {
                <nav class="d-flex justify-content-between align-items-center py-2 mt-1 border-top px-1">
                    @if (imagesHasPrevious) {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-imageSkip="@imagesPreviousSkip" asp-route-skip="@postsSkip" asp-route-search="@currentSearch" asp-route-fandomId="@currentFandom?.Id">← 前の40件</a>
                    } else {
                        <button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>← 前の40件</button>
                    }
                    <span class="small text-body-secondary">@(imagesSkip + 1) - @(imagesSkip + recentImages.Count) / @imagesTotalCount 件</span>
                    @if (imagesHasNext) {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Index" asp-route-imageSkip="@imagesNextSkip" asp-route-skip="@postsSkip" asp-route-search="@currentSearch" asp-route-fandomId="@currentFandom?.Id">次の40件 →</a>
                    } else {
                        <button type="button" class="btn btn-sm btn-outline-secondary disabled" disabled>次の40件 →</button>
                    }
                </nav>
            }
        }
    </div>

    <!-- サイドバー：界隈（Fandom）一覧 -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-body-tertiary fw-bold d-flex justify-content-between align-items-center">
                <span>🏛️ @SharedLocalizer["Fandom_Title"]</span>
                <a asp-controller="Fandom" asp-action="Index" class="btn btn-sm btn-link p-0">@SharedLocalizer["Common_All"]</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var f in topFandoms) {
                    <a asp-controller="Fandom" asp-action="Details" asp-route-id="@f.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-semibold">@f.Name</span>
                            @if (f.ChildFandoms.Any()) {
                                <div class="small text-body-secondary">
                                    @string.Join(", ", f.ChildFandoms.Select(c => c.Name))
                                </div>
                            }
                        </div>
                        <span class="badge bg-body-secondary border">詳細</span>
                    </a>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-body-tertiary">
            <div class="card-body">
                <h6 class="fw-bold">ℹ️ @SharedLocalizer["Fandom_Title"]の仕組み</h6>
                <p class="small text-body-secondary mb-0">@SharedLocalizer["Fandom_CascadeNote"]</p>
            </div>
        </div>
    </div>
</div>
