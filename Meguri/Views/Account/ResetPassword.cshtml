@model ResetPasswordViewModel
@{
    ViewData["Title"] = SharedLocalizer["Account_ResetPassword_Title"];
}

<h2>@ViewData["Title"]</h2>
<h4>@SharedLocalizer["Account_ResetPassword_Description"]</h4>
<hr />
<div>
    <div>
        <form class="account" method="post">
            <div asp-validation-summary="All" ></div>
            <input asp-for="Code" type="hidden" />
            <div>
                <label asp-for="Email" ></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" ></span>
            </div>
            <div>
                <label asp-for="Password" ></label>
                <div class="input-group">
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <button type="button" class="password-toggle" data-toggle-password aria-pressed="false" aria-label="@SharedLocalizer["Account_Password_Show"]" title="@SharedLocalizer["Account_Password_Show"]" data-label-show="@SharedLocalizer["Account_Password_Show"]" data-label-hide="@SharedLocalizer["Account_Password_Hide"]" data-icon-show="@Url.Content("~/icons/eye.svg")" data-icon-hide="@Url.Content("~/icons/eye-off.svg")">
                        <img src="~/icons/eye.svg" class="icon" alt="" aria-hidden="true" />
                    </button>
                </div>
                <span asp-validation-for="Password" ></span>
            </div>
            <button type="submit" >@SharedLocalizer["Account_ResetPassword_ResetButton"]</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
