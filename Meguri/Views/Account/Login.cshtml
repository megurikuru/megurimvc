@using System.Collections.Generic
@using System.Linq
@using Meguri
@using Meguri.Models
@using Meguri.Models.AccountViewModels
@using Meguri.Models.ManageViewModels
@using Microsoft.AspNetCore.Http
@* Removed obsolete Microsoft.AspNetCore.Http.Authentication using; modern signing/externals use SignInManager or HttpContext.SignInAsync *@
@model LoginViewModel
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = SharedLocalizer["Account_Login_Title"];
}

<h2>@ViewData["Title"]</h2>
<div class="row">
    <div class="col-md-4">
        <section>
            <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                <h4>@SharedLocalizer["Account_Login_UseLocalAccount"]</h4>
                <hr />
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label asp-for="RememberMe">
                            <input asp-for="RememberMe" />
                            @Html.DisplayNameFor(m => m.RememberMe)
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-default">@SharedLocalizer["Account_Login_Button"]</button>
                </div>
                <div class="form-group">
                    <p>
                        <a asp-action="ForgotPassword">@SharedLocalizer["Account_Login_ForgotPassword"]</a>
                    </p>
                    <p>
                        <a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]">@SharedLocalizer["Account_Login_RegisterNewUser"]</a>
                    </p>
                </div>
            </form>
        </section>
    </div>
    <div class="col-md-6 col-md-offset-2">
        <section>
            <h4>@SharedLocalizer["Account_Login_UseAnotherService"]</h4>
            <hr />
            @{
                var loginProviders = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
                if (loginProviders.Count == 0)
                {
                    <div>
                        <p>
                            @SharedLocalizer["Account_Login_NoExternalServices"] <a href="https://go.microsoft.com/fwlink/?LinkID=532715">@SharedLocalizer["Account_Login_ThisArticle"]</a>
                            @SharedLocalizer["Account_Login_NoExternalServices_Detail"]
                        </p>
                    </div>
                }
                else
                {
                    <form asp-action="ExternalLogin" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="form-horizontal">
                        <div>
                            <p>
                                @foreach (var provider in loginProviders)
                                {
                                    <button type="submit" class="btn btn-default" name="provider" value="@provider.Name" title="@SharedLocalizer["Account_Login_ExternalProviderButtonTitle", provider.DisplayName]">@provider.Name</button>
                                }
                            </p>
                        </div>
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
