@using System.Collections.Generic
@using System.Linq
@using Meguri
@using Meguri.Models
@using Meguri.ViewModels.Account
@using Meguri.ViewModels.Manage
@using Microsoft.AspNetCore.Http
@model LoginViewModel
@inject SignInManager<ApplicationUser> SignInManager

@{
	ViewData["Title"] = SharedLocalizer["Account_Login_Title"];
}

<h2>@ViewData["Title"]</h2>
<section>
	<form class="account" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
		<div asp-validation-summary="All"></div>

		<div>
			<label asp-for="UserName"></label>
			<input asp-for="UserName" />
			<span asp-validation-for="UserName"></span>
		</div>

		<div>
			<label asp-for="Password"></label>
			<input asp-for="Password" />
			<span asp-validation-for="Password"></span>
		</div>

		<label asp-for="RememberMe" class="check-row">
			<input asp-for="RememberMe" />
			@Html.DisplayNameFor(m => m.RememberMe)
		</label>

		<button type="submit">@SharedLocalizer["Account_Login_Button"]</button>

		<div class="account-links">
			<p>
				<a asp-action="ForgotPassword">@SharedLocalizer["Account_Login_ForgotPassword"]</a>
			</p>
			<p>
				<a asp-action="Register" asp-route-returnurl="@ViewData["ReturnUrl"]">@SharedLocalizer["Account_Login_RegisterNewUser"]</a>
			</p>
		</div>
	</form>

	<form class="account" asp-action="PasskeyLogin" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
		<input type="hidden" name="credentialJson" />
		<div>
			<button type="button" data-passkey="login" data-options-url="@Url.Action("PasskeyRequestOptions", "Account")" data-error-text="@SharedLocalizer["Account_Login_PasskeyFailed"]">@SharedLocalizer["Account_Login_PasskeyButton"]</button>
			<span data-passkey-message></span>
		</div>
	</form>
</section>

@section Scripts {
	<script src="~/js/passkey.js" asp-append-version="true"></script>
	@await Html.PartialAsync("_ValidationScriptsPartial")
}