@model ForgotPasswordViewModel
@{
    ViewData["Title"] = SharedLocalizer["Account_ForgotPassword_Title"];
}

<h2>@ViewData["Title"]</h2>
<h4>@SharedLocalizer["Account_ForgotPassword_EnterEmail"]</h4>
<hr />
<div>
    <div>
        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="All" ></div>
            <div>
                <label asp-for="Email" ></label>
                <input asp-for="Email"  />
                <span asp-validation-for="Email" ></span>
            </div>
            <button type="submit" >@SharedLocalizer["Account_Submit_Button"]</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
