@using Meguri.Services
@using Microsoft.Extensions.Options
@model ForgotPasswordViewModel
@inject IOptions<TurnstileConf> TurnstileOptions
@{
    ViewData["Title"] = SharedLocalizer["Account_ForgotPassword_Title"];
}

<h1>@ViewData["Title"]</h1>
<form class="account" asp-action="ForgotPassword" method="post">
	<p>@SharedLocalizer["Account_ForgotPassword_EnterEmail"]</p>
    <div asp-validation-summary="All" ></div>
    <div>
        <label asp-for="Email" ></label>
        <input asp-for="Email"  />
        <span asp-validation-for="Email" ></span>
    </div>
    @if (TurnstileOptions.Value.Enabled) {
        <div class="cf-turnstile" data-sitekey="@TurnstileOptions.Value.SiteKey" data-action="forgot_password"></div>
    }
    <button type="submit" >@SharedLocalizer["Account_Submit_Button"]</button>
</form>

@section Scripts {
    @if (TurnstileOptions.Value.Enabled) {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
