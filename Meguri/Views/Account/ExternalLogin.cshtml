@model ExternalLoginViewModel
@{
    ViewData["Title"] = SharedLocalizer["Account_Register_Title"];
}

<h2>@ViewData["Title"]</h2>
<h4>@SharedLocalizer["Account_ExternalLogin_AssociateAccount", ViewData["LoginProvider"]]</h4>
<hr />

<p class="text-info">
    @SharedLocalizer["Account_ExternalLogin_SuccessMessage", ViewData["LoginProvider"]]
    @SharedLocalizer["Account_ExternalLogin_EnterEmailAndRegister"]
</p>

<div class="row">
    <div class="col-md-4">
        <form asp-action="ExternalLoginConfirmation" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-default">@SharedLocalizer["Account_Register_Button"]</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
