@model LoginWithRecoveryCodeViewModel
@{
    ViewData["Title"] = SharedLocalizer["Account_LoginWithRecoveryCode_Title"];
}

<h2>@ViewData["Title"]</h2>
<hr />
<p>
    @SharedLocalizer["Account_LoginWithRecoveryCode_Description"]
</p>
<div>
    <div>
        <form method="post">
            <div asp-validation-summary="All" ></div>
            <div>
                <label asp-for="RecoveryCode" ></label>
                <input asp-for="RecoveryCode"  autocomplete="off" />
                <span asp-validation-for="RecoveryCode" ></span>
            </div>
            <button type="submit" >@SharedLocalizer["Account_Login_Button"]</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}