@model RegisterViewModel
@{
    ViewData["Title"] = SharedLocalizer["Account_Register_Title"];
}

<h2>@ViewData["Title"]</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <h4>@SharedLocalizer["Account_Register_CreateNewAccount"]</h4>
            <hr />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="UserName" class="form-label">@SharedLocalizer["Account_Field_UserName"]</label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label">@SharedLocalizer["Account_Field_Email"]</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">@SharedLocalizer["Account_Field_Password"]</label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">@SharedLocalizer["Account_Field_ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">@SharedLocalizer["Account_Field_DateOfBirth"]</label>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="BirthYear" class="form-control text-end" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4" placeholder="@SharedLocalizer["Account_Field_DateOfBirth_YearPlaceholder"]" autocomplete="bday-year" />
                    <span>@SharedLocalizer["Account_Field_DateOfBirth_YearUnit"]</span>
                    <input asp-for="BirthMonth" class="form-control text-end" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" placeholder="@SharedLocalizer["Account_Field_DateOfBirth_MonthPlaceholder"]" autocomplete="bday-month" />
                    <span>@SharedLocalizer["Account_Field_DateOfBirth_MonthUnit"]</span>
                    <input asp-for="BirthDay" class="form-control text-end" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" placeholder="@SharedLocalizer["Account_Field_DateOfBirth_DayPlaceholder"]" autocomplete="bday-day" />
                    <span>@SharedLocalizer["Account_Field_DateOfBirth_DayUnit"]</span>
                </div>
                <span asp-validation-for="BirthYear" class="text-danger"></span>
                <span asp-validation-for="BirthMonth" class="text-danger"></span>
                <span asp-validation-for="BirthDay" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-secondary">@SharedLocalizer["Account_Register_Button"]</button>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
