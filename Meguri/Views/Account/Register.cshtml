@using Meguri.Services
@using Microsoft.Extensions.Options
@model RegisterViewModel
@inject IOptions<TurnstileConf> TurnstileOptions
@{
	ViewData["Title"] = SharedLocalizer["Account_Register_Title"];
	var isPasswordMode = ViewData.ModelState.ContainsKey(nameof(Model.Password))
		|| ViewData.ModelState.ContainsKey(nameof(Model.ConfirmPassword));
}

<article>
	<h1>@ViewData["Title"]</h1>

	<form class="account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
		<p>@SharedLocalizer["Account_Register_CreateNewAccount"]</p>
		<div asp-validation-summary="All"></div>
		<input type="hidden" name="credentialJson" />

		<div id="authMethodSelector">
			<label class="option-row">
				<input type="radio" name="authMethod" id="authMethodPasskey" value="passkey" checked="@(!isPasswordMode)" />
				<span>@SharedLocalizer["Account_Register_MethodPasskey"]</span>
			</label>
			<label class="option-row">
				<input type="radio" name="authMethod" id="authMethodPassword" value="password" checked="@isPasswordMode" />
				<span>@SharedLocalizer["Account_Register_MethodPassword"]</span>
			</label>
		</div>

		<div>
			<label asp-for="UserName">@SharedLocalizer["Account_Field_UserName"]</label>
			<input asp-for="UserName" class="form-control" />
			<span asp-validation-for="UserName"></span>
		</div>
		<div>
			<label asp-for="Email">@SharedLocalizer["Account_Field_Email"]</label>
			<input asp-for="Email" class="form-control" />
			<span asp-validation-for="Email"></span>
		</div>
		<div id="passwordSection" hidden>
			<div>
				<label asp-for="Password">@SharedLocalizer["Account_Field_Password"]</label>
				<input asp-for="Password" class="form-control" disabled />
				<span asp-validation-for="Password"></span>
			</div>
			<div>
				<label asp-for="ConfirmPassword">@SharedLocalizer["Account_Field_ConfirmPassword"]</label>
				<input asp-for="ConfirmPassword" class="form-control" disabled />
				<span asp-validation-for="ConfirmPassword"></span>
			</div>
		</div>
		<div>
			<label>@SharedLocalizer["Account_Field_DateOfBirth"]</label>
			<div class="birth">
				<input asp-for="BirthYear" class="form-control" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="4" placeholder="@SharedLocalizer["Account_Field_DateOfBirth_YearPlaceholder"]" autocomplete="bday-year" />
				<span>@SharedLocalizer["Account_Field_DateOfBirth_YearUnit"]</span>
				<input asp-for="BirthMonth" class="form-control" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" placeholder="@SharedLocalizer["Account_Field_DateOfBirth_MonthPlaceholder"]" autocomplete="bday-month" />
				<span>@SharedLocalizer["Account_Field_DateOfBirth_MonthUnit"]</span>
				<input asp-for="BirthDay" class="form-control" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="2" placeholder="@SharedLocalizer["Account_Field_DateOfBirth_DayPlaceholder"]" autocomplete="bday-day" />
				<span>@SharedLocalizer["Account_Field_DateOfBirth_DayUnit"]</span>
			</div>
			<span asp-validation-for="BirthYear"></span>
			<span asp-validation-for="BirthMonth"></span>
			<span asp-validation-for="BirthDay"></span>
		</div>
		<div id="passkeySection">
			<div>
				<label asp-for="PasskeyName">@SharedLocalizer["Manage_Passkeys_Name"]</label>
				<input asp-for="PasskeyName" class="form-control" maxlength="100" />
				<span asp-validation-for="PasskeyName"></span>
			</div>
		</div>
		<div>
			<label>@SharedLocalizer["Account_Register_Terms"]</label>
			<div class="terms-box">
				@await Html.PartialAsync("_TermsContent")
			</div>
			<label class="option-row">
				<input asp-for="AgreeToTerms" required data-msg-required="@SharedLocalizer["Validation_AgreeToTerms"]" />
				<span>@SharedLocalizer["Account_Register_AgreeToTerms"]</span>
			</label>
			<span asp-validation-for="AgreeToTerms"></span>
		</div>
		@if (TurnstileOptions.Value.Enabled) {
			<div class="cf-turnstile" data-sitekey="@TurnstileOptions.Value.SiteKey" data-action="signup"></div>
		}
		<button type="submit" id="passwordSubmitButton" hidden="@(!isPasswordMode)" disabled="@(!isPasswordMode)">@SharedLocalizer["Account_Register_Button"]</button>
		<button type="button" data-passkey="create" data-options-url="@Url.Action("PasskeyRegisterOptions", "Account")" data-submit-url="@Url.Action("PasskeyRegister", "Account", new { returnUrl = ViewData["ReturnUrl"] })" data-error-text="@SharedLocalizer["Account_Register_PasskeyFailed"]" hidden="@isPasswordMode" disabled="@isPasswordMode">@SharedLocalizer["Account_Register_PasskeyButton"]</button>
		<span data-passkey-message></span>
	</form>
</article>

@section Scripts {
	@if (TurnstileOptions.Value.Enabled) {
		<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
	}
	<script type="module" src="~/js/passkey.js" asp-append-version="true"></script>
	@await Html.PartialAsync("_ValidationScriptsPartial")
}
