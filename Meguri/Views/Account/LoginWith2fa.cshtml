@model LoginWith2faViewModel
@{
    ViewData["Title"] = SharedLocalizer["Account_LoginWith2fa_Title"];
}

<h2>@ViewData["Title"]</h2>
<hr />
<p>@SharedLocalizer["Account_LoginWith2fa_Description"]</p>
<div>
    <div>
        <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <input asp-for="RememberMe" type="hidden" />
            <div asp-validation-summary="All" ></div>
            <div>
                <label asp-for="TwoFactorCode" ></label>
                <input asp-for="TwoFactorCode"  autocomplete="off" />
                <span asp-validation-for="TwoFactorCode" ></span>
            </div>
            <div>
                <label asp-for="RememberMachine">
                    <input asp-for="RememberMachine"  />
                    @Html.DisplayNameFor(m => m.RememberMachine)
                </label>
            </div>
            <div>
                <button type="submit" >@SharedLocalizer["Account_Login_Button"]</button>
            </div>
        </form>
    </div>
</div>
<p>
    @SharedLocalizer["Account_LoginWith2fa_NoAuthenticator"]
    <a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@ViewData["ReturnUrl"]">@SharedLocalizer["Account_LoginWith2fa_RecoveryLinkText"]</a>.
</p>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}