@model LoginWith2faViewModel
@{
    ViewData["Title"] = SharedLocalizer["Account_LoginWith2fa_Title"];
}

<h2>@ViewData["Title"]</h2>
<hr />
<p>@SharedLocalizer["Account_LoginWith2fa_Description"]</p>
<div class="row">
    <div class="col-md-4">
        <form method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
            <input asp-for="RememberMe" type="hidden" />
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="TwoFactorCode" class="form-label"></label>
                <input asp-for="TwoFactorCode" class="form-control" autocomplete="off" />
                <span asp-validation-for="TwoFactorCode" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <label asp-for="RememberMachine" class="form-check-label">
                    <input asp-for="RememberMachine" class="form-check-input" />
                    @Html.DisplayNameFor(m => m.RememberMachine)
                </label>
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-secondary">@SharedLocalizer["Account_Login_Button"]</button>
            </div>
        </form>
    </div>
</div>
<p>
    @SharedLocalizer["Account_LoginWith2fa_NoAuthenticator"]
    <a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@ViewData["ReturnUrl"]">@SharedLocalizer["Account_LoginWith2fa_RecoveryLinkText"]</a>.
</p>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}