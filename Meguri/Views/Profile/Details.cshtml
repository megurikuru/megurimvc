@model IEnumerable<Meguri.Models.Post>
@{
	var profile = (Meguri.Models.ApplicationUser)ViewBag.Profile;
	var isOwner = ViewBag.IsOwner as bool? ?? false;
	var urls = ViewBag.ExternalUrls as List<string> ?? new List<string>();
	ViewData["Title"] = profile.UserName;
	var pager = new Meguri.ViewModels.PaginationViewModel {
		Controller = "Profile",
		Action = "Details",
		HasPrevious = ViewBag.HasPrevious as bool? ?? false,
		HasNext = ViewBag.HasNext as bool? ?? false,
		TotalCount = ViewBag.TotalCount as int? ?? 0,
		Skip = ViewBag.Skip as int? ?? 0,
		PreviousSkip = ViewBag.PreviousSkip as int? ?? 0,
		NextSkip = ViewBag.NextSkip as int? ?? 0,
		CurrentCount = Model.Count(),
		RouteValues = new Dictionary<string, string> { ["id"] = profile.Id }
	};
}

<div>
	@if (profile.HeaderImageId.HasValue) {
		<img src="/Image/File/@profile.HeaderImageId" alt="" style="width: 100%; max-height: 200px; object-fit: cover;" />
	}
	<div>
		@if (profile.ActiveAvatarImageId.HasValue) {
			<img src="/Image/File/@profile.ActiveAvatarImageId" alt="@profile.UserName" style="width: 100px; height: 100px; object-fit: cover; border-radius: 50%;" />
		}
		<h2>@profile.UserName</h2>
		@if (isOwner) {
			@if (!profile.IsProfilePublic) {
				<small>（非公開）</small>
			}
		}
	</div>
	@if (!string.IsNullOrEmpty(profile.Bio)) {
		<p style="white-space: pre-wrap;">@profile.Bio</p>
	}
	@if (urls.Any()) {
		<ul>
			@foreach (var u in urls) {
				<li><a href="@u" target="_blank" rel="noopener noreferrer nofollow">@u</a></li>
			}
		</ul>
	}
</div>

<h3>投稿一覧</h3>
@if (!Model.Any()) {
	<h4>@SharedLocalizer["Common_NoItems"]</h4>
}
else {
	<div>
		@foreach (var post in Model) {
			<div>
				<div>
					<a asp-controller="Fandom" asp-action="Details" asp-route-id="@post.FandomId">@(post.Fandom?.Name ?? SharedLocalizer["Fandom_DefaultLabel"].Value)</a>
					@if (post.IsSexual) { <span>R-18</span> }
					@if (post.IsViolence) { <span>R-18G</span> }
					<small>@post.CreatedAt.ToString("yyyy/MM/dd HH:mm")</small>
				</div>
				<h4><a asp-controller="Post" asp-action="Details" asp-route-id="@post.Id">@post.Name</a></h4>
				<p>@(post.Text.Length > 150 ? post.Text.Substring(0, 150) + "..." : post.Text)</p>
				@if (post.PostImages.Any()) {
					<div>
						@foreach (var pi in post.PostImages.OrderBy(x => x.DisplayOrder)) {
							<a asp-controller="Image" asp-action="Details" asp-route-id="@pi.ImageId">
								<img src="/Image/File/@pi.ImageId" style="width: 100px; height: 100px; object-fit: cover;" alt="@pi.Image.Name" />
							</a>
						}
					</div>
				}
				@if (post.PostTags.Any()) {
					<div>
						@foreach (var pt in post.PostTags) {
							var tagText = pt.TagConcept?.Tags?.FirstOrDefault()?.TagText;
							if (!string.IsNullOrEmpty(tagText)) {
								<a asp-controller="Tag" asp-action="Details" asp-route-conceptId="@pt.TagConceptId">#@tagText</a>
							}
						}
					</div>
				}
				<div>
					@string.Format(SharedLocalizer["Post_CommentCountSuffix"].Value, post.CommentCount)
					@string.Format(SharedLocalizer["Post_ViewCountSuffix"].Value, post.ViewCount)
					@string.Format(SharedLocalizer["Post_ReactionCountSuffix"].Value, post.Reactions.Count)
				</div>
			</div>
		}
	</div>
}

<partial name="_Pagination" model="pager" />
