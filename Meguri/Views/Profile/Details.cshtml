@model IEnumerable<Meguri.Models.Post>
@{
	var profile = (Meguri.Models.ApplicationUser)ViewBag.Profile;
	var isOwner = ViewBag.IsOwner as bool? ?? false;
	var urls = ViewBag.ExternalUrls as List<string> ?? new List<string>();
	ViewData["Title"] = profile.UserName;
	var pager = new PaginationViewModel {
		Controller = "Profile",
		Action = "Details",
		HasPrevious = ViewBag.HasPrevious as bool? ?? false,
		HasNext = ViewBag.HasNext as bool? ?? false,
		TotalCount = ViewBag.TotalCount as int? ?? 0,
		Skip = ViewBag.Skip as int? ?? 0,
		PreviousSkip = ViewBag.PreviousSkip as int? ?? 0,
		NextSkip = ViewBag.NextSkip as int? ?? 0,
		CurrentCount = Model.Count(),
		RouteValues = new Dictionary<string, string> { ["id"] = profile.UserName ?? "" }
	};
}

<div class="profile-info">
	@if (profile.ActiveAvatarImageId.HasValue || profile.HeaderImageId.HasValue) {
		<div class="profile-banner">
			@if (profile.HeaderImageId.HasValue) {
				<img src="/Image/File/@profile.HeaderImageId" alt="" class="profile-header" />
			}
		</div>
	}
	<h1 class="user-name">@profile.UserName
	@if (isOwner) {
		@if (!profile.IsProfilePublic) {
			<small>@SharedLocalizer["Profile_PrivateBadge"]</small>
		}
	}
	</h1>
	@if (!string.IsNullOrEmpty(profile.Bio)) {
		<p class="profile-bio">@profile.Bio</p>
	}
	@if (urls.Any()) {
		<ul class="profile-external-urls">
			@foreach (var u in urls) {
				<li><a href="@u" target="_blank" rel="noopener noreferrer nofollow">@u</a></li>
			}
		</ul>
	}
</div>

<div id="post-list">
	<h1>@SharedLocalizer["Profile_PostListHeading"]</h1>
	@if (!Model.Any()) {
		<p>@SharedLocalizer["Common_NoItems"]</p>
	} else {
		@foreach (var post in Model) {
			<partial name="_PostItem" model="new PostItemViewModel { 
				Post = post, 
				BodyMaxLength = 150, 
				MaxImages = 16, 
				LinkImagesToFile = true, 
				ShowFandom = false, 
				ShowAuthor = false, 
				ShowCreatedAt = false 
			}" />
		}
	}
</div>

<partial name="_Pagination" model="pager" />
