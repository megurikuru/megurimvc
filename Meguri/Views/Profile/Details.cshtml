@model Meguri.ViewModels.Profile.ProfileDetailsViewModel
@{
	ViewData["Title"] = Model.Profile.UserName;
}

<div class="profile-info">
	@if (Model.Profile.ActiveAvatarImageId.HasValue || Model.Profile.HeaderImageId.HasValue) {
		<div class="profile-banner">
			@if (Model.Profile.HeaderImageId.HasValue) {
				<img src="/Image/File/@Model.Profile.HeaderImageId" alt="" class="profile-header" />
			}
		</div>
	}
	<h1 class="user-name">
		@if (Model.Profile.ActiveAvatarImageId.HasValue) {
			<img src="/Image/File/@Model.Profile.ActiveAvatarImageId" alt="" class="user-avatar-sm" />
		}
		@Model.Profile.UserName
	@if (Model.IsOwner) {
		@if (!Model.Profile.IsProfilePublic) {
			<small>@SharedLocalizer["Profile_PrivateBadge"]</small>
		}
	}
	</h1>
	@if (!string.IsNullOrEmpty(Model.Profile.Bio)) {
		<p class="profile-bio">@Model.Profile.Bio</p>
	}
	@if (Model.ExternalUrls.Any()) {
		<ul class="profile-external-urls">
			@foreach (var u in Model.ExternalUrls) {
				<li><a href="@u" target="_blank" rel="noopener noreferrer nofollow">@u</a></li>
			}
		</ul>
	}
</div>

<div id="post-list">
	<h1>@SharedLocalizer["Profile_PostListHeading"]</h1>
	@if (!Model.Posts.Any()) {
		<p>@SharedLocalizer["Common_NoItems"]</p>
	} else {
		@foreach (var post in Model.Posts) {
			<partial name="_PostItem" model="new PostItemViewModel { 
				Post = post, 
				BodyMaxLength = 150, 
				MaxImages = 16, 
				LinkImagesToFile = true, 
				ShowFandom = false, 
				ShowAuthor = false, 
				ShowCreatedAt = false 
			}" />
		}
	}
</div>

<partial name="_Pagination" model="Model.Pagination" />
